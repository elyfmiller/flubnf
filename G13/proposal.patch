diff --git a/app/tests/test_phone_layout.py b/app/tests/test_phone_layout.py
new file mode 100644
index 0000000..322ec1f
--- /dev/null
+++ b/app/tests/test_phone_layout.py
@@ -0,0 +1,55 @@
+"""Phone-width rules of the bug hunt 2026-10-25, G13: Storage's on-disk
+rows and ledger filter, the Sandbox menus and Runs table, the Display menu
+at large text, and the research form's particles box."""
+import re
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.ui.server import app
+
+STATIC = Path(__file__).resolve().parents[1] / "ui" / "static"
+client = TestClient(app)
+
+
+def _block(css: str, start: str) -> str:
+    """The text of the media block that starts with `start`."""
+    i = css.index(start)
+    return css[i:css.index("\n}", i)]
+
+
+def test_storage_rows_stack_at_phone_width():
+    css = (STATIC / "tabs" / "storage.css").read_text(encoding="utf-8")
+    phone = _block(css, "@media (max-width:40rem)")
+    assert ".st-row{grid-template-columns:minmax(0,1fr) auto;" in phone
+    assert '"title title" "meta meta" "size act"' in phone
+
+
+def test_a_segmented_control_wraps_instead_of_squeezing_its_words():
+    css = (STATIC / "ui-kit.css").read_text(encoding="utf-8")
+    seg = css[css.index(".uk-seg{"):css.index(".uk-seg > :not(:first-child)")]
+    assert "flex-wrap:wrap" in seg
+    assert "flex:0 0 auto" in seg
+
+
+def test_the_sandbox_menus_open_from_the_left_at_phone_width():
+    css = (STATIC / "tabs" / "sandbox.css").read_text(encoding="utf-8")
+    phone = _block(css, "@media (max-width:640px)")
+    assert ".sbhead-menus > details.sbmanage{position:static}" in phone
+    assert ".sbhead-menus .sbmenu{left:0;right:0;width:auto;max-width:none}" in phone
+    assert ".sbrunlist td:first-child{overflow-wrap:anywhere}" in css
+
+
+def test_the_display_menu_fits_its_readout_and_theme_names():
+    css = (STATIC / "nau.css").read_text(encoding="utf-8")
+    assert re.search(r"\.fontsize input\[type=range\]\{[^}]*min-width:3rem", css)
+    assert (".dm-grid{display:grid;grid-template-columns:"
+            "repeat(auto-fill,minmax(5.2rem,1fr))") in css
+
+
+def test_the_research_particles_box_keeps_its_digits():
+    page = client.get("/model/pf2s").text
+    assert '<span class="uk-affix md-count"><input id="rr-particles"' in page
+    css = (STATIC / "tabs" / "models.css").read_text(encoding="utf-8")
+    assert ".md-count{flex-wrap:wrap}" in css
+    assert ".md-count > input{flex:1 0 7.5em}" in css
