# A model that is not an epidemic: first-order conversion A -> B.
# An accumulator counts the B made, and the model applies its own observation
# scale through a function, so nothing here is called mult, rho, H or I: the
# filter fits any model written this way. Time is in weeks.
begin model
begin parameters
k__FREE 0.30
scale__FREE 0.50
r__FREE 8.0

k       k__FREE        # conversion rate per week
scale   scale__FREE    # fraction of conversions that are observed
r       r__FREE        # negative-binomial dispersion of the observed counts
A0      100000
end parameters

begin molecule types
A()
B()
Bmade()
end molecule types

begin seed species
A() A0
B() 0
Bmade() 0
end seed species

begin observables
Molecules A     A()
Molecules B     B()
Molecules B_Cum Bmade()
end observables

begin functions
Bobs() = scale*B_Cum
end functions

begin reaction rules
A() -> B() + Bmade()   k
end reaction rules
end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"kin",method=>"ode",t_start=>0,t_end=>20,n_steps=>20,print_functions=>1})
end actions
