begin model
# =====================================================================
# FluBNF SIHRS -- TWO-STRAIN (A/B) DRAFT. Research variant; the production
# two-strain template is SIHRS_pop_2strain_min.bngl and this draft keeps impr
# as well. Shared invariants: SIHRS_pop_min.bngl. Motivation, channels and
# verdict: docs/MODEL-PROVENANCE.md section 6.
#
# DISTINGUISHING FEATURE: two INDEPENDENT SIHRS circuits over the same
# population N, sharing N, mult, impr, r and the seasonal AMPLITUDE eps1 and
# differing in reproduction number and seasonal PHASE. The later B phase is
# the spring-wave mechanism and replaces the semi-annual harmonic. The second
# channel is A_share = Ia/(Ia+Ib) against NREVSS typed positives. H_weekly()
# is the INSTANTANEOUS flux, not the admissions likelihood mean, which is
# mult times the weekly increment of the combined H_Cum; it survives as the
# name binding a model output to the .exp column of the same name.
#
# Tokens (strict: an unresolved token raises rather than reaching the engine):
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{A0SHARE}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# {{A0SHARE}} is KNOWN DATA, the season's first as-of NREVSS reading, never
# fitted. Fitted (8): ReffA, ReffB, eps1, phi1A, phi1B, mult, impr, r.
# =====================================================================
begin parameters

### -- transmission: per-strain Reff + shared-amplitude seasonal forcing -- ###
ReffA   ReffA__FREE    # strain-A BASE reproduction number, harmonic-neutral, at
                       # the initial susceptible fraction s0; NOT the
                       # season-start value
ReffB   ReffB__FREE    # strain-B, same convention with phi1B; usually < ReffA
                       # but with a LATER phase
eps1    eps1__FREE     # seasonal amplitude, SHARED (unidentified if split from
                       # one season of typed data)
phi1A   phi1A__FREE    # strain-A week of peak transmissibility (circular, 0=52)
phi1B   phi1B__FREE    # strain-B phase, the spring-wave mechanism

### -- progression / removal (shared across strains for the draft) -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H, shared A/B;
                       # rules only, never the observable
mult    mult__FREE     # ascertainment, shared: one reporting system observes both
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning, per-strain circuit R->S

### -- external force of infection, shared -- ###
impr    impr__FREE     # per-susceptible weekly reseeding hazard (see SIHRS_pop.bngl)

### -- observation noise -- ###
r       r__FREE        # NB dispersion for the admissions channel

### -- derived -- ###
beta0A  ReffA*gamma/s0
beta0B  ReffB*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI()

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}
s0      {{S0FRAC}}     # initial susceptible fraction, applied to BOTH circuits
i0      {{I0FRAC}}     # total initial infected fraction
a0      {{A0SHARE}}    # strain-A share of i0; KNOWN DATA, never fitted

end parameters

begin molecule types
Sa()
Ia()
Ha()
Ra()
Sb()
Ib()
Hb()
Rb()
HadmA()     # cumulative A admissions accumulator
HadmB()     # cumulative B admissions accumulator
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Each circuit spans the whole population (independent co-circulation).
Sa() N*s0
Ia() N*i0*a0
Ha() 0
Ra() N*(1-s0-i0*a0)
Sb() N*s0
Ib() N*i0*(1-a0)
Hb() 0
Rb() N*(1-s0-i0*(1-a0))
HadmA() 0
HadmB() 0
counter() 0
end seed species

begin observables
Molecules Sa    Sa()
Molecules Ia    Ia()
Molecules Ra    Ra()
Molecules Sb    Sb()
Molecules Ib    Ib()
Molecules Rb    Rb()
# ONE '_Cum' observable only: the engine's integrated mode globs the first
# '_Cum' column, so the combined accumulator must be the only one.
Molecules H_Cum HadmA() HadmB()
Molecules t     counter()
end observables

begin functions

### -- per-strain seasonal transmission (shared amplitude, own phase) -- ###
betaA() = beta0A*exp( eps1*cos(2*pi*(t-phi1A)/52) )
betaB() = beta0B*exp( eps1*cos(2*pi*(t-phi1B)/52) )

### -- channel 1: combined ascertained admission flux, INSTANTANEOUS -- ###
# Not the likelihood mean (see header). mult is observation-only: ascertainment
# must never enter a reaction rule.
H_weekly() = rho*mult*gamma*(Ia+Ib)

### -- channel 2: strain-A share of typed lab positives (NREVSS target) -- ###
# Assumes equal per-infection test-positivity ascertainment for A and B, so the
# shared factors cancel and mult correctly does not appear here.
A_share() = Ia/(Ia+Ib)

end functions

begin reaction rules
0 -> counter() 1
# --- strain A circuit (frequency-dependent, as SIHRS_pop.bngl) ---
Sa() + Ia() -> Ia() + Ia()   betaA()/N
Ia() -> Ha()   rho*gamma
Ia() -> Ra()   (1-rho)*gamma
Ha() -> Ra()   gammaH
Ra() -> Sa()   omega
Sa() -> Ia()   impr
# accumulator: counts I->H without consuming I
Ia() -> Ia() + HadmA()   rho*gamma
# --- strain B circuit ---
Sb() + Ib() -> Ib() + Ib()   betaB()/N
Ib() -> Hb()   rho*gamma
Ib() -> Rb()   (1-rho)*gamma
Hb() -> Rb()   gammaH
Rb() -> Sb()   omega
Sb() -> Ib()   impr
Ib() -> Ib() + HadmB()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
