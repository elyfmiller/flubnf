begin model
# =====================================================================
# FluBNF SIHRS-NATG: the production template SIHRS_pop_min.bngl PLUS one
# exogenous national-growth factor on beta(t), zero new fitted parameters:
#
#   beta_s(t)  *=  exp( iota * ( g_nat^{-s}(t) - g_s^obs(t) ) )
#
# g_nat^{-s} is leave-one-out national log-growth of vintage-true weekly
# admissions and g_s^obs the state's own, both built at materialize time by
# flubnf/natgrowth.py from the as-of vintage, never the latest file. The
# term acts on GROWTH, never on level.
#
# PRE-REGISTERED AND FROZEN A PRIORI (measurements: MODEL-PROVENANCE 4):
#   * iota = 0.3020 (flubnf/natgrowth.py::IOTA_FROZEN). Never a *__FREE
#     var line, never retuned after seeing scores (handoff Law 1).
#   * Forecast rule: the last observed gap is
#     HELD CONSTANT ACROSS THE 1 TO 4 WEEK HORIZON.
#     Structural, not a code path: natgap()'s final branch has no upper
#     guard. No extrapolation, no decay, no forecast of g_nat.
#   * The gap is clipped to +-1.0 (natgrowth.py::GAP_CLIP), holding the
#     beta multiplier inside [0.74, 1.35]; clipped weeks are reported.
#
# Extra tokens beyond `min`: IOTA, GAPEXPR, GAPNOTE (braces omitted here
# so this comment survives materialization), from natg_tokens().
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start,
                       # forced or realised value; here the forced value also
                       # carries exp(iota*natgap(t)). Fit Reff, never R0
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment, OBSERVATION-ONLY: it must never appear
                       # in a reaction rule. Admissions identify only the
                       # product rho*mult; rho is held fixed, so the FIT
                       # determines the product. Never pinned in this file
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- exogenous national growth: FIXED A PRIORI, never fitted -- ###
iota    {{IOTA}}       # FROZEN at 0.3020 (see header). Deliberately a plain
                       # parameter, never a *__FREE var (Law 1).

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) takes the remainder, so S+I+H+R = N exactly and
# pre-existing immunity (s0 < 1) is representable.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- exogenous national-growth gap, piecewise-constant in t -- ###
# {{GAPNOTE}}
# Written at materialize time by natgrowth.py::bngl_gap_expression. A week
# with no defined growth contributes exactly 0.0; the unguarded final
# branch IS the pre-registered forecast rule above.
natgap() = {{GAPEXPR}}

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
# The ONLY change from SIHRS_pop_min.bngl: the exp(iota*natgap()) factor.
# iota = 0 reduces this file to the production template exactly.
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )*exp( iota*natgap() )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# People per week at an instant, NOT a weekly total: the shipped particle
# filter uses the weekly increment of H_Cum instead. This function survives
# as the name binding the .exp count column to a model output.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# accumulator: tallies the I->H flux without consuming I, so S+I+H+R = N
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
