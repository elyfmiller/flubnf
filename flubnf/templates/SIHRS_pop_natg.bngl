begin model
# =====================================================================
# FluBNF SIHRS-NATG: the production template SIHRS_pop_min.bngl PLUS one
# exogenous national-growth factor on beta(t), zero new fitted parameters:
#
#   beta_s(t)  *=  exp( iota * ( g_nat^{-s}(t) - g_s^obs(t) ) )
#
# g_nat^{-s} is the leave-one-out population-weighted log-growth of
# vintage-true weekly admissions across all OTHER jurisdictions as of the
# same date; g_s^obs is this state's own. Both are built at materialize
# time by flubnf/natgrowth.py from the as-of vintage, never the latest
# file. The term acts on GROWTH, never on level: a state growing at the
# national rate gets a multiplier of exactly 1.
#
# PRE-REGISTERED AND FROZEN A PRIORI:
#   * iota = 0.3020, the constant in flubnf/natgrowth.py::IOTA_FROZEN. It
#     must never become a *__FREE var line and must never be retuned
#     after seeing scores (handoff Law 1).
#   * Forecast rule: the last observed gap is
#     HELD CONSTANT ACROSS THE 1 TO 4 WEEK HORIZON.
#     No extrapolation, no decay toward zero, no forecast of the national
#     series; g_nat is not predicted. The rule is structural:
#     the final branch of natgap() carries no upper guard.
#   * The gap is clipped to +-1.0 (flubnf/natgrowth.py::GAP_CLIP), so the
#     beta multiplier stays inside [0.74, 1.35]; clipped weeks are
#     counted and reported per cell, never silently absorbed.
#
# Extra tokens beyond the ones `min` needs: IOTA, GAPEXPR, GAPNOTE
# (braces omitted here so this comment survives materialization), all
# supplied by flubnf/natgrowth.py::natg_tokens. The regression that
# produced iota, the shrink applied to it, and the honest note on its
# effective strength (the multiplier acts on beta, so the response at the
# operating point is near 1.0x the regression coefficient rather than the
# 0.5x the shrink suggests) are recorded in full at
# flubnf/natgrowth.py::IOTA_FROZEN, beside the constant itself.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number, harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start
                       # value: the EFFECTIVE reproduction number in week t is
                       # Reff*exp(eps1*cos(2*pi*(t-phi1)/52))*exp(iota*natgap(t)),
                       # which equals Reff only where both exponents vanish. Season
                       # start is that expression at t = 0; the forcing peak of the
                       # harmonic alone is t = phi1, giving Reff*exp(eps1). Fit
                       # Reff, never R0 (R0 = Reff/s0 post hoc, likewise BASE)
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; admissions identify only the PRODUCT
                       # rho*mult, since the observation depends on the two
                       # only through it. rho is held at its sourced value
                       # and mult is fitted, so the FIT determines the
                       # product; it is never pinned in this file
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- exogenous national growth: FIXED A PRIORI, never fitted -- ###
iota    {{IOTA}}       # FROZEN at 0.3020; derivation in this file's header
                       # and flubnf/natgrowth.py::IOTA_FROZEN. Deliberately
                       # a plain parameter, never a *__FREE var (Law 1).

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) carries the non-susceptible, non-infected remainder,
# so S+I+H+R = N exactly and pre-existing immunity is representable (s0 < 1),
# which the S(0)=1 normalization structurally cannot express.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- exogenous national-growth gap, piecewise-constant in t -- ###
# {{GAPNOTE}}
# Generated at materialize time by flubnf/natgrowth.py::bngl_gap_expression;
# a week with no defined growth contributes exactly 0.0. The final branch
# has no upper guard: t at or beyond the last observed week holds the last
# observed gap (the pre-registered forecast rule).
natgap() = {{GAPEXPR}}

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
# The ONLY change from SIHRS_pop_min.bngl: the exp(iota*natgap()) factor.
# iota = 0 reduces this file to the production template exactly.
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )*exp( iota*natgap() )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# Despite the name this is people PER WEEK at an instant, not a weekly
# total; the weekly count is the change in H_Cum across the reporting
# week, which is this flux integrated over that week.
# mult is observation-only: ascertainment must never enter the reaction rules.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
# clock
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
# hospitalization branch: fraction rho of the gamma removal
I() -> H()   rho*gamma
# direct-recovery branch
I() -> R()   (1-rho)*gamma
# discharge
H() -> R()   gammaH
# waning immunity (the second S in SIHRS)
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
