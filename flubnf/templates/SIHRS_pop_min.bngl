begin model
# =====================================================================
# FluBNF SIHRS -- single-strain production template (5 fitted parameters).
# Compartments are absolute people; the state population N enters as
# known data; infection is frequency-dependent (flux beta*S*I/N), so beta
# is on the same scale as the normalized model and priors transfer
# unchanged.
#
# Tokens filled per state at materialization:
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# Fitted (5): Reff, eps1, phi1, mult, r. Every fixed value is sourced in
# flubnf/sihrs_priors.py (DOI or data derivation per value).
#
# Fit the REPORTED admission flux (rho*mult*gamma*I), never the census H(t).
# SINGLE-SEASON FITS ONLY: multi-season runs need the reseeding term and
# must use SIHRS_pop.bngl. Design history, measured ablations, and the
# identifiability limits: docs/MODEL-PROVENANCE.md.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # EFFECTIVE reproduction number at season start; fit
                       # Reff, never R0 (R0 = Reff/s0 only post hoc)
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; only rho*mult is identified -- never
                       # pin the product (docs/MODEL-PROVENANCE.md)
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) carries the non-susceptible, non-infected remainder,
# so S+I+H+R = N exactly and pre-existing immunity is representable (s0 < 1),
# which the S(0)=1 normalization structurally cannot express.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; neg_bin_dynamic differences '_Cum' -> weekly
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- weekly REPORTED admissions = ascertained flux into H -- ###
# mult is observation-only: ascertainment must never enter the reaction rules.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
# clock
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
# hospitalization branch: fraction rho of the gamma removal
I() -> H()   rho*gamma
# direct-recovery branch
I() -> R()   (1-rho)*gamma
# discharge
H() -> R()   gammaH
# waning immunity (the second S in SIHRS)
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
