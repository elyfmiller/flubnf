begin model
# =====================================================================
# FluBNF SIHRS -- single-strain production template. Fitted (5): Reff,
# eps1, phi1, mult, r. Compartments are absolute people, N is known data,
# and TIME IS IN WEEKS: every rate below is per week. Design history,
# sources and the measurements behind each choice: docs/MODEL-PROVENANCE.md.
#
# A TEMPLATE, NOT A RUNNABLE MODEL. Two kinds of placeholder (the first
# is written here without its braces so this comment survives):
#   TOKEN    per-state known DATA in double braces, substituted before the
#            fit by flubnf/sihrs_fit.py::materialize_model. Substitution
#            is STRICT: an unresolved token raises instead of reaching the
#            engine. A token carries data and must never be fitted.
#   *__FREE  a FITTED parameter, proposed by PyBNF against a prior in
#            flubnf/sihrs_fit.py. Never pin one to a number here.
#
# rho, gammaH and omega are UNSOURCED working assumptions set in
# flubnf/sihrs_fit.py; every fixed value, sourced or not, is recorded in
# flubnf/sihrs_priors.py::provenance_table.
#
# FIT REPORTED WEEKLY ADMISSIONS, NEVER THE CENSUS H(t). The predicted
# weekly count is the increment of H_Cum across the reporting week; see
# H_weekly() below for the trap in the alternative.
#
# The 48-week actions block at the foot is inert for the particle filter,
# which sets its own one-week windows, and is a ceiling for adaptive MCMC,
# whose last as-of plus four horizons reaches week 49. n_steps sets the
# reporting grid only, not the solver step; CVODE is adaptive.
#
# SINGLE-SEASON FITS ONLY: multi-season runs need the reseeding term and
# must use SIHRS_pop.bngl.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start,
                       # forced or realised value, which all differ from it and
                       # from each other. Fit Reff, never R0 (= Reff/s0, itself
                       # a BASE value, recovered post hoc)
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment, OBSERVATION-ONLY: it must never appear
                       # in a reaction rule. Admissions identify only the
                       # product rho*mult; rho is held fixed, so the FIT
                       # determines the product. Never pinned in this file
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) takes the remainder, so S+I+H+R = N exactly and
# pre-existing immunity (s0 < 1) is representable.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# People per week at an instant, NOT a weekly total: the shipped particle
# filter uses the weekly increment of H_Cum instead. This function survives
# as the name binding the .exp count column to a model output.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# accumulator: tallies the I->H flux without consuming I, so S+I+H+R = N
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
