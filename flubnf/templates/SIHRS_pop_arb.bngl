begin model
# =====================================================================
# FluBNF SIHRS-ARB -- ADAPTIVE TRANSMISSION (6 fitted parameters). Research
# variant, killed at its decision gate; see docs/RELEASE-1.0.md. The mechanism
# here is the production single-strain mechanism (SIHRS_pop_min.bngl)
# unchanged, and that template documents the shared invariants.
#
# DISTINGUISHING FEATURE: how Reff MOVES BETWEEN WEEKS inside the sequential
# filter. This file therefore adds no reaction, no species and no function; it
# exists to declare the one new fitted quantity.
#
#   log Reff_t  =  log Reff_{t-1} + v_t
#   v_t         =  arphi * v_{t-1} + sbeta * eta_t ,  eta_t ~ N(0, 1)
#   beta(t)     =  Reff_t * gamma / s0 * exp( eps1*cos(2*pi*(t-phi1)/52) )
#
# Across the forecast horizon Reff is FROZEN at its last filtered value: no
# further innovations, no jitter (pybnf/pf.py::_write_outputs). Unlike the
# RW-beta variant (SIHRS_pop_rwb.bngl) the seasonal harmonic is kept.
#
# Tokens filled per state at materialization (strict: an unresolved token
# raises rather than reaching the engine):
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# Fitted (6): Reff, eps1, phi1, mult, r, sbeta. Single-season fits only.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0, NOT the season-start
                       # or realised one. Here it is also a STATE, not a
                       # constant: the filter advances it by the process above,
                       # and the fitted value is that state's starting level.
eps1    eps1__FREE     # annual-harmonic amplitude (kept, unlike RW-beta)
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- adaptive-transmission innovation scale -- ###
sbeta   sbeta__FREE    # weekly sd of the log-transmission innovation. Read by
                       # the filter (pf_ar1_sigma_param), never by a rule: it
                       # governs the between-week parameter process, not the
                       # within-week ODE, so it correctly appears in no rate
                       # law. Declared here so the fitted dimension is visible
                       # in the model, not only in the conf.

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; only rho*mult is identified
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()
I()
H()
R()
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# mult is observation-only: ascertainment must never enter the reaction rules.
# Despite the name this is people PER WEEK at an instant, not a weekly total.
# The name binds this output to the .exp column of the same name.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
