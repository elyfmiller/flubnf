begin model
# =====================================================================
# FluBNF SIHRS-ARB -- ADAPTIVE TRANSMISSION (6 fitted parameters).
#
# The mechanism below is BYTE-FOR-BYTE the production single-strain
# mechanism (SIHRS_pop_min.bngl): same compartments, same rules, same
# frequency-dependent infection, same observable, same fixed values. The
# candidate lives entirely in HOW Reff MOVES BETWEEN WEEKS inside the
# sequential filter, so this template deliberately adds no reaction, no
# species and no function. It exists to declare the one new fitted
# quantity and to carry the design record.
#
#   log Reff_t  =  log Reff_{t-1} + v_t
#   v_t         =  arphi * v_{t-1} + sbeta * eta_t ,  eta_t ~ N(0, 1)
#   beta(t)     =  Reff_t * gamma / s0 * exp( eps1*cos(2*pi*(t-phi1)/52) )
#
# and across the forecast horizon Reff is FROZEN at its last filtered
# value: no further innovations, no jitter (pybnf/pf.py::_write_outputs).
#
# HOW THIS DIFFERS FROM THE KILLED RW-BETA MEMBER (SIHRS_pop_rwb.bngl,
# pre-registered FAIL 2026-08-19, 3-member 0.664 against 2-member 0.620).
# RW-beta moved Reff by the filter's Liu-West jitter with the knob hand-set
# at 0.5 and no seasonal term at all. Four differences, each measurable:
#   1. INCREMENTS, not levels. RW-beta's Liu-West step is a mean-reverting
#      AR(1) on the LEVEL of Reff; this is an AR(1) on the DIFFERENCES, so
#      a sustained change in transmission is cheap and an isolated blip is
#      not. arphi = 0 recovers the level walk and is the control arm.
#   2. THE INNOVATION SCALE IS FITTED. `sbeta` below is a per-particle
#      parameter the filter weights like any other, so the process can go
#      quiet in stable weeks. RW-beta paid 0.5 * ensemble-sd every week
#      whatever the data looked like, which is exactly the interval-width
#      cost that killed it.
#   3. FROZEN FORWARD. Transmission stops moving at the forecast origin,
#      which is what the field's flexible-beta COVID models do (MechBayes
#      freezes log-beta at its last ten days; Pyrenew-HE freezes its
#      DifferencedAR1 forward).
#   4. THE SEASONAL HARMONIC IS KEPT. RW-beta set eps1 = 0 and was
#      deliberately calendar-free. Here eps1/phi1 remain fitted and ride on
#      top of the adaptive level, so the calendar and the adaptive process
#      can coexist or the likelihood can decline one of them.
#
# Tokens filled per state at materialization:
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# Fitted (6): Reff, eps1, phi1, mult, r, sbeta. Every fixed value is
# sourced in flubnf/sihrs_priors.py. Single-season fits only.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # EFFECTIVE reproduction number. Under this member it is
                       # a STATE, not a constant: the filter advances it by the
                       # AR(1)-on-increments process above, and its fitted value
                       # here is the season-start level.
eps1    eps1__FREE     # annual-harmonic amplitude (kept, unlike RW-beta)
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- adaptive-transmission innovation scale -- ###
sbeta   sbeta__FREE    # weekly sd of the log-transmission innovation. Read by
                       # the filter (pf_ar1_sigma_param), never by a rule: it
                       # governs the between-week parameter process, not the
                       # within-week ODE, so it correctly appears in no rate
                       # law. Declared here so the fitted dimension is visible
                       # in the model record rather than only in the conf.

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; only rho*mult is identified
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; neg_bin_dynamic differences '_Cum' -> weekly
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- weekly REPORTED admissions = ascertained flux into H -- ###
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
# clock
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
# hospitalization branch: fraction rho of the gamma removal
I() -> H()   rho*gamma
# direct-recovery branch
I() -> R()   (1-rho)*gamma
# discharge
H() -> R()   gammaH
# waning immunity (the second S in SIHRS)
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
