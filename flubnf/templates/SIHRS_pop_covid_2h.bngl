begin model
# =====================================================================
# FluBNF SIHRS -- COVID-19 second-harmonic variant (8 fitted parameters).
# GATE A ROUND TWO, ARM A2. SIHRS_pop_covid.bngl is unchanged and remains
# the control arm; THIS file adds exactly one thing to it: the
# semi-annual harmonic (eps2, phi2) restored to beta(t) as fitted
# parameters. Diff the two files: the differences are the eps2/phi2
# parameter lines, the beta() line, and this header.
#
# Why round two restores what round one refused, the verification that
# the two-peak regime is reachable at these priors, and the frozen
# pre-registration: docs/MODEL-PROVENANCE.md section 5.4 and
# research/covid-phase0/gate_a2.py.
#
# Fit the REPORTED admission flux (rho*mult*gamma*I), never the census H(t).
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # EFFECTIVE reproduction number at season start
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)
eps2    eps2__FREE     # semi-annual amplitude; the uniform(0, 0.4) bound is
                       # STIFFNESS-CRITICAL (docs/MODEL-PROVENANCE.md 5.4)
phi2    phi2__FREE     # semi-annual phase, identified only mod 26

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/6.84 d INTRINSIC generation time, Omicron,
                       # Manica 2022 doi:10.1016/j.lanepe.2022.100446. Arm A3
                       # substitutes the realized-household value here; the
                       # token makes that a materialization choice, not an edit
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable (value: flubnf/profiles.py)
mult    mult__FREE     # ascertainment; only rho*mult is identified -- never
                       # pin the product (docs/MODEL-PROVENANCE.md)
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   omega__FREE    # FITTED: waning R->S per week, loguniform
                       # [0.01278, 0.12780]/wk = 1.8-18 months protection;
                       # sources in SIHRS_pop_covid.bngl and flubnf/profiles.py

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) carries the non-susceptible, non-infected remainder,
# so S+I+H+R = N exactly and pre-existing immunity is representable (s0 < 1),
# which the S(0)=1 normalization structurally cannot express.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; neg_bin_dynamic differences '_Cum' -> weekly
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate, TWO harmonics (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) + eps2*cos(4*pi*(t-phi2)/52) )

### -- weekly REPORTED admissions = ascertained flux into H -- ###
# mult is observation-only: ascertainment must never enter the reaction rules.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
# clock
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
# hospitalization branch: fraction rho of the gamma removal
I() -> H()   rho*gamma
# direct-recovery branch
I() -> R()   (1-rho)*gamma
# discharge
H() -> R()   gammaH
# waning immunity (the second S in SIHRS)
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_covid",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
