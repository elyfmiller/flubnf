begin model
# =====================================================================
# FluBNF SIHRS+ED -- the min model plus a SECOND OBSERVABLE (7 params).
# Research variant. Everything except the ED channel is the production
# single-strain model, and SIHRS_pop_min.bngl documents the shared
# invariants; docs/MODEL-PROVENANCE.md carries the design record.
#
# NOT WIRED. multED, sigmaED and ED_prop() appear in no conf writer, no
# prior dict and no .exp writer anywhere in app/, flubnf/ or scripts/.
# This file is a design record; nothing here has ever been fitted.
#
# DISTINGUISHING FEATURE: a second observation channel, the NSSP
# influenza share of emergency-department visits. It is an OBSERVATION
# LAYER ONLY, reading I and never altering a flow, and it proxies
# PREVALENCE, hence I/N rather than a flux.
#
# Tokens substituted per state at materialization (strict: an unresolved
# token raises rather than reaching the engine):
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# Fitted (7): Reff, eps1, phi1, mult, r, multED, sigmaED.
# Single-season fits only; multi-season runs need SIHRS_pop.bngl.
#
# Fit the REPORTED WEEKLY ADMISSIONS, never the census H(t): the weekly
# count is the change in H_Cum across the reporting week, not H_weekly()
# sampled at an instant.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start
                       # value and NOT the realised one. Fit Reff, never R0.
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; admissions identify only the PRODUCT
                       # rho*mult, and it is never pinned in this file
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (admissions column)

### -- second observable: NSSP ED-visit share -- ###
multED  multED__FREE   # ED ascertainment: reported ED share per unit prevalence
sigmaED sigmaED__FREE  # Gaussian obs noise for the ED column (the share is a
                       # continuous fraction; NB is for counts, not proportions)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()
I()
H()
R()
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- continuous seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# mult is observation-only: ascertainment must never enter the reaction rules.
# Despite the name this is people PER WEEK at an instant, not a weekly total.
# The name binds this output to the .exp column of the same name.
H_weekly() = rho*mult*gamma*I

### -- ED-visit share, a DECIMAL PROPORTION, not a percent. The hub's -- ###
### -- target-ed-visits-prop.csv is already divided by 100, so do NOT -- ###
### -- add a factor of 100 here: it would make the model column 100x  -- ###
### -- the target.                                                    -- ###
ED_prop() = multED*I/N

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
