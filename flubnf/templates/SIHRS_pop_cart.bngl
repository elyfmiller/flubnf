begin model
# =====================================================================
# FluBNF SIHRS -- CARTESIAN SEASONAL BETA
# ---------------------------------------------------------------------
# Identical science to SIHRS_pop.bngl at the same fitted-parameter count;
# the ONLY change is the seasonal term's coordinate system, polar
# (amplitude, phase) -> Cartesian:
#
#   eps*cos(2*pi*(t-phi)/P)  ==  a*cos(2*pi*t/P) + b*sin(2*pi*t/P)
#     a = eps*cos(2*pi*phi/P),  b = eps*sin(2*pi*phi/P)
#
# Exact, verified to 2.6e-15 over 2000 random (eps, phi). Recover (eps,
# phi) post hoc with flubnf.seasonal.to_polar, converting SAMPLES only.
#
# WHY. THIS FILE IS THE HOME OF RECORD for the measurement (2026-08-05,
# 680 sweep fits plus raw chains); flubnf/seasonal.py points here for it.
# Polar coordinates make this posterior unsamplable by adaptive
# Metropolis, phase carrying nearly all the damage:
#   median R-hat  phi1 58.8 (ESS 26)  phi2 26.8  Reff 3.35  eps1 2.90
#   100% of the 680 fits fail R-hat > 1.1
#   Alabama 2026-01-24, 4 chains x 8000 iters: acceptance a healthy 15.1%,
#   yet phi1 chain means 31.6 / 1.2 / 17.3 / 44.8, each chain covering
#   1.4% of the prior. Circular R-hat 64.3 against linear 127.2.
# Not stuck, sealed: each chain sits in its own narrow mode. Acceptance is
# identical across parameters because PyBNF's AM is a joint block
# proposal, so the worst-conditioned direction throttles all of them.
#
# THREE DEFECTS OF THE POLAR FORM, all removed here:
#  1. FUNNEL: as eps -> 0, phi is unidentified. phi1 R-hat 68.3 at
#     eps1 < 0.05 against 24.7 at eps1 in [0.30, 0.60]; 46% of fits sit
#     below 0.05. In (a,b) that origin is an ordinary interior point, and
#     a short corridor between phase modes rather than a barrier.
#  2. CIRCULAR WALL: phi's prior is (0,52) but 0 and 52 are the SAME
#     phase, and PyBNF treats them as hard bounds. (a,b) has no wall.
#  3. PRIOR ARTIFACT: uniform (eps,phi) implies density proportional to
#     1/eps in Cartesian coordinates (the polar Jacobian is eps), pushing
#     amplitude to zero; uniform (a,b) gives p(eps) proportional to eps.
#     This may explain the long-standing "eps1 collapses to ~0" result,
#     read until now as evidence about seasonality, not coordinates.
#
# Fitted (8): Reff, a1, b1, a2, b2, mult, impr, r. Tokens per state at
# materialization, unchanged from the polar templates: {{POP}} {{S0FRAC}}
# {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}. Fit the REPORTED
# WEEKLY ADMISSIONS, never the census H(t): the weekly count is the
# increment of H_Cum, not that flux sampled at one instant.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start
                       # value, which is Reff*exp(a1+a2) because both sines
                       # vanish at t = 0. Fit Reff, never R0 (= Reff/s0, itself
                       # a BASE value, recovered post hoc)

# Prior boxes and their stiffness note: flubnf/sihrs_fit.py::CART_PRIORS.
a1      a1__FREE       # annual  cos coefficient
b1      b1__FREE       # annual  sin coefficient
a2      a2__FREE       # semi-annual cos coefficient
b2      b2__FREE       # semi-annual sin coefficient

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment, OBSERVATION-ONLY: it must never appear
                       # in a reaction rule
gammaH  {{GAMMAH}}     # FIXED: discharge; does not enter the admissions target
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- external force of infection (reseeding) -- ###
# Required, not cosmetic: waning refills the FUEL (S) but supplies no SPARK
# (I), and infection is proportional to I. Written S()->I(), not 0->I(), so
# total population is conserved.
impr    impr__FREE     # per-susceptible per-week external infection hazard

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission, CARTESIAN. exp() keeps beta > 0, exactly as before -- ###
beta() = beta0*exp( a1*cos(2*pi*t/52) + b1*sin(2*pi*t/52) \
                  + a2*cos(4*pi*t/52) + b2*sin(4*pi*t/52) )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# People per week at an instant, NOT a weekly total: the weekly count is
# the increment of H_Cum across the reporting week.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# external reseeding: keeps I off the numerical floor between seasons
S() -> I()   impr
# accumulator: tallies the I->H flux without consuming I, so S+I+H+R = N
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
