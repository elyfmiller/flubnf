begin model
# =====================================================================
# FluBNF SIHRS -- COVID-19 variant. Fitted (6): Reff, eps1, phi1, omega, mult,
# r. Structurally identical to SIHRS_pop_min.bngl except that omega is FITTED
# here, not fixed. Fixed values and sources: flubnf/profiles.py (COVID).
#
# Tokens filled per state at materialization, strictly (an unresolved token
# raises): {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}}. There
# is deliberately no OMEGA token, written here without its braces because the
# token scan reads comments too.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number, harmonic-neutral, at the
                       # initial susceptible fraction s0; NOT the season-start
                       # value and NOT the realised one, which also carries
                       # susceptible depletion. Fit Reff, never R0 (= Reff/s0)
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase, the week of peak TRANSMISSIBILITY
                       # and not of the observed peak: carry no peak-week prior

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/6.84 d INTRINSIC generation time, never the
                       # 2.4-3.6 d realized or serial one (flubnf/profiles.py)
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable (value: flubnf/profiles.py)
mult    mult__FREE     # ascertainment; only the PRODUCT rho*mult is identified,
                       # and rho is fixed, so the FIT sets it. Never pinned here
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   omega__FREE    # FITTED, not fixed: the one change this template exists
                       # for. Loguniform prior, flubnf/profiles.py

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) takes the remainder, so S+I+H+R = N exactly and
# pre-existing immunity (s0 < 1) is representable.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) )

### -- ascertained admission flux into H -- ###
# An INSTANTANEOUS rate, not a weekly count: the shipped filter uses the weekly
# increment of H_Cum instead, and this survives as the name binding the .exp
# column to a model output. mult is observation-only: never put it in a rule.
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# FREQUENCY-DEPENDENT infection: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
# accumulator: mints a tally without consuming I, so S+I+H+R = N still holds
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_covid",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
