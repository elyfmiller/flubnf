begin model
# =====================================================================
# FluBNF SIHRS -- MULTI-SEASON template (8 fitted parameters). Compartments
# are ABSOLUTE PEOPLE, the state population N enters as known data, and
# infection is frequency-dependent (flux beta*S*I/N), so beta keeps the
# normalized model's scale and its priors transfer unchanged. Time is in
# WEEKS; every rate is per week. Single-season fits use SIHRS_pop_min.bngl;
# this template keeps the three parameters that one drops (eps2, phi2, impr)
# because multi-season runs need the reseeding term.
#
# Names in double braces are TOKENS: per-state known data substituted before
# the fit by flubnf/sihrs_fit.py::materialize_model. Substitution is strict,
# so an unresolved token raises instead of reaching the engine.
#   {{POP}} {{S0FRAC}} {{I0FRAC}} {{GAMMA}} {{RHO}} {{GAMMAH}} {{OMEGA}}
# The __FREE suffix marks the FITTED parameters; nothing here may pin one to
# a number. Fitted (8): Reff, eps1, phi1, eps2, phi2, mult, impr, r. Sources
# for the fixed values, and the measurements behind these choices:
# docs/MODEL-PROVENANCE.md and flubnf/sihrs_priors.py.
#
# Fit the REPORTED WEEKLY ADMISSIONS, never the census H(t): the weekly count
# is the change in H_Cum across the reporting week, not H_weekly() sampled at
# an instant.
# =====================================================================
begin parameters

### -- transmission: scale-free reproduction number + seasonal forcing -- ###
Reff    Reff__FREE     # BASE reproduction number: harmonic-neutral, at the
                       # initial susceptible fraction s0. NOT the season-start
                       # value and NOT the realised one, which also carries
                       # susceptible depletion. Fit Reff, never R0.
eps1    eps1__FREE     # annual-harmonic amplitude
phi1    phi1__FREE     # annual-harmonic phase (week of peak transmissibility)
eps2    eps2__FREE     # semi-annual amplitude (asymmetric / two-wave seasons)
phi2    phi2__FREE     # semi-annual phase

### -- progression / removal -- ###
gamma   {{GAMMA}}      # FIXED: 7/3.2 d generation time, Chan 2024 doi:10.1101/2024.08.17.24312064
rho     {{RHO}}        # FIXED: true IHR branching fraction I->H; rules only,
                       # never the observable
mult    mult__FREE     # ascertainment; admissions identify only the PRODUCT
                       # rho*mult, and it is never pinned in this file: rho is
                       # held at its sourced value and the fit sets the product
gammaH  {{GAMMAH}}     # FIXED: discharge; moves the census only, unidentifiable here
omega   {{OMEGA}}      # FIXED: waning R->S, weakly identified from <3 seasons

### -- external force of infection (reseeding) -- ###
# REQUIRED FOR MULTI-SEASON RUNS, not cosmetic: between seasons I decays for
# about 30 weeks to roughly 1e-150 people, which is denormal, and CVODE failed
# on 100% of 230-week fits without this term. Written S()->I() rather than
# 0->I() so N is conserved. FITTED, because no literature value exists for a
# per-state weekly reseeding rate.
impr    impr__FREE     # per-susceptible per-week external infection hazard

### -- observation noise -- ###
r       r__FREE        # negative-binomial dispersion (AMCMC)

### -- derived -- ###
beta0   Reff*gamma/s0
pi      3.141592653589793  # avoid BNGL _pi(): bngsim codegen emits M_PI(), which will not compile

### -- FIXED per-state structural constants (known data, never fitted) -- ###
N       {{POP}}        # state population (absolute people)
s0      {{S0FRAC}}     # initial susceptible fraction; FIXED -- R0*s0 is product-identified
i0      {{I0FRAC}}     # initial infected fraction

end parameters

begin molecule types
S()         # susceptible people
I()         # infectious people
H()         # hospitalized census / occupancy
R()         # recovered / immune people
Hadm()      # cumulative admissions accumulator (never decays)
counter()   # clock: observable t = weeks
end molecule types

begin seed species
# Absolute counts. R(0) takes the remainder, so S+I+H+R = N exactly and
# pre-existing immunity (s0 < 1) is representable.
S() N*s0
I() N*i0
H() 0
R() N*(1-s0-i0)
Hadm() 0
counter() 0
end seed species

begin observables
Molecules S     S()
Molecules I     I()
Molecules H     H()        # census -- do NOT fit to an admissions target
Molecules R     R()
Molecules H_Cum Hadm()     # cumulative admissions; the weekly count is this observable's change across the reporting week
Molecules t     counter()
end observables

begin functions

### -- continuous seasonal transmission rate (exp() keeps beta > 0) -- ###
beta() = beta0*exp( eps1*cos(2*pi*(t-phi1)/52) + eps2*cos(4*pi*(t-phi2)/52) )

### -- ascertained admission flux into H, an INSTANTANEOUS rate -- ###
# mult is observation-only: ascertainment must never enter the reaction rules.
# Despite the name this is people PER WEEK at an instant, not a weekly total.
# The name survives because it binds this model output to the .exp column of
# the same name (flubnf/sihrs_fit.py::write_exp).
H_weekly() = rho*mult*gamma*I

end functions

begin reaction rules
0 -> counter() 1
# infection, FREQUENCY-DEPENDENT: rate constant beta()/N -> flux beta*S*I/N
S() + I() -> I() + I()   beta()/N
I() -> H()   rho*gamma
I() -> R()   (1-rho)*gamma
H() -> R()   gammaH
R() -> S()   omega
S() -> I()   impr
# cumulative-admissions accumulator (counts I->H without consuming I)
I() -> I() + Hadm()   rho*gamma
end reaction rules

end model

begin actions
generate_network({overwrite=>1})
simulate({suffix=>"SIHRS_flu",method=>"ode",t_start=>0,t_end=>48,n_steps=>48,print_functions=>1})
end actions
