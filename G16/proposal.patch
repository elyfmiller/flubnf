diff --git a/app/tests/test_weekly_report_files.py b/app/tests/test_weekly_report_files.py
new file mode 100644
index 0000000..300a6b5
--- /dev/null
+++ b/app/tests/test_weekly_report_files.py
@@ -0,0 +1,230 @@
+"""The weekly and season report files (bug hunt 2026-10-25, G16).
+
+  * A run's weekly report downloads under a name that carries the run,
+    and a modified run's the -modified of its files, so two runs of one
+    week never save over each other; the archived week's names its run.
+  * An archived run's season report carries the archive stamp.
+  * The grid's key lists only the models the panels draw.
+  * The report's way back goes to the console page that opened it.
+  * A hidden section's figures are drawn when it opens, not at load.
+  * A member whose scoring failed says why: on the run page and in the
+    report's accuracy card.
+"""
+import json
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core import archive_record, report_grid, report_season, report_v2  # noqa: E402
+from app.core.runs import Ledger, RunSpec                      # noqa: E402
+from app.core.scoring import summary_table_html                # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import shared as ui_shared                         # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui.routes import output as O                          # noqa: E402
+
+client = TestClient(srv.app)
+RID = "20980101T143105-aaaaaa"
+MODIFIED = {"knobs": {"groundhog.own_share": 0.6}}
+
+
+@pytest.fixture()
+def root(tmp_path, monkeypatch):
+    before = dict(ui_state._status)
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    for k in ("running", "workroot", "phase", "flash", "flash_kind",
+              "flash_detail"):
+        ui_state._status[k] = None
+    ui_shared._invalidate_scans()
+    yield tmp_path
+    ui_state._status.clear()
+    ui_state._status.update(before)
+    ui_shared._invalidate_scans()
+
+
+def _workroot(root, rid=RID, asof="2098-01-03", extra=None) -> Path:
+    """A run folder with a report and its results.json (the spec in it)."""
+    w = root / "workroots" / rid
+    w.mkdir(parents=True)
+    (w / "report.html").write_text("<html><body>REPORT</body></html>")
+    spec = RunSpec(engine="analogue", forecast_date=asof,
+                   locations=["Ohio"], extra=extra or {})
+    (w / "results.json").write_text(json.dumps(
+        {"forecast_date": asof, "spec": spec.to_json(), "models": {}}))
+    ui_shared._invalidate_scans()
+    return w
+
+
+def _name(r) -> str:
+    return r.headers["content-disposition"].split('filename="')[1][:-1]
+
+
+# ------------------------------------------- OU-03: the weekly report's name
+
+def test_two_runs_of_one_week_download_their_reports_under_their_own_names(root):
+    _workroot(root)
+    _workroot(root, "20980101T151200-bbbbbb")
+    a = client.get(f"/runs/{RID}/report/download")
+    b = client.get("/runs/20980101T151200-bbbbbb/report/download")
+    assert a.status_code == b.status_code == 200
+    assert _name(a) == f"2098-01-10-NAU_PyBNF-weekly-report-{RID}.html"
+    assert _name(b) == ("2098-01-10-NAU_PyBNF-weekly-report-"
+                        "20980101T151200-bbbbbb.html")
+
+
+def test_a_modified_runs_report_is_named_like_its_files(root):
+    _workroot(root, extra=MODIFIED)
+    r = client.get(f"/runs/{RID}/report/download")
+    assert _name(r) == f"2098-01-10-NAU_PyBNF-modified-weekly-report-{RID}.html"
+    assert O._weekly_report_name("2098-01-03", RID, modified=True) == _name(r)
+    # a run id with no results.json yet keeps the older name
+    assert O._weekly_report_name(RID, RID) == f"FluBNF-weekly-report-{RID}.html"
+
+
+def test_an_archived_weeks_report_names_the_run_its_record_holds(root):
+    d = root / "archive" / "2098-01-03"
+    d.mkdir(parents=True)
+    (d / "report.html").write_text("<html><body>ARCHIVE</body></html>")
+    r = client.get("/output/report/download?date=2098-01-03")
+    assert _name(r) == "2098-01-10-NAU_PyBNF-weekly-report.html"
+    archive_record.write_record(d, RID, complete=True)
+    r = client.get("/output/report/download?date=2098-01-03")
+    assert _name(r) == f"2098-01-10-NAU_PyBNF-weekly-report-{RID}.html"
+
+
+# ----------------------------------------- RE-26: the season report's name
+
+def test_an_archived_runs_season_report_carries_its_stamp(tmp_path, monkeypatch):
+    stamp = "20980204T101500Z"
+    assert report_season.report_path(tmp_path, "2097-98").name == \
+        "2097-98-FluBNF-season-report.html"
+    assert report_season.report_path(tmp_path, "2097-98", stamp).name == \
+        f"2097-98-FluBNF-season-report-archived-{stamp}.html"
+    # the download, through the route (the build itself stubbed)
+    from app.ui import retro_seasons
+    monkeypatch.setattr(retro_seasons, "RETRO_ROOT", tmp_path)
+
+    def build(root, season, archive="", **kw):
+        p = report_season.report_path(root, season, archive)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text("<html><body>SEASON</body></html>")
+        return p
+    monkeypatch.setattr(report_season, "build_season_report", build)
+    live = client.get("/retro/2097-98/report")
+    arch = client.get(f"/retro/2097-98/report?archive={stamp}")
+    assert live.status_code == arch.status_code == 200
+    assert _name(live) == "2097-98-FluBNF-season-report.html"
+    assert _name(arch) == f"2097-98-FluBNF-season-report-archived-{stamp}.html"
+
+
+# ------------------------------------- OU-04: the key lists the models drawn
+
+def _fan(med):
+    return {str(h): {L: med * (1 + 0.2 * z) for L, z in
+                     ((0.025, -1.9), (0.25, -0.7), (0.5, 0),
+                      (0.75, 0.7), (0.975, 1.9))} for h in range(4)}
+
+
+def test_a_groundhog_only_reports_key_has_no_oracle_sihrs_switch():
+    from datetime import date, timedelta
+    asof = "2098-01-03"
+    names = ("Ohio", "US")
+    e = date.fromisoformat(asof)
+    weeks = [((e - timedelta(days=7 * (13 - i))).isoformat(), 10.0 + i)
+             for i in range(14)]
+    obs = {n: weeks for n in names}
+    hist = {n: weeks for n in names}
+    colors = {"pf": "#1979FF", "analogue": "#FFC72C"}
+    gh_only = report_grid.grid_data(
+        asof, list(names), {"Ohio": "OH", "US": "US"},
+        {"US": "United States"}, obs,
+        {"analogue": {n: _fan(24.0) for n in names}}, hist)
+    for html in (report_grid.grid_html(gh_only, colors),
+                 report_grid.us_feature_html(gh_only, colors)):
+        assert 'data-s="analogue"' in html and 'data-s="obs"' in html
+        assert 'class="g-key" data-s="pf"' not in html
+    both = report_grid.grid_data(
+        asof, list(names), {"Ohio": "OH", "US": "US"},
+        {"US": "United States"}, obs,
+        {"pf": {n: _fan(23.0) for n in names},
+         "analogue": {n: _fan(24.0) for n in names}}, hist)
+    assert 'class="g-key" data-s="pf"' in report_grid.grid_html(both, colors)
+
+
+# --------------------------- OU-05 and OU-06: the report page's own scripts
+
+def _charted(tmp_path) -> str:
+    rng = np.random.default_rng(5)
+    f_t = ["2098-01-10", "2098-01-17", "2098-01-24", "2098-01-31"]
+    q = report_v2.fan_quantiles(
+        f_t, {t: rng.gamma(4.0, 30.0, 300).tolist() for t in f_t})
+    fan = report_v2.fan_figure_from_quantiles(
+        ["2098-01-03"], [110.0], f_t, q, title="t")
+    return report_v2.build_report(
+        "2098-01-03", {}, {"OH": {"name": "Ohio", "fan": fan,
+                                  "cat": report_v2.cat_bar({"stable": 1.0}),
+                                  "table_rows": []}},
+        {}, tmp_path / "c.html").read_text(encoding="utf-8")
+
+
+def test_the_way_back_goes_to_the_console_page_that_opened_the_report(tmp_path):
+    html = _charted(tmp_path)
+    back = html.split('id="appback"', 1)[1].split("</a>", 1)[0]
+    assert "history.back()" in back            # no page to go back to by name
+    script = html.split("var _ab = document.getElementById('appback')", 1)[1]
+    assert "document.referrer" in script
+    assert "from.origin === location.origin" in script
+    assert "_ab.href = from.href" in script
+
+
+def test_a_hidden_sections_figures_wait_for_it_to_open(tmp_path):
+    html = _charted(tmp_path)
+    section = html.split('<section class="state" id="st-OH"', 1)[1] \
+                  .split("</section>", 1)[0]
+    assert section.count('<script type="application/json" class="rp-figjson"') == 2
+    assert "Plotly.newPlot" not in section
+    assert '<\\/' not in section.split("rp-figjson")[0]
+    # the figure's JSON holds its data, layout and the save-PNG config
+    payload = json.loads(section.split('data-for="', 1)[1]
+                         .split(">", 1)[1].split("</script>", 1)[0])
+    assert set(payload) == {"data", "layout", "config"}
+    assert payload["config"]["toImageButtonOptions"]["filename"] == \
+        "flubnf_report_figure"
+    # show() draws them once, retinted and fitted like the rest
+    show = html.split("function show(id", 1)[1].split("window.backToMap", 1)[0]
+    assert "rpDraw(el);" in show
+    draw = html.split("window.rpDraw = function(el)", 1)[1].split("};", 1)[0]
+    for step in ("Plotly.newPlot(gd, f.data, f.layout, f.config)",
+                 "rpRetint(gd)", "FluCharts.adopt(gd)", "js[i].remove()"):
+        assert step in draw, step
+    assert "window.rpRetint=pass" in html
+    # a report without figures carries none of it
+    bare = report_v2.build_report("2098-01-03", {}, {}, {},
+                                  tmp_path / "b.html").read_text(encoding="utf-8")
+    assert "window.rpDraw = function" not in bare and "FluCharts" not in bare
+
+
+# ------------------------------- FC-20: a member's scoring failure is said
+
+def test_a_members_scoring_failure_is_said_on_the_run_page_and_in_the_report(root):
+    led = Ledger()
+    rid = led.open_run(RunSpec(engine="analogue", forecast_date="2098-01-03",
+                               locations=["Ohio"]), Path("pending"), {})
+    why = "the hub clone has no model-output/FluSight-baseline"
+    led.close_run(rid, "ok", {"analogue_score_error": why})
+    ui_shared._invalidate_scans()
+    page = client.get(f"/runs/{rid}").text
+    assert "Step that failed" in page
+    assert f"<code>analogue_score_error</code> <span>{why}</span>" in page
+    # the accuracy card names the reason instead of "no scored weeks yet"
+    card = summary_table_html(pd.DataFrame(), model="analogue", error=why)
+    assert card == f"<p class='hint'>Groundhog could not be scored: {why}</p>"
+    assert summary_table_html(pd.DataFrame(), model="analogue") == \
+        "<p class='hint'>Groundhog: no scored weeks yet.</p>"
