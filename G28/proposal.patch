+++ b/app/tests/test_retro_words.py
@@ -0,0 +1,155 @@
+"""Retrospective wording and marks (bug hunt 2026-10-25, G28).
+
+  * The zero-anchor refusal names the Run form's own control.
+  * An import refusal calls an upload by its own name, and a folder path
+    is said to be a folder.
+  * Deleting an imported run says where it came from, in the confirm and
+    in the flash.
+  * A resume refused over other settings says them in the panel's words,
+    never by key or digest; the archive flash and the scope line likewise.
+  * The season rows carry no "?" marks beyond the two that name the
+    scoring convention; the Your data tab keeps the page's one explainer.
+"""
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from fastapi.testclient import TestClient                  # noqa: E402
+
+from app.core import replay_bundle as rb                   # noqa: E402
+from app.ui import server as srv                           # noqa: E402
+from app.ui import state as ui_state                       # noqa: E402
+from app.ui.routes import retro as ui_retro                # noqa: E402
+from test_fewer_marks import marks                         # noqa: E402
+
+client = TestClient(srv.app)
+REPO = Path(__file__).resolve().parents[2]
+
+
+def test_the_zero_anchor_refusal_names_the_forms_control(monkeypatch):
+    # RE-16: the tip said "Set Newest week reading 0", a Model settings
+    # knob's name; the Run form's control is "Groundhog when the newest
+    # week reads 0"
+    from app.core import retro as core_retro
+    monkeypatch.setattr(core_retro, "available_seasons", lambda: ["2097-98"])
+    ui_state._status["running"] = None
+    client.post("/retro/run", data={"season": "2097-98", "engine": "analogue",
+                                    "mode": "archive", "locations": "panel6"},
+                follow_redirects=False)
+    assert "choose what the Groundhog does" in ui_state._status["flash"]
+    assert ui_state._status["flash_detail"] == (
+        "Set Groundhog when the newest week reads 0: abstain, level, extend "
+        "or blend.")
+
+
+def test_an_import_refusal_names_the_upload_and_a_folder(tmp_path, monkeypatch):
+    # RE-20: the saved copy's name (incoming-<pid>-<ms>.zip) and "retro: no
+    # such file" for a folder
+    monkeypatch.setattr(ui_retro, "_exports_dir", lambda: tmp_path / "exports")
+    ui_state._status.pop("flash", None)
+    client.post("/retro/import", files={"file": ("notzip.zip", b"nope",
+                                                 "application/zip")},
+                follow_redirects=False)
+    assert "Not imported: notzip.zip is not a zip file." in ui_state._status["flash"]
+    assert "incoming-" not in ui_state._status["flash"]
+    folder = tmp_path / "retro"
+    folder.mkdir()
+    ui_state._status.pop("flash", None)
+    client.post("/retro/import", data={"path": str(folder)},
+                follow_redirects=False)
+    assert (f"Not imported: {folder} is a folder, not a bundle."
+            in ui_state._status["flash"])
+
+
+def test_an_imported_runs_delete_says_where_it_came_from(tmp_path, monkeypatch):
+    # RE-21: "the archived 2025-26 run from imported from vm on ..."
+    tpl = (REPO / "app" / "ui" / "templates" / "retro.html").read_text(
+        encoding="utf-8")
+    assert 'data-when="{{ a.imported or a.when }}"{% if a.imported %} ' \
+           'data-imported="1"{% endif %}' in tpl
+    assert "removes the '+(d.imported?d.season+' run '+d.when" in tpl
+    assert ":'archived '+d.season+' run from '+d.when)" in tpl
+    # the flash names the import, not the stamp it was set aside under
+    from app.core import retro as core_retro
+    monkeypatch.setattr(core_retro, "archive_dir", lambda *a: tmp_path)
+    monkeypatch.setattr(core_retro, "run_summary", lambda p: {"weeks": 31})
+    monkeypatch.setattr(core_retro, "dir_size", lambda p: 93_900)
+    monkeypatch.setattr(core_retro, "delete_tree", lambda p: None)
+    monkeypatch.setattr(rb, "imported_label", lambda p: "imported from vm on 2026-11-10")
+    ui_state._status.pop("flash", None)
+    r = client.post("/retro/2025-26/archive/20261110T053829Z/delete",
+                    data={"confirm": "2025-26"}, follow_redirects=False)
+    assert r.status_code == 303, r.text[:200]
+    flash = ui_state._status["flash"]
+    assert "Deleted the 2025-26 run imported from vm on 2026-11-10: " in flash
+    assert "from imported" not in flash
+
+
+def test_settings_are_said_in_the_panels_words():
+    # RE-22: "modified: groundhog.zero_anchor=abstain (a86a7e3c)"
+    assert ui_retro._settings_words({"groundhog.zero_anchor": "abstain"}) == (
+        "Newest week reading 0 = abstain")
+    assert ui_retro._settings_words({"pf.replicates": 5,
+                                     "groundhog.zero_anchor": "level"}) == (
+        "Newest week reading 0 = level, Replicates = 5")
+    assert ui_retro._settings_words({}) == "the default settings"
+    from app.core import retro_settings as rs
+    assert rs.location_scope_change(["Vermont"], ["Ohio", "Utah"]) == (
+        "replayed over 1 location; this run asks for 2, a different list")
+    src = (REPO / "app" / "ui" / "routes" / "retro.py").read_text(encoding="utf-8")
+    assert '"its archived runs); starting a fresh replay."' in src
+    assert "{dst.name}; starting a fresh replay" not in src
+    # RE-27: the docs put the Import card where it is
+    docs = (REPO / "docs" / "RETROSPECTIVES.md").read_text(encoding="utf-8")
+    assert "(its own card, under\nSettings)" in docs
+    assert "(Settings card)" not in docs
+
+
+def test_the_season_rows_carry_only_the_conventions_marks():
+    """RE-18: a complete, sealed season with added weeks, a live one and
+    its archives once carried a "?" on the wall time, the estimate, the
+    sealed badge, Resume and the archived-runs heading. The two that name
+    the relWIS convention stay (every score beside its convention), and
+    the added-weeks badge keeps the weeks Resume would run; the rest say
+    their words."""
+    html = srv.templates.env.get_template("retro.html").render(
+        active="Retrospective", state_names=["Ohio"], engine_ok=True,
+        seasons=[{"name": "2097-98", "total": 30, "done": 30, "seal": True,
+                  "seal_label": "shipped record", "running": False,
+                  "paused": False, "active": False, "status": "done",
+                  "elapsed_s": 325, "mean_s": 10.5, "weeks_measured": 31,
+                  "eta_s": None, "scored": True, "rel": 0.877, "added_n": 2,
+                  "added": ["2098-06-06", "2098-06-13"],
+                  "resume_fields": {"season": "2097-98"},
+                  "archives": [{"id": "a", "when": "yesterday", "weeks": 3,
+                                "elapsed_s": None, "rel": 0.9,
+                                "size_h": "1 MB"}]},
+                 {"name": "2096-97", "total": 30, "done": 4, "seal": False,
+                  "running": True, "paused": False, "active": True,
+                  "status": "running", "elapsed_s": 40, "mean_s": 10,
+                  "weeks_measured": 4, "eta_s": 260, "scored": False,
+                  "archives": []}])
+    seen = {m for m in marks(html) if m != "tip-flash"}   # the layout's
+    assert seen == {"tip-rt-page", "tip-rt-import-h",
+                    "tip-rt-rel-2097-98-x", "tip-rt-arch-2097-98",
+                    "tip-rt-added-2097-98"}, sorted(seen)
+    # the words the marks held
+    assert '<span class="uk-badge-t">sealed · shipped record</span>' in html
+    assert '<span class="hint">10 s per week</span>' in html
+    assert re.search(r'<span class="rbasis hint">\s*estimate from 4 completed '
+                     r'weeks', html)
+
+
+def test_the_your_data_tab_keeps_the_pages_one_explainer():
+    # RE-19: Dataset, final data, Groups, Models, FluSurv-NET donors and
+    # "Replays of <name>" each had a "?" repeating the heading's words
+    html = client.get("/retro?tab=own").text
+    seen = {m for m in marks(html) if not m.startswith("tip-dsup-")}
+    assert seen == {"tip-rt-page"}, sorted(seen)
+    tpl = (REPO / "app" / "ui" / "templates" / "_dataset_replay.html").read_text(
+        encoding="utf-8")
+    assert "Add FluSurv-NET donors (US influenza hospitalization-like data only)" in tpl
+    for gone in ('"dsr-src", "A dataset replays', 'tips.tip("dsr-fs"',
+                 'tips.tip("dsr-rel-', '{% set about ='):
+        assert gone not in tpl, gone
