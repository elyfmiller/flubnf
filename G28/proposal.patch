+def _settings_words(values) -> str:
+    """A run's non-default model settings in the panel's words ("Newest
+    week reading 0 = abstain", "Replicates = 5"), never by key or digest;
+    "the default settings" when none."""
+    bits = []
+    for key in sorted(values or {}):
+        knob = _knobs.BY_KEY.get(key)
+        word = _knobs.choice_word(key, values[key])
+        bits.append(f"{knob.label if knob else key} = {word}")
+    return ", ".join(bits) if bits else "the default settings"
