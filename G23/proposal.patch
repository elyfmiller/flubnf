+++ b/app/tests/test_retro_forms.py
@@ -0,0 +1,86 @@
+"""Retrospective forms and navigation (G23): the Run form keeps its choices
+through a refusal or a run; the season page's Show in folder gets the
+reveal's answer; a dataset replay's page leads back to its dataset and
+says how far a stopped replay got."""
+
+from app.core import custom_retro as CX
+from app.core import datasets as D
+from app.ui import retro_seasons as ui_retro_seasons  # noqa: E402
+from app.ui import state as ui_state                 # noqa: E402
+from test_dataset_replay_knobs import _replay          # noqa: E402
+from test_datasets_ui import TEMPLATE, client, isolated, stored  # noqa: E402,F401
+
+
+# -------------------------------------------------------------------- RE-13
+
+def test_the_run_form_keeps_its_choices_through_a_refusal():
+    r = client.post("/retro/run", data={
+        "season": "2023-24", "locations": "custom", "national": "0",
+        "engine": "analogue", "knob.groundhog.zero_anchor": "blend",
+        "mode": "resume", "width": "3"}, follow_redirects=False)
+    assert r.status_code == 303
+    assert "no locations checked" in ui_state._status.get("flash", "")
+    html = client.get("/retro").text
+    assert "<option selected>2023-24</option>" in html
+    assert '<option value="custom" selected>custom selection</option>' in html
+    assert 'id="retro-custom">' in html                # the list shown
+    assert '<option value="0" selected>states only</option>' in html
+    assert ('<option value="analogue" selected>Groundhog only (minutes)'
+            in html)
+    assert '<option value="blend" selected>blend:' in html
+    assert 'name="width" value="3"' in html
+    # a state ticked before the next try stays ticked
+    client.post("/retro/run", data={
+        "season": "2023-24", "locations": "custom",
+        "custom_locations": ["Vermont"], "national": "0",
+        "engine": "analogue", "knob.groundhog.zero_anchor": "blend",
+        "mode": "resume"}, follow_redirects=False)
+    html = client.get("/retro").text
+    assert 'value="Vermont" checked>' in html
+    assert ui_retro_seasons._retro_form["custom_locations"] == ["Vermont"]
+
+
+def test_a_first_open_has_the_form_at_its_defaults():
+    html = client.get("/retro").text
+    assert "selected>" not in html.split('id="rt-season"', 1)[1].split("</select>", 1)[0]
+    assert 'id="retro-custom" style="display:none"' in html
+    assert '<option value="">Choose…</option>' in html
+
+
+# ------------------------------------------------------------- RE-12, WI-05
+
+def test_the_reveal_answers_a_script_caller_in_json():
+    r = client.post("/output/reveal", data={"path": "/nowhere"},
+                    headers={"accept": "application/json"})
+    assert r.status_code == 200
+    got = r.json()
+    assert got["ok"] is False
+    assert got["message"].startswith("Nothing opened:")
+    assert "Storage lists what is on disk" in got["detail"]
+    # a form post still goes back to the page with the flash
+    r = client.post("/output/reveal", data={"path": "/nowhere"},
+                    follow_redirects=False)
+    assert r.status_code == 303
+    assert ui_state._status.get("flash", "").startswith("Nothing opened:")
+
+
+# ------------------------------------------------------------- RE-24, RE-25
+
+def test_a_replay_page_leads_back_and_says_how_far_a_stopped_one_got():
+    ds = stored(TEMPLATE.read_bytes(), "Template")
+    r, meta = _replay(ds)
+    assert meta["status"] == "done", meta.get("error")
+    url = r.headers["location"]
+    html = client.get(url).text
+    assert (f'<a class="rt-back" href="/retro?dataset={ds.id}">'
+            f"Replays of {ds.name}</a>") in html
+    assert "Progress" not in html                   # a finished replay
+    # the same replay, stopped after three weeks
+    d = CX.replay_dir(D.get(ds.id), url.rsplit("/", 1)[1])
+    CX.write_meta(d, {**CX.read_meta(d), "status": "stopped",
+                      "weeks_completed": 3})
+    html = client.get(url).text
+    total = meta["total_weeks"]
+    assert f"stopped after 3 of {total} weeks" in html
+    assert f"3 of {total} ({meta['first']} to {meta['last']})" in html
+    assert "No forecasts stored yet" not in html
