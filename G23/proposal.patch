+#: the Run form's choices the page echoes (retro_seasons._retro_form),
+#: kept in the state folder across restarts as the Forecast tab's
+#: last_form.json is
+RETRO_FORM_NAME = "retro_form.json"
+
+
+def _retro_form_path() -> Path:
+    from app.core.runs import APP_STATE
+    return APP_STATE / RETRO_FORM_NAME
+
+
+def _remember_form(**fields) -> None:
+    """Keep the Run form's choices (every POST, before any refusal), so the
+    page shows them again; never raises (a read-only disk loses the
+    memory across restarts only)."""
+    retro_seasons._retro_form.clear()
+    retro_seasons._retro_form.update(fields)
+    try:
+        p = _retro_form_path()
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_text(json.dumps(fields, sort_keys=True), encoding="utf-8")
+    except OSError:
+        pass
+
+
+#: the file an EARLIER process wrote is read once (as forecast_aids
+#: restores last_form.json): what this process posted is in memory
+_retro_form_restored = {"done": False}
+
+
+def _last_retro_form() -> dict:
+    """The remembered choices ({} on a first open), from memory or, once,
+    the file an earlier process wrote."""
+    if not retro_seasons._retro_form and not _retro_form_restored["done"]:
+        _retro_form_restored["done"] = True
+        try:
+            got = json.loads(_retro_form_path().read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            got = {}
+        if isinstance(got, dict):
+            retro_seasons._retro_form.update(got)
+    return dict(retro_seasons._retro_form)
+
+
