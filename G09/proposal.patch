+def _pid_alive(pid: int) -> bool:
+    """Whether a process with this id exists (any user's)."""
+    if sys.platform == "win32":
+        # os.kill on Windows terminates: ask the kernel for a handle instead
+        import ctypes
+        query = 0x1000                      # PROCESS_QUERY_LIMITED_INFORMATION
+        h = ctypes.windll.kernel32.OpenProcess(query, False, int(pid))
+        if not h:
+            return False
+        ctypes.windll.kernel32.CloseHandle(h)
+        return True
+    try:
+        os.kill(int(pid), 0)
+    except ProcessLookupError:
+        return False
+    except PermissionError:
+        return True
+    return True
+
+
+def worker_dead(meta: dict) -> bool:
+    """Whether the record names a worker process (`pid`, this app's or
+    the CLI's) that no longer exists: the app was closed mid-replay. A
+    record without a pid (from before it was kept) leaves the heartbeat to
+    decide."""
+    pid = (meta or {}).get("pid")
+    try:
+        pid = int(pid)
+    except (TypeError, ValueError):
+        return False
+    if pid <= 0 or pid == os.getpid():
+        return False
+    try:
+        return not _pid_alive(pid)
+    except Exception:
+        return False
+
+
