+# ------------------------------------------- a dead worker, a sealed record
+
+def test_a_dead_workers_record_reads_interrupted_at_once(monkeypatch):
+    """After a relaunch the record of a replay the closed app was running
+    read 'running' with a ticking clock and an ETA for four minutes, and
+    refused every Run, until its heartbeat went stale: the record names
+    its worker, and a worker that is gone means interrupted now."""
+    import os
+    now = 5_000.0
+    live = {"status": "running", "heartbeat_utc": now - 5, "pid": 424242}
+    monkeypatch.setattr(retro, "_pid_alive", lambda pid: False)
+    assert retro.worker_dead(live) is True
+    assert retro.effective_status(live, now=now) == "interrupted"
+    # this process is the worker: alive by definition
+    own = {**live, "pid": os.getpid()}
+    assert retro.worker_dead(own) is False
+    assert retro.effective_status(own, now=now) == "running"
+    # a record from before the pid was kept leaves it to the heartbeat
+    assert retro.effective_status({"status": "running",
+                                   "heartbeat_utc": now - 5}, now=now) \
+        == "running"
+    # the real check, on this process
+    monkeypatch.undo()
+    assert retro._pid_alive(os.getpid()) is True
+
+
+def test_an_interrupted_replays_wall_time_stops_at_its_heartbeat():
+    """The clock of a dead replay grew without bound (the open segment
+    was counted to now); it ends at the last heartbeat."""
+    now = 5_000.0
+    meta = {"status": "running", "elapsed_s": 12.0,
+            "segment_start_utc": now - 300,
+            "heartbeat_utc": now - retro.HEARTBEAT_STALE_S - 10}
+    assert retro.elapsed_now(meta, now=now) == pytest.approx(
+        12.0 + 300 - retro.HEARTBEAT_STALE_S - 10)
+    assert retro.elapsed_now(meta, now=now + 600) == \
+        retro.elapsed_now(meta, now=now)
+    alive = {**meta, "heartbeat_utc": now - 5}
+    assert retro.elapsed_now(alive, now=now) == pytest.approx(312.0)
+
+
