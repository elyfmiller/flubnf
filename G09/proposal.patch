+def test_a_running_seasons_page_shows_its_weeks_without_a_finalize_job(
+        tmp_path, _stubbed, _routed, monkeypatch):
+    """While a replay ran, every visit started a finalize job (each new
+    week made the caches stale), so the page looped on 'preparing
+    results': a live season renders what it has, with its progress card;
+    the worker finalizes the season when it ends."""
+    import os
+    root = _mk_tree(_routed)
+
+    def _never(*a, **k):
+        raise AssertionError("no finalize job while the replay runs")
+
+    monkeypatch.setattr(retro, "finalize_season", _never)
+    ui_retro_seasons._retro_status[SEASON] = "running"
+    retro.write_meta(root, {"status": "running", "total_weeks": 10,
+                            "weeks_completed": 2, "elapsed_s": 50.0,
+                            "segment_start_utc": None,
+                            "heartbeat_utc": time.time(),
+                            "pid": os.getpid()})
+    try:
+        r = client.get(f"/retro/{SEASON}")
+        assert r.status_code == 200
+        assert "preparing results</h1>" not in r.text
+        assert ": 0 weeks scored</h1>" in r.text
+        assert "Replay in progress" in r.text
+        assert "preparing results</h1>" not in client.get(
+            f"/retro/{SEASON}?rescore=1").text
+    finally:
+        ui_retro_seasons._retro_status.pop(SEASON, None)
+    assert ui_retro_prep._results_jobs == {}
+
+
