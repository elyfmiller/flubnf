diff --git a/app/tests/test_no_engine.py b/app/tests/test_no_engine.py
new file mode 100644
index 0000000..b880d89
--- /dev/null
+++ b/app/tests/test_no_engine.py
@@ -0,0 +1,206 @@
+"""Runs and replays when the particle-filter engine is missing (the
+2026-10-25 bug hunt, G05).
+
+  * the Oracle SIHRS alone, or the research run, is refused up front in
+    words (it once ended "ok" as a Groundhog-only run with no file, FC-03,
+    MO-05, WI-09); "Both" runs the Groundhog alone and the form and the
+    Running card say so (FC-04);
+  * the ledger's chip reads the skip's reason: a Groundhog-only run skipped
+    the filter by choice (FC-17, ST-03, WI-06);
+  * a season replay with the Oracle preset is refused before anything is
+    archived, and a season whose every week failed ends in error, not
+    "complete" with no weeks (RE-02); the Retrospective form preselects
+    the preset that can run (RE-23).
+"""
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.core import retro                                   # noqa: E402
+from app.core import runs as runs_mod                        # noqa: E402
+from app.ui import pipeline as ui_pipeline                   # noqa: E402
+from app.ui import retro_seasons as ui_retro_seasons         # noqa: E402
+from app.ui import shared as ui_shared                       # noqa: E402
+from app.ui import state as ui_state                         # noqa: E402
+from app.ui.routes import retro as ui_retro                  # noqa: E402
+
+from test_data_source import (W1, W2, W3, _capture, _hub,     # noqa: E402,F401
+                              _isolated, client)
+
+ABSENT = ("Not run: the Oracle SIHRS needs the particle-filter engine, "
+          "which is not installed on this machine.")
+BROKEN = ("Not run: the Oracle SIHRS needs the particle-filter engine, "
+          "whose install is incomplete.")
+
+
+@pytest.fixture
+def started(tmp_path, monkeypatch):
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path / "state")
+    out = _capture(monkeypatch, tmp_path)
+    _hub(tmp_path / "hub", [W1, W2, W3], [W1, W2, W3], monkeypatch)
+    return out
+
+
+def _engine(monkeypatch, state):
+    monkeypatch.setattr(ui_pipeline, "_pf_engine_state", lambda: state)
+
+
+def _post(**data):
+    ui_state._status["running"] = None
+    ui_state._status["flash"] = None
+    return client.post("/run", data={"forecast_date": W3, "locations": ["Ohio"],
+                                     "engine": "all", **data},
+                       follow_redirects=False)
+
+
+# ------------------------------------------------------------- the console run
+
+@pytest.mark.parametrize("state,said", [("absent", ABSENT), ("broken", BROKEN)])
+def test_the_oracle_alone_is_refused_without_the_engine(started, monkeypatch,
+                                                        state, said):
+    _engine(monkeypatch, state)
+    for data in ({"engine": "pf"}, {"engine": "all", "members": "3"}):
+        r = _post(**data)
+        assert r.status_code == 303 and started == [], data
+        assert ui_state._status["flash"] == said, data
+    # the Groundhog alone, and both models with the engine, run
+    _engine(monkeypatch, "ready")
+    _post(engine="pf")
+    _engine(monkeypatch, state)
+    _post(engine="analogue")
+    assert [s.engine for s in started] == ["pf", "analogue"]
+
+
+def test_both_without_the_engine_runs_the_groundhog_alone_and_says_so(
+        started, monkeypatch):
+    """The record keeps "all" with the skip's reason (the suite's Tier A
+    path); the progress has no fit count to wait for."""
+    _engine(monkeypatch, "absent")
+    r = _post(engine="all")
+    assert r.status_code == 303 and len(started) == 1
+    assert started[0].engine == "all"
+    assert ui_state._status["expected_total"] is None
+    _engine(monkeypatch, "ready")
+    _post(engine="all")
+    assert ui_state._status["expected_total"] == 3        # one state, 3 replicates
+
+
+def test_the_running_card_names_the_groundhog_alone_without_the_engine(
+        tmp_path, monkeypatch):
+    from app.core.engines import analogue as an_engine
+    from app.core.runs import RunSpec
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    monkeypatch.setattr(ui_pipeline, "_sleep_guard", lambda: None)
+    _engine(monkeypatch, "absent")
+    seen = []
+    monkeypatch.setattr(an_engine, "run",
+                        lambda spec, **kw: seen.append(dict(ui_state._status["settings"])) or {})
+    ui_state._status.update({"running": "starting", "workroot": None})
+    ui_pipeline._run_all(RunSpec(engine="all", forecast_date="2098-01-03",
+                                 locations=["Ohio"]))
+    assert seen[0]["engine"] == "Groundhog only (no PF engine on this machine)"
+    assert "replicates" not in seen[0] and "particles" not in seen[0]
+
+
+def test_the_forecast_form_says_when_the_oracle_cannot_run(monkeypatch):
+    _engine(monkeypatch, "absent")
+    html = client.get("/forecast").text
+    assert ("Groundhog only: the Oracle SIHRS engine is not installed on "
+            "this machine" in html) and 'id="fc-pf-off"' in html
+    assert re.search(r'<option value="pf"[^>]*\bdisabled>', html)
+    _engine(monkeypatch, "broken")
+    html = client.get("/forecast").text
+    assert "Oracle SIHRS engine install incomplete" in html
+    _engine(monkeypatch, "ready")
+    html = client.get("/forecast").text
+    assert 'id="fc-pf-off"' not in html
+    assert not re.search(r'<option value="pf"[^>]*\bdisabled>', html)
+
+
+def test_the_model_pages_offer_no_oracle_run_without_the_engine(monkeypatch):
+    _engine(monkeypatch, "absent")
+    pf = client.get("/models").text
+    assert 'id="md-engine"' in pf and "which is not installed on this machine" in pf
+    assert 'disabled aria-describedby="md-engine">Run Oracle SIHRS only' in pf
+    gh = client.get("/model/analogue").text
+    assert 'id="md-engine"' not in gh and "disabled" not in gh.split('class="card md-quick"')[1].split("</form>")[0]
+    rr = client.get("/model/pf2s").text
+    assert "The two-strain member needs the particle-filter engine" in rr
+    _engine(monkeypatch, "ready")
+    pf = client.get("/models").text
+    assert 'id="md-engine"' not in pf
+    assert '<button class="gold" data-guard="console-run">Run Oracle SIHRS only' in pf
+
+
+# ---------------------------------------------------------------- the ledger
+
+def test_the_ledger_chip_reads_the_skips_reason():
+    chips = ui_shared._outcome_chips({"pf_skipped": "analogue-only run"})
+    assert "Groundhog only" in chips and "no engine" not in chips
+    chips = ui_shared._outcome_chips({"pf_skipped": "engine venv not installed (Tier A)"})
+    assert "PF skipped (no engine)" in chips
+
+
+# ------------------------------------------------------------ the replay
+
+SEASON = "2024-25"
+
+
+def test_a_replay_with_the_oracle_preset_is_refused_before_anything_is_archived(
+        tmp_path, monkeypatch):
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(retro, "available_seasons", lambda: [SEASON])
+    monkeypatch.setattr(retro, "season_vintages", lambda s: [W1, W2])
+    launched = []
+    monkeypatch.setattr(ui_retro, "_retro_bg", lambda *a, **k: launched.append(a))
+    root = tmp_path / SEASON
+    (root / "weeks").mkdir(parents=True)
+    (root / "run_meta.json").write_text('{"status": "done", "weeks_completed": 4}')
+    _engine(monkeypatch, "absent")
+    ui_state._status["running"] = None
+    r = client.post("/retro/run", data={
+        "season": SEASON, "locations": "panel6", "engine": "pf",
+        "mode": "archive", "knob.groundhog.zero_anchor": "level"},
+        follow_redirects=False)
+    assert r.status_code == 303 and launched == []
+    assert ("Not started: the Oracle SIHRS needs the particle-filter engine, "
+            "which is not installed on this machine." in ui_state._status["flash"])
+    assert (root / "run_meta.json").is_file()        # nothing archived
+    assert not [p for p in tmp_path.iterdir() if p.name != SEASON]
+
+
+def test_a_season_whose_every_week_failed_ends_in_error_naming_the_first(
+        tmp_path, monkeypatch):
+    monkeypatch.setattr(retro, "season_vintages", lambda s: [W1, W2])
+
+    def boom(*a, **k):
+        raise RuntimeError("the fork does not provide fit_type = pf")
+    monkeypatch.setattr(retro, "run_week", boom)
+    root = tmp_path / SEASON
+    assert retro.run_season(root, SEASON, ["Ohio"], width=1, engine="analogue") == []
+    meta = retro.read_meta(root)
+    assert meta["status"] == f"error: {W1}: the fork does not provide fit_type = pf"
+    assert meta["weeks_completed"] == 0
+    assert (root / "failures.log").read_text().count("\n") == 2
+
+
+def test_the_retrospective_form_preselects_the_preset_that_can_run(
+        tmp_path, monkeypatch):
+    import flubnf.settings as fs
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(fs, "PY_ENGINE", tmp_path / "no-venv")
+    html = client.get("/retro").text
+    assert '<option value="analogue" selected>' in html
+    assert '<option value="pf">' in html
+    exe = tmp_path / "python"
+    exe.write_text("")
+    monkeypatch.setattr(fs, "PY_ENGINE", exe)
+    monkeypatch.setattr(fs, "PYBNF", tmp_path)
+    html = client.get("/retro").text
+    assert '<option value="pf" selected>' in html
