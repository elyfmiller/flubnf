+def realtime_of(spec) -> bool:
+    """Whether a recorded spec (a RunSpec, its dict or its JSON) is a
+    real-time run: its extra's mode, "realtime" when absent (every record
+    from before the mode). A vintage replay of a past week is not the
+    week's forecast."""
