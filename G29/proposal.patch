diff --git a/app/tests/test_storage_words.py b/app/tests/test_storage_words.py
new file mode 100644
index 00000000..ca5164db
--- /dev/null
+++ b/app/tests/test_storage_words.py
@@ -0,0 +1,316 @@
+"""The Storage tab's words, counts and marks (bug hunt 2026-10-25, G29):
+the ledger summary counts every recorded run; the disk sections carry no
+"?" and a busy row says why on hover; report archives are busy only while
+the run can write them; an archived run's time is the computer's clock;
+the bulk controls count rows and workroots without "completed"; the
+empty states follow the listings; a run's delete confirmation leads with
+its label; a deleted dataset's notice names only what went; the Protected
+heading has no tip; the ledger filter finds runs that did not finish ok
+and a run's day."""
+import sys
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core import retro                                     # noqa: E402
+from app.core.runs import Ledger, RunSpec                      # noqa: E402
+from app.ui import datasets_ui                                 # noqa: E402
+from app.ui import retro_seasons as ui_retro_seasons           # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import shared as ui_shared                         # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui.routes import storage as ui_storage                # noqa: E402
+
+client = TestClient(srv.app)
+STAMP = "20980204T101500Z"
+
+
+@pytest.fixture()
+def root(tmp_path, monkeypatch):
+    before = dict(ui_state._status)
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    from app.core import datasets as datasets_mod
+    monkeypatch.setattr(datasets_mod, "ROOT", tmp_path / "datasets")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path / "retro")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_RESEAL", tmp_path / "noreseal")
+    import flubnf.settings as settings_mod
+    monkeypatch.setattr(settings_mod, "HUB", tmp_path / "hub")
+    for k in ("running", "workroot", "phase", "flash", "flash_kind",
+              "flash_detail"):
+        ui_state._status[k] = None
+    ui_shared._invalidate_scans()
+    yield tmp_path
+    ui_state._status.clear()
+    ui_state._status.update(before)
+    ui_shared._invalidate_scans()
+
+
+def _run(root, asof="2098-01-03", status="ok", engine="all", extra=None,
+         files=True) -> str:
+    """A ledger row and its workroot (a results file unless files=False)."""
+    time.sleep(1.05)                     # run ids sort by their start second
+    led = Ledger()
+    rid = led.open_run(RunSpec(engine=engine, forecast_date=asof,
+                               locations=["Ohio"], extra=extra or {}),
+                       root / "workroots" / "pending", {})
+    if status != "running":
+        led.close_run(rid, status, {})
+    wr = root / "workroots" / rid
+    wr.mkdir(parents=True)
+    if files:
+        (wr / "results.json").write_text("{}")
+    ui_shared._invalidate_scans()
+    return rid
+
+
+def _page():
+    ui_shared._invalidate_scans()
+    return client.get("/storage").text
+
+
+def _fold(html):
+    return html.split('id="storagefold"', 1)[1].split("</details>", 1)[0]
+
+
+def _section(html, hid):
+    return html.split(f'aria-labelledby="h-{hid}"', 1)[1].split("</section>", 1)[0]
+
+
+# ------------------------------------------------------------------- ST-04
+
+def test_the_ledger_summary_counts_every_recorded_run(root, monkeypatch):
+    for _ in range(3):
+        _run(root)
+    monkeypatch.setattr(ui_storage, "LEDGER_ROWS", 1)
+    html = _page()
+    joined = " ".join(html.split())
+    assert "3 runs recorded" in joined
+    assert "1 run recorded" not in joined
+    assert "Showing the newest 1 of 3 runs." in html
+
+
+# ------------------------------------------------------------------- ST-08
+
+def test_the_disk_sections_carry_no_marks_and_a_busy_row_says_why_on_hover(root):
+    done = _run(root)
+    live = _run(root, asof="2098-01-10", status="running")
+    ui_state._status["running"] = f"all:{live}"
+    ui_state._status["workroot"] = str(root / "workroots" / live)
+    (root / "archive" / "2098-01-03").mkdir(parents=True)
+    (root / "archive" / "2098-01-03" / "report.html").write_text("r")
+    (root / "hub").mkdir()
+    fold = _fold(_page())
+    # the sections, the reclaim tools, the busy rows: not one "?"
+    assert "tipbtn" not in fold
+    for hid in ("st-wr", "st-rp", "st-protected"):
+        assert f'id="h-{hid}"' in fold
+    row = fold.split(f'data-wid="{live}"', 1)[1].split("</div>", 1)[0]
+    assert "running now" in row and " disabled " in row
+    assert (f'title="The run {live} is active; its workroot cannot be '
+            'deleted while it runs."') in row
+    assert "data-del-storage" not in row
+    done_row = fold.split(f'data-wid="{done}"', 1)[1].split("</div>", 1)[0]
+    assert "data-del-storage" in done_row and " disabled " not in done_row
+    # one notice on the Report archives heading, each Delete off
+    sec = _section(fold, "st-rp")
+    assert sec.count("console run in progress") == 1
+    assert sec.count(" disabled ") == 1 and "tipbtn" not in sec
+
+
+def test_report_archives_are_busy_only_while_the_run_can_write_them(root):
+    (root / "archive" / "2098-01-03").mkdir(parents=True)
+    (root / "archive" / "2098-01-03" / "report.html").write_text("r")
+
+    def busy():
+        ui_shared._invalidate_scans()
+        inv = ui_storage._storage_inventory()
+        (row,) = inv["report_archives"]
+        p, why = ui_storage._storage_target("report-archive", "2098-01-03")
+        assert bool(row["busy"]) == (p is None)
+        return bool(row["busy"])
+
+    # a full run of both models writes the archive
+    full = _run(root, asof="2098-01-10", status="running")
+    ui_state._status["running"] = f"all:{full}"
+    assert busy() and ui_storage._may_archive()
+    # a Groundhog-only, a research, a modified and a vintage run never do
+    for kw in (dict(engine="analogue"),
+               dict(extra={"members": 3}),
+               dict(extra={"knobs": {"pf.replicates": 3}}),
+               dict(extra={"mode": "vintage"})):
+        rid = _run(root, asof="2098-01-10", status="running", **kw)
+        ui_state._status["running"] = f"all:{rid}"
+        assert not busy(), kw
+    # nor a dataset run or replay; a run still starting may
+    for marker in ("dataset:20980101T000000-abcdef", "dataset-replay:x"):
+        ui_state._status["running"] = marker
+        assert not busy(), marker
+    ui_state._status["running"] = "starting"
+    assert busy()
+    ui_state._status["running"] = None
+    assert not busy()
+    sec = _section(_page(), "st-rp")
+    assert "console run in progress" not in sec and "data-del-storage" in sec
+
+
+# ------------------------------------------------------------------- ST-10
+
+def test_an_archived_runs_time_is_the_computers_clock(root, monkeypatch):
+    want = (datetime.strptime(STAMP, "%Y%m%dT%H%M%SZ")
+            .replace(tzinfo=timezone.utc).astimezone()
+            .strftime("%Y-%m-%d %H:%M"))
+    assert retro.stamp_local(STAMP) == want
+    assert retro.stamp_local("junk") == "junk"
+    if hasattr(time, "tzset"):
+        monkeypatch.setenv("TZ", "America/Phoenix")
+        time.tzset()
+        try:
+            assert retro.stamp_local(STAMP) == "2098-02-04 03:15"
+            assert retro.stamp_human(STAMP) == "2098-02-04 10:15 UTC"
+        finally:
+            monkeypatch.delenv("TZ")
+            time.tzset()
+    _run(root)
+    arch = root / "retro" / f"2098-99__archived_{STAMP}"
+    (arch / "weeks").mkdir(parents=True)
+    sec = _section(_page(), "st-ra")
+    assert f"archived {retro.stamp_local(STAMP)}" in sec
+    assert "UTC" not in sec
+
+
+# ------------------------------------------------------------------- ST-11
+
+def test_the_bulk_controls_count_rows_and_workroots_without_completed(root):
+    _run(root, status="partial")
+    live = _run(root, asof="2098-01-10", status="running")
+    ui_state._status["running"] = f"all:{live}"
+    html = _page()
+    joined = " ".join(html.split())
+    assert "Delete 1 workroot (" in joined
+    btn = joined.split('id="clear-workroots-btn"', 1)[1].split("</button>", 1)[0]
+    assert "all" not in btn and "completed" not in btn
+    assert "Clear 1 row (files kept)" in joined
+    assert "statuses ok" not in html
+    assert "This removes '+n+' row'+(n==='1'?'':'s')+' from the ledger." in html
+    assert "title:'Delete every run workroot not running?'" in html
+    assert "report and submission " in html.split("clear-workroots-btn", 2)[2]
+    ui_state._status["running"] = None
+    _run(root, status="stopped")
+    joined = " ".join(_page().split())
+    assert "Delete 3 workroots (" in joined and "Clear 3 rows (files kept)" in joined
+
+
+def test_the_bulk_notices_count_without_completed(root):
+    _run(root, status="partial")
+    r = client.post("/runs/clear", data={"confirm": "1"}, follow_redirects=False)
+    assert r.status_code == 303
+    assert ui_state._status.pop("flash") == "Cleared 1 ledger row."
+    r = client.post("/runs/clear", data={"confirm": "0"}, follow_redirects=False)
+    assert ui_state._status.pop("flash") == "Nothing to clear: the ledger has no rows to remove."
+    r = client.post("/storage/clear-workroots", data={"confirm": "1"},
+                    follow_redirects=False)
+    assert ui_state._status.pop("flash").startswith("Deleted 1 run workroot: ")
+    r = client.post("/storage/clear-workroots", data={"confirm": "0"},
+                    follow_redirects=False)
+    assert ui_state._status.pop("flash") == "Nothing to delete: no run workroots on disk."
+    live = _run(root, asof="2098-01-10", status="running")
+    ui_state._status["running"] = f"all:{live}"
+    r = client.post("/storage/clear-workroots", data={"confirm": "0"},
+                    follow_redirects=False)
+    assert ui_state._status.pop("flash") == ("Nothing to delete: no run workroots "
+                                             "on disk apart from the active run's.")
+
+
+# ------------------------------------------------------------------- ST-12
+
+def test_the_empty_states_follow_the_listings(root):
+    html = _page()
+    assert "No runs yet" in html and "Nothing stored yet" in html
+    assert "No runs or replays on disk" in html
+    # a 0-byte workroot (a run stopped while starting): listed, so nothing
+    # says "nothing stored"
+    wr = root / "workroots" / "20980101T093000-abcdef"
+    wr.mkdir(parents=True)
+    (wr / "STOP").write_text("")
+    html = _page()
+    assert "Nothing stored yet" not in html
+    assert "No runs or replays on disk" not in html
+    assert '<span class="big">0 B</span>' in html
+    assert 'data-wid="20980101T093000-abcdef"' in html
+    # the ledger is empty while a run is on disk: it was cleared, or the
+    # run was never recorded; never "no runs yet"
+    assert "No runs recorded" in html and "No runs yet" not in html
+    assert 'href="/forecast"' in html.split('id="st-ledger-empty"', 1)[1][:600]
+
+
+# ------------------------------------------------------------------- ST-14
+
+def test_the_delete_confirmation_leads_with_the_runs_label(root):
+    rid = _run(root)
+    orphan = "20980118T093000-abcdef"
+    (root / "workroots" / orphan).mkdir(parents=True)
+    fold = _fold(_page())
+    row = fold.split(f'data-wid="{rid}"', 1)[1].split("</div>", 1)[0]
+    assert 'data-what="the Round 2098-01-10 (as of 2098-01-03) run"' in row
+    assert 'aria-label="Delete the Round 2098-01-10 (as of 2098-01-03) run"' in row
+    assert ('data-hint="Its report and submission files go with it; the '
+            'ledger row is kept and will show a dash for disk use. Run id '
+            f'{rid}."') in row
+    assert "workroot " + rid not in row
+    orow = fold.split(f'data-wid="{orphan}"', 1)[1].split("</div>", 1)[0]
+    assert f'data-what="the unrecorded run {orphan}"' in orow
+    # the confirmation still names the entry by its id
+    assert f'<input type="hidden" name="ident" value="{rid}">' in row
+
+
+# ------------------------------------------------------------------- ST-15
+
+def test_a_deleted_datasets_notice_names_only_what_went():
+    class DS:
+        name = "My counts"
+    msg, kind, detail = datasets_ui.deleted_message(DS, 12_000, 0, 0, 0)
+    assert msg == "Deleted My counts: 11.7 KB freed." and kind == "ok"
+    assert detail == ""
+    assert datasets_ui.deleted_message(DS, 1, 1, 0, 0)[2] == (
+        "With it went its 1 run workroot; the runs' ledger rows are kept.")
+    assert datasets_ui.deleted_message(DS, 1, 0, 0, 2)[2] == (
+        "With it went its 2 replays.")
+    assert datasets_ui.deleted_message(DS, 1, 2, 0, 1)[2] == (
+        "With it went its 1 replay and its 2 run workroots; the runs' "
+        "ledger rows are kept.")
+    msg, kind, detail = datasets_ui.deleted_message(DS, 1, 1, 1, 0)
+    assert kind == "warn" and "1 run workroot could not be deleted" in msg
+    assert detail.endswith(" The rest stay under Run workroots.")
+    assert "replays" not in detail
+
+
+# ------------------------------------------------------------------- ST-16
+
+def test_the_protected_heading_has_no_tip(root):
+    (root / "hub").mkdir()
+    _run(root)
+    sec = _section(_page(), "st-protected")
+    assert "FluSight hub clone" in sec and "tipbtn" not in sec
+    assert "sealed record backs" not in sec
+    assert '<span class="uk-tag">not in the total</span>' in sec
+
+
+# ------------------------------------------------------------------- ST-17
+
+def test_the_filter_finds_runs_that_did_not_finish_ok_and_a_runs_day(root):
+    rid = _run(root, status="partial")
