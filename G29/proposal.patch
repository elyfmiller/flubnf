+def stamp_local(stamp: str) -> str:
+    """'20260821T143012Z' as the computer's own clock, '2026-08-21 07:30'
+    in Arizona: the Storage tab lists an archived run beside run times,
+    which are local. An unparseable stamp is returned unchanged."""
+    try:
+        base = (stamp or "").split("-")[0]
+        t = datetime.strptime(base, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc)
+        return t.astimezone().strftime("%Y-%m-%d %H:%M")
+    except ValueError:
+        return stamp or ""
+
