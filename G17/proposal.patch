+def _missing_rows(missing: list) -> list:
+    """check()'s missing components as the Setup card lists them, each
+    once: {"name", "rest", "where"}, the engine's venv and fork as one
+    "Particle-filter engine" row (where: every path looked at)."""
+    rows = []
+    for key, path, why in missing or []:
+        where = f"{path} ({key})"
+        if _CHECK_NAMES.get(key) == ENGINE:
+            row = next((r for r in rows if r["name"] == ENGINE), None)
+            if row:
+                row["where"] += f" and {where}"
+                continue
+            rows.append({"name": ENGINE, "rest": "", "where": where})
+            continue
+        name, _sep, rest = why.partition(": ")
+        rows.append({"name": name, "rest": rest, "where": where})
+    return rows
+
