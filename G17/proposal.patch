diff --git a/app/tests/test_hub_setup.py b/app/tests/test_hub_setup.py
new file mode 100644
index 0000000..326b8dc
--- /dev/null
+++ b/app/tests/test_hub_setup.py
@@ -0,0 +1,153 @@
+"""A missing hub, the Setup card and the component versions (bug hunt
+2026-10-25, G17).
+
+  * With no hub clone, Data and Forecast say where it was looked for and
+    the step that fetches it; the hub check says "missing" in words; /run
+    refuses before it claims the engine.
+  * Home's Setup card counts the particle-filter engine once, gives the
+    most basic missing piece's step first (the hub and BioNetGen come from
+    setup), says "checking…" until the version probe answers, shows the
+    bngsim pin only beside a build that differs, and gives Perl's version.
+  * Right after Update data, the hub clone reads "up to date".
+"""
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import flubnf.settings as fs                                   # noqa: E402
+from app.core import data as data_mod                          # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui import versions as V                               # noqa: E402
+from app.ui.routes import data as D                            # noqa: E402
+from app.ui.routes import home as H                            # noqa: E402
+from app.ui.server import app as srv                           # noqa: E402
+
+client = TestClient(srv)
+ENGINE_MISSING = [
+    ("FLUBNF_HUB", "/nope/auxiliary-data",
+     "FluSight hub clone (truth vintages, locations)"),
+    ("FLUBNF_BNG", "/nope/BNG2.pl", "BioNetGen BNG2.pl (network generation)"),
+    ("FLUBNF_PY_ENGINE", "/nope/python", "engine venv python (pybnf + bngsim)"),
+    ("FLUBNF_PYBNF", "/nope/pybnf/pf.py", "PyBNF fork with fit_type=pf")]
+
+
+@pytest.fixture()
+def no_hub(tmp_path, monkeypatch, hub_absent):
+    """The hub folder is missing; the console's state in tmp_path."""
+    import app.core.runs as runs_mod
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    monkeypatch.setattr(data_mod, "HUB", tmp_path / "hub")
+    monkeypatch.setattr(data_mod, "LOCATIONS",
+                        tmp_path / "hub" / "auxiliary-data" / "locations.csv")
+    ui_state._status["running"] = None
+    ui_state._status.pop("flash", None)
+    yield tmp_path
+    ui_state._status.pop("flash", None)
+
+
+# ------------------------------------------------ WI-08 (DA-06): no hub
+
+def test_with_no_hub_data_and_forecast_say_so_and_a_run_is_refused(no_hub):
+    hub = str(no_hub / "hub")
+    assert data_mod.hub_missing()
+    page = client.get("/data").text
+    assert f"The FluSight hub clone is not at <code>{hub}</code>" in page
+    assert "<code>./setup.sh</code>" in page
+    assert ">missing<" in page.split('id="hub-pill"', 1)[1][:900]
+    assert f"The FluSight hub clone is not at <code>{hub}</code>" in \
+        client.get("/forecast").text
+    f = data_mod.check_freshness()
+    assert f.pill() == ("bad", "missing")
+    assert f.detail == f"no hub clone at {hub}"
+    # refused before the claim: nothing runs, nothing is recorded
+    r = client.post("/run", data={"forecast_date": "2026-04-25",
+                                  "engine": "analogue",
+                                  "locations": "Arizona"},
+                    follow_redirects=False)
+    assert r.status_code == 303
+    assert ui_state._status["flash"] == \
+        f"Not run: the FluSight hub clone is not at {hub}."
+    assert ui_state._status.get("running") is None
+    assert not (no_hub / "workroots").exists()
+
+
+# ------------------------------------------- DA-22: up to date after a pull
+
+def test_right_after_update_data_the_clone_reads_up_to_date(monkeypatch,
+                                                             tmp_path):
+    here = tmp_path / "locations.csv"           # a hub that is there
+    here.write_text("abbreviation,location,location_name,population\n")
+    monkeypatch.setattr(data_mod, "LOCATIONS", here)
+    monkeypatch.setattr(data_mod, "pull_hub", lambda: (True, "pulled"))
+    monkeypatch.setattr(D, "_live_values", lambda: None)
+    D._pulled.clear()
+    assert D._pull()[0]
+    pill = client.get("/data").text.split('id="hub-pill"', 1)[1][:900]
+    assert ">up to date<" in pill
+    # one-shot: a later visit has not checked
+    pill = client.get("/data").text.split('id="hub-pill"', 1)[1][:900]
+    assert ">not checked<" in pill
+
+
+# ---------------------------------------------- HM-08, HM-11: the Setup card
+
+def test_the_setup_card_counts_the_engine_once_and_leads_with_setup(
+        monkeypatch):
+    monkeypatch.setattr(fs, "check", lambda verbose=True: ENGINE_MISSING)
+    monkeypatch.setattr(H, "_engine_known", lambda: False)
+    for k in ("bionetgen", "perl", "fastapi", "plotly"):
+        monkeypatch.setitem(V.VERSIONS, k, "1.0")
+    monkeypatch.setitem(V.VERSIONS, "pybnf", "not installed")
+    monkeypatch.setitem(V.VERSIONS, "bngsim", "not installed")
+    html = client.get("/").text
+    card = html.split('class="card hm-setup"', 1)[1]
+    assert ">3 not installed<" in card
+    assert "FluSight hub, BioNetGen, Particle-filter engine" in card
+    # the most basic piece first: the hub and BioNetGen come from setup
+    fix = card.split('id="hm-fix"', 1)[1].split("</div>", 1)[0]
+    assert "To fetch the FluSight hub data and BioNetGen, run " \
+        "<code>./setup.sh</code>" in fix
+    rows = card.split('class="hm-missing"', 1)[1].split("</ul>", 1)[0]
+    assert rows.count("<li>") == 3
+    assert "<span>Particle-filter engine</span>" in rows
+    assert "fit_type" not in rows and "engine venv" not in rows
+    # HM-12: no pin note beside "not installed"
+    pin = card.split('id="home-pin"', 1)[1].split("</div>", 1)[0]
+    assert "Reproducing the sealed numbers" not in pin
+
+
+def test_with_only_the_hub_missing_the_card_says_how_to_fetch_it(
+        monkeypatch):
+    monkeypatch.setattr(fs, "check",
+                        lambda verbose=True: ENGINE_MISSING[:1])
+    for k in ("pybnf", "bngsim", "bionetgen", "perl", "fastapi", "plotly"):
+        monkeypatch.setitem(V.VERSIONS, k, "1.0")
+    fix = client.get("/").text.split('id="hm-fix"', 1)[1].split("</div>", 1)[0]
+    assert "To fetch the FluSight hub data, run <code>./setup.sh</code>" in fix
+
+
+# ----------------------------------------- HM-13: no verdict while checking
+
+def test_the_badge_says_checking_until_the_versions_land(monkeypatch):
+    monkeypatch.setattr(fs, "check", lambda verbose=True: [])
+    monkeypatch.setattr(H, "_engine_known", lambda: False)
+    for k in ("pybnf", "bngsim", "bionetgen", "perl", "fastapi", "plotly"):
+        monkeypatch.setitem(V.VERSIONS, k, V.VERSION_PENDING)
+    html = client.get("/").text
+    assert ">checking…<" in html and "All components installed" not in html
+    # once none is resolving, a different answer reloads the card whole
+    script = html.split("var PAINTED", 1)[1].split("</script>", 1)[0]
+    assert "location.reload()" in script and "PENDING" in script
+
+
+# ------------------------------------------------- HM-14: Perl's version
+
+def test_perl_reads_as_a_version_not_a_path():
+    perl = V._component_versions()["perl"]
+    assert "/" not in perl and "\\" not in perl
+    assert perl == "not installed" or perl == "installed" or \
+        perl[:1].isdigit()
