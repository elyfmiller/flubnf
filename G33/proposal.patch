+++ b/app/tests/test_models_polish.py
@@ -0,0 +1,76 @@
+"""Models and diagrams polish (model.html, diagrams.html).
+
+  * the empty Forecasts card says which run has none as one muted line,
+    never a "?": the page keeps one mark, the record's "i", with or
+    without a run;
+  * the chart library is loaded only when there is a fan to draw, and
+    deferred; the research view never loads it;
+  * the seasonal-forcing figure's reference lines are in the axis's units
+    (beta over beta-0): 1.0, e to the plus and minus epsilon-1.
+"""
+import sys
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.ui import shared as ui_shared                # noqa: E402
+from app.ui.server import app as srv                  # noqa: E402
+from app.tests.test_fewer_marks import marks          # noqa: E402
+from app.tests.test_models_tab import _run            # noqa: E402
+
+client = TestClient(srv)
+PLOTLY = '<script defer src="/static/plotly.min.js"></script>'
+CHARTS = '<script defer src="/static/charts.js"></script>'
+
+
+def test_the_empty_forecasts_card_says_which_run_in_one_muted_line(monkeypatch):
+    _run(monkeypatch, ["analogue"])
+    page = client.get("/models").text
+    card = page.split('id="mfan"', 1)[1].split("</div>\n", 1)[0]
+    assert "tip-md-nofc" not in page and "tipbtn" not in card
+    assert ('<div class="uk-empty-action"><span class="hint md-nofc-why">'
+            'The latest real-time run (2098-11-14 · 11-14 09:31:00) has '
+            'none from this model.</span></div>') in card
+    # the page keeps the record's "i" alone, as it does with no run
+    assert set(marks(page)) == {"tt-md-rec"}
+    monkeypatch.setattr(ui_shared, "_latest_results",
+                        lambda **kw: (None, None))
+    page = client.get("/models").text
+    assert "md-nofc-why" not in page and set(marks(page)) == {"tt-md-rec"}
+
+
+def test_the_chart_library_loads_deferred_and_only_for_a_fan(monkeypatch):
+    _run(monkeypatch, ["analogue"])
+    page = client.get("/model/analogue").text
+    head = page.split("</head>", 1)[0]
+    assert PLOTLY in head and CHARTS in head
+    assert '<script src="/static/plotly.min.js">' not in page
+    # the first draw waits for the deferred library
+    assert "addEventListener('DOMContentLoaded',()=>draw());" in page
+    assert "\n draw();" not in page
+    # the model the run has no fan for, and the research view: no library
+    for path in ("/models", "/model/pf2s"):
+        page = client.get(path).text
+        assert "plotly.min.js" not in page and "charts.js" not in page, path
+    monkeypatch.setattr(ui_shared, "_latest_results",
+                        lambda **kw: (None, None))
+    assert "plotly.min.js" not in client.get("/model/analogue").text
+
+
+def test_the_forcing_figures_reference_lines_are_in_the_axis_units():
+    page = client.get("/").text
+    fig = page.split('class="dg-harm"', 1)[1].split("</svg>", 1)[0]
+    assert "&#946;(t) / &#946;" in fig                 # the axis
+    assert 'fill="var(--mut)">1.0</text>' in fig
+    assert ('<text x="68" y="33">e<tspan class="svgt-sub" dy="-7">'
+            '+&#949;&#8321;</tspan></text>') in fig
+    assert ('<text x="68" y="164">e<tspan class="svgt-sub" dy="-7">'
+            '&#8722;&#949;&#8321;</tspan></text>') in fig
+    assert "&#183;&#8202;e" not in fig                 # no beta-0 times e
+    # Methods and the Models tab draw the same macro
+    for path in ("/methods", "/models", "/model/pf2s"):
+        t = client.get(path).text
+        assert "&#183;&#8202;e" not in t, path
+        assert 'fill="var(--mut)">1.0</text>' in t, path
