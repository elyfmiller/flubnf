+def _bng_error_line(log: str) -> str:
+    """BNG2.pl's ERROR line in a log (with the "at line N" BNG2.pl puts
+    under it), else its ABORT line, without the prefix; '' when neither."""
+    lines = [ln.strip() for ln in str(log).splitlines()]
+    for tag in ("ERROR:", "ABORT:"):
+        for i, ln in enumerate(lines):
+            if ln.startswith(tag):
+                said = ln[len(tag):].strip()
+                at = re.match(r"at line (\d+)", lines[i + 1]) \
+                    if i + 1 < len(lines) else None
+                return f"{said} (line {at.group(1)})" if at else said
+    return ""
+
