diff --git a/app/tests/test_chart_fixes.py b/app/tests/test_chart_fixes.py
new file mode 100644
index 0000000..13f1f1f
--- /dev/null
+++ b/app/tests/test_chart_fixes.py
@@ -0,0 +1,139 @@
+"""The console's charts (bug hunt 2026-10-25, G19).
+
+  * The Groundhog's gold is the report's darker one on a light card, on
+    the Forecast tab, the model pages and the season page.
+  * A chart toolbar's buttons wear the app's focus ring.
+  * On a phone's width the toolbar is not drawn over the chart's title.
+  * The fan's settled line stops at the last horizon.
+  * The Forecasts pager draws only the latest page asked for.
+  * A fan starts where the model did: a week the run set aside is drawn
+    apart, hollow, and the fan is anchored on the week before it.
+"""
+import json
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core.report_v2 import ANALOGUE_ON_LIGHT               # noqa: E402
+from app.core.runs import Ledger, RunSpec                      # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import shared as ui_shared                         # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui.routes import forecast as FC                       # noqa: E402
+
+client = TestClient(srv.app)
+UI = Path(__file__).resolve().parents[1] / "ui"
+FLAGS = {"analogue": [{"location": "Ohio", "week": "2026-10-24", "value": 2.0,
+                       "rule": "set aside (Forecast tab)"}], "pf": []}
+
+
+def _tpl(name: str) -> str:
+    return (UI / "templates" / name).read_text(encoding="utf-8")
+
+
+# ------------------------------------------- UI-03 (MO-10): the Groundhog's gold
+
+def test_the_groundhog_wears_the_reports_darker_gold_on_a_light_card():
+    assert ANALOGUE_ON_LIGHT == "#A87300"
+    for name in ("forecast.html", "model.html"):
+        t = _tpl(name)
+        assert "const ANALOGUE_LIGHT={{ analogue_on_light() | tojson }};" in t, name
+        assert ("if(m==='analogue'&&css('--scheme')==='light') return "
+                "ANALOGUE_LIGHT;") in t, name
+    season = _tpl("retro_season.html")
+    assert ("css('--scheme') === 'light'\n"
+            "                             ? {analogue: {{ analogue_on_light() | tojson }}} : {}"
+            ) in season
+    # the rendered pages carry the value
+    html = client.get("/forecast").text
+    assert f'const ANALOGUE_LIGHT="{ANALOGUE_ON_LIGHT}";' in html
+
+
+# ------------------------------------------- UI-04: the toolbar's focus ring
+
+def test_a_chart_toolbars_buttons_wear_the_apps_focus_ring():
+    css = (UI / "static" / "nau.css").read_text(encoding="utf-8")
+    rule = css.split(".js-plotly-plot .plotly .modebar .modebar-btn:focus-visible{", 1)[1] \
+              .split("}", 1)[0]
+    assert "outline:var(--focus-w,2px) solid var(--gold)" in rule
+    assert "outline-offset:2px" in rule
+
+
+# ------------------------------- FC-31 (UI-22): no toolbar on a phone's width
+
+def test_the_toolbar_stays_off_a_narrow_screen():
+    js = (UI / "static" / "charts.js").read_text(encoding="utf-8")
+    assert "matchMedia('(max-width: 599px)').matches" in js
+    conf = js.split("function conf(extra){", 1)[1].split("return c;", 1)[0]
+    assert "if(narrow()) c.displayModeBar = false;" in conf
+    # after the caller's own config, so a narrow screen always wins
+    assert conf.index("if(extra)") < conf.index("if(narrow())")
+
+
+# -------------------------------------- FC-24: the settled line's last week
+
+def test_the_settled_line_stops_at_the_last_horizon():
+    for name in ("forecast.html", "model.html"):
+        t = _tpl(name)
+        assert "getUTCDate()+35" not in t, name
+        assert "lim.setUTCDate(lim.getUTCDate()+7*Math.max(...hs.map(h=>parseInt(h))));" in t, name
+
+
+# ----------------------------------------- MO-09: the pager draws the latest
+
+def test_the_forecasts_pager_draws_only_the_page_last_asked_for():
+    t = _tpl("model.html")
+    draw = t.split("async function draw(){", 1)[1].split("FluCharts.react", 1)[0]
+    assert "const tok=++drawSeq;" in draw
+    assert draw.index("const tok=++drawSeq;") < draw.index("await fetch('/api/series")
+    assert draw.index("await fetch('/api/series") < draw.index("if(tok!==drawSeq) return;")
+    assert draw.index("if(tok!==drawSeq) return;") < draw.index("const traces=")
+
+
+# ------------------------------------- FC-14: the fan starts where the model did
+
+@pytest.fixture()
+def root(tmp_path, monkeypatch):
+    before = dict(ui_state._status)
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    for k in ("running", "workroot", "phase", "flash", "flash_kind",
+              "flash_detail"):
+        ui_state._status[k] = None
+    ui_shared._invalidate_scans()
+    yield tmp_path
+    ui_state._status.clear()
+    ui_state._status.update(before)
+    ui_shared._invalidate_scans()
+
+
+def test_the_forecast_page_carries_the_weeks_the_run_set_aside(root):
+    led = Ledger()
+    rid = led.open_run(RunSpec(engine="analogue", forecast_date="2026-10-24",
+                               locations=["Ohio"]), Path("pending"), {})
+    w = root / "workroots" / rid
+    w.mkdir(parents=True)
+    (w / "results.json").write_text(json.dumps(
+        {"forecast_date": "2026-10-24", "models": {}, "observed": {}}))
+    led.set_workroot(rid, w)
+    led.close_run(rid, "ok", {"data_flags": FLAGS})
+    ui_shared._invalidate_scans()
+    assert FC._run_flags(rid) == FLAGS
+    assert FC._run_flags(None) == {} and FC._run_flags("20980101T000000-aaaaaa") == {}
+    html = client.get("/forecast").text
+    assert 'const RFLAGS = {"analogue": [{"location": "Ohio", "week": "2026-10-24"' in html
+    # the fan: the set-aside weeks apart, the anchor on the week before them
+    fan = html.split("async function drawFan(", 1)[1].split("FluCharts.react(", 1)[0]
+    assert "const aside=new Set((RFLAGS[FMODEL]||[]).filter(f=>f.location===loc&&f.week)" in fan
+    assert "while(anc>0&&aside.has(obsX[anc])) anc--;" in fan
+    assert "const fx=[...ax,...xs];" in fan and "const med=[...ay," in fan
+    assert "name:'set aside (not used)'" in fan and "symbol:'circle-open'" in fan
+    assert "offTraces(loc, xs, ax, ay)" in fan
+    # a run without rules records no flags: the page carries none
+    led.close_run(rid, "ok", {})
+    ui_shared._invalidate_scans()
+    assert "const RFLAGS = {};" in client.get("/forecast").text
