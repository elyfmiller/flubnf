+def _run_flags(rid) -> dict:
+    """A run's data_flags from its ledger row ({member: [{location, week,
+    value, rule}]}); {} for no run, an older row or one without rules."""
+    if not rid:
+        return {}
+    try:
+        import json as _json
+        row = Ledger().row(rid) or {}
+        flags = _json.loads(row.get("outcome") or "{}").get("data_flags")
+        return flags if isinstance(flags, dict) else {}
+    except Exception:
+        return {}
+
+
