+def _sum_group(recs, names) -> str | None:
+    """The one group whose count is, on every week all groups report, the
+    sum of the others' (to rounding), or None: three groups at least, two
+    such weeks at least, the newest snapshot of each week."""
+    if len(names) < 3:
+        return None
+    newest = {}
+    for a, n, _, d, v, _ in recs:
+        if v is not None and ((n, d) not in newest
+                              or (a or date.min) >= newest[(n, d)][0]):
+            newest[(n, d)] = (a or date.min, float(v))
+    weeks: dict = {}
+    for (n, d), (_, v) in newest.items():
+        weeks.setdefault(d, {})[n] = v
+    full = [w for w in weeks.values() if len(w) == len(names)]
+    if len(full) < 2:
+        return None
+    hits = [g for g in names
+            if any(w[g] > 0 for w in full)
+            and all(abs(2 * w[g] - sum(w.values())) <= 0.5 for w in full)]
+    return hits[0] if len(hits) == 1 else None
+
+
 def is_national_name(name) -> bool:
     return str(name or "").strip().upper() in NATIONAL_NAMES
 
