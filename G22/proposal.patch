+async def _not_found_page(request: Request, exc):
+    """The app's HTTPException handler (server.py): a mistyped or stale
+    address opened in the window or a browser (it asks for HTML) gets this
+    notice with the way back to Home, never a bare line; a script's request
+    (/api/, /static/, any other Accept) and every other code keep FastAPI's
+    JSON."""
+    from fastapi.exception_handlers import http_exception_handler
+    if (exc.status_code == 404
+            and not request.url.path.startswith(("/api/", "/static/"))
+            and "text/html" in request.headers.get("accept", "")):
+        return _notice(request, 404, "empty", "No page at this address",
+                       action=("/", "Back to Home"), active="",
+                       heading="Not found")
+    return await http_exception_handler(request, exc)
+
+
