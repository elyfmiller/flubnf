diff --git a/app/tests/test_error_pages.py b/app/tests/test_error_pages.py
new file mode 100644
index 00000000..85ab32e8
--- /dev/null
+++ b/app/tests/test_error_pages.py
@@ -0,0 +1,90 @@
+"""Unknown pages and malformed requests (bug hunt 2026-10-25, G22).
+
+  * A mistyped or stale address opened in the window (it asks for HTML)
+    is a page of the console with the way back: any unknown path, an
+    unknown model, an unknown dataset replay, a season report that cannot
+    be built. A script's request keeps FastAPI's JSON.
+  * Output's downloads, reveal and report pages answer a missing path or
+    an impossible date with the console's notice, and the view of a
+    missing archive answers 404 as its download does.
+  * Opening a deleted Sandbox model says there is no such model.
+"""
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.ui import server as srv                               # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+
+client = TestClient(srv.app)
+PAGE = {"Accept": "text/html,application/xhtml+xml"}
+
+
+# ------------------------------- UI-10 (MO-11, WI-14): unknown addresses
+
+def test_an_unknown_page_opened_in_the_window_is_a_console_page():
+    r = client.get("/nope", headers=PAGE)
+    assert r.status_code == 404 and r.headers["content-type"].startswith(
+        "text/html")
+    assert "No page at this address" in r.text
+    assert 'href="/">Back to Home</a>' in r.text
+    assert "<title>FluBNF · Not found</title>" in r.text
+    # a script's request, and any /api/ path, keep FastAPI's JSON
+    assert client.get("/nope").json() == {"detail": "Not Found"}
+    assert client.get("/api/nope", headers=PAGE).json() == \
+        {"detail": "Not Found"}
+
+
+def test_an_unknown_model_or_replay_address_is_a_console_page():
+    r = client.get("/model/nope", headers=PAGE)
+    assert r.status_code == 404 and "No model named nope" in r.text
+    assert 'href="/models">Open Models</a>' in r.text
+    r = client.get("/retro/dataset/nope/20260101T000000Z", headers=PAGE)
+    assert r.status_code == 404 and "No such replay" in r.text
+    assert 'href="/retro">Open Retrospective</a>' in r.text
+
+
+def test_a_season_report_that_cannot_be_built_is_a_console_page():
+    r = client.get("/retro/2098-99/report", headers=PAGE)
+    assert r.status_code == 404
+    assert "2098-99: no completed weeks yet" in r.text
+    assert 'href="/retro/2098-99">Back to the season</a>' in r.text
+
+
+# ------------------------------------ OU-16: malformed Output requests
+
+def test_malformed_output_requests_get_the_console_notice(tmp_path,
+                                                          monkeypatch):
+    import app.core.runs as runs_mod
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    r = client.get("/output/download", headers=PAGE)
+    assert r.status_code == 404 and "File not found in app state" in r.text
+    monkeypatch.setattr(subprocess, "Popen", lambda *a, **kw: None)
+    monkeypatch.setitem(ui_state._status, "flash", None)
+    r = client.post("/output/reveal", follow_redirects=False)
+    assert r.status_code == 303
+    assert "not in app state" in (ui_state._status.get("flash") or "")
+    # a date with the shape and no such day is refused as invalid
+    r = client.get("/output/report?date=2026-13-45")
+    assert r.status_code == 400 and "Invalid date" in r.text
+    # a missing archive: the view and the download agree
+    assert client.get("/output/report?date=2098-01-03").status_code == 404
+    assert client.get(
+        "/output/report/download?date=2098-01-03").status_code == 404
+
+
+# ----------------------------------------- SB-16: a deleted Sandbox model
+
+def test_opening_a_deleted_sandbox_model_says_it_is_not_there(sandbox_root):
+    from app.core import sandbox as sb
+    with pytest.raises(sb.SandboxError,
+                       match="no sandbox model named del_me"):
+        sb.model_dir("del_me")
+    page = client.get("/sandbox?model=del_me").text
+    assert "Not opened: no sandbox model named del_me" in page
+    assert "is missing" not in page
