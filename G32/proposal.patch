+  var due=[],els=document.querySelectorAll('[data-out-due]');
+  for(var i=0;i<els.length;i++){
+   var t=new Date(els[i].getAttribute('data-out-due')),b=els[i].querySelector('.uk-badge');
+   if(isNaN(t.getTime())||!b)continue;
+   var w=b.querySelector('.uk-badge-t'),base=(w?w.textContent:'').split(' · ')[0];
+   due.push({at:t.getTime(),badge:b,base:base});
+  }
+  if(!due.length)return;
+  function left(ms){
+   var s=Math.floor(ms/1000),d=Math.floor(s/86400),h=Math.floor(s%86400/3600),m=Math.floor(s%3600/60);
+   if(d)return d+' day'+(d!==1?'s':'')+(h?' '+h+' h':'')+' left';
+   if(h)return h+' h left';
+   return Math.max(1,m)+' min left';
+  }
+  function tick(){
+   clearTimeout(T);
+   if(!window.FluBNFUI){T=setTimeout(tick,1000);return;}
+   var now=Date.now(),past=false;
+   for(var i=0;i<due.length;i++){
+    var ms=due[i].at-now;
+    if(ms<=0){past=true;continue;}
+    window.FluBNFUI.setBadge(due[i].badge,ms<URGENT_H*3600000?'error':'warn',due[i].base+' · '+left(ms));
+   }
+   if(past){
+    if(window.GUARD_BUSY||(document.activeElement&&document.activeElement.form)){T=setTimeout(tick,30000);return;}
+    location.reload();return;
+   }
+   T=setTimeout(tick,30000);
+  }
+  addEventListener('pageshow',tick);
+  addEventListener('focus',tick);
+  document.addEventListener('visibilitychange',function(){if(!document.hidden)tick();});
+  // tips.js (setBadge) is deferred: the first tick waits for it
+  document.addEventListener('DOMContentLoaded',tick);
+ })();
