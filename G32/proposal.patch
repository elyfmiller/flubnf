+#: (path, mtime_ns, size) -> hubcheck.summary; a file is checked once per
+#: version. The results are kept in the state folder (CHECKS_FILE), so a
+#: launch lists the files it checked last time without checking them
+#: again (a check reads the whole file: about a tenth of a second each)
 _CHECKED: dict = {}
+CHECKS_FILE = "hub-checks.json"
+_CHECKS_READ = False
+
+
+def _checks_path() -> Path:
+    from app.core.runs import APP_STATE
+    return APP_STATE / CHECKS_FILE
+
+
+def _read_checks() -> None:
+    """The checks kept on disk into _CHECKED, once per process; a file
+    that is missing or unreadable starts it empty."""
+    global _CHECKS_READ
+    import json as _json
+    from app.core import hubcheck
+    if _CHECKS_READ:
+        return
+    _CHECKS_READ = True
+    try:
+        kept = _json.loads(_checks_path().read_text(encoding="utf-8"))
+        for path, e in kept.items():
+            s = dict(e["summary"])
+            ref = s.get("reference_date", "")
+            s["due"] = hubcheck.submission_window(ref) if s["round"] else None
+            _CHECKED[(path, int(e["mtime_ns"]), int(e["size"]))] = s
+    except Exception:
+        _CHECKED.clear()
+
+
+def _write_checks() -> None:
+    """_CHECKED to disk (whole file, atomic); a folder that cannot be
+    written keeps the checks for this process only."""
+    import json as _json
+    import os
+    kept = {path: {"mtime_ns": m, "size": n,
+                   "summary": {k: v for k, v in s.items() if k != "due"}}
+            for (path, m, n), s in _CHECKED.items()}
+    p = _checks_path()
+    try:
+        p.parent.mkdir(parents=True, exist_ok=True)
+        tmp = p.with_name(p.name + ".tmp")
+        tmp.write_text(_json.dumps(kept), encoding="utf-8")
+        os.replace(tmp, p)
+    except OSError:
+        pass
 
 
 def _check_summary(path: str) -> dict:
     """hubcheck.summary of one file, cached per file version."""
     from app.core import hubcheck
+    _read_checks()
     try:
         st = Path(path).stat()
         key = (str(path), st.st_mtime_ns, st.st_size)
@@ -365,7 +414,11 @@ def _check_summary(path: str) -> dict:
         if key:
             if len(_CHECKED) > 512:
                 _CHECKED.clear()
+            # one version per path: a rewritten file replaces its entry
+            for k in [k for k in _CHECKED if k[0] == key[0]]:
+                del _CHECKED[k]
             _CHECKED[key] = s
+            _write_checks()
     return s
 
 
