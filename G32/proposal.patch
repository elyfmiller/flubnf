+ // a page left open keeps a due round's time left to the minute, and
+ // reloads once when a badge changes (the window opens, its last 12
+ // hours, it closes: the badge and the primary Download follow). Each
+ // change reloads at most once, so a clock ahead of the server's cannot
+ // loop; the reload waits while a form has focus or the guard modal is open
+ (function(){
+  var lefts=document.querySelectorAll('[data-out-left]'),flips=[];
+  document.querySelectorAll('[data-out-flips]').forEach(function(e){
+   e.getAttribute('data-out-flips').split(' ').forEach(function(s){var t=Date.parse(s);if(!isNaN(t))flips.push(s);});
+  });
+  if(!lefts.length&&!flips.length)return;
+  function left(ms){
+   var s=Math.floor(ms/1000),d,h;
+   if(s<=0)return '';
+   d=Math.floor(s/86400);h=Math.floor(s%86400/3600);
+   if(d)return d+(d===1?' day':' days')+(h?' '+h+' h':'')+' left';
+   if(h)return h+' h left';
+   return Math.max(1,Math.floor(s%3600/60))+' min left';
+  }
+  function done(s){try{return sessionStorage.getItem('out-flip '+s)==='1';}catch(e){return false;}}
+  function tick(){
+   var now=Date.now(),i,t,s;
+   for(i=0;i<lefts.length;i++){
+    t=Date.parse(lefts[i].getAttribute('data-out-left'));
+    s=isNaN(t)?'':left(t-now);
+    if(s)lefts[i].textContent=s;
+   }
+   for(i=0;i<flips.length;i++){
+    if(Date.parse(flips[i])>now||done(flips[i]))continue;
+    if(window.GUARD_BUSY||(document.activeElement&&document.activeElement.form))return;
+    try{sessionStorage.setItem('out-flip '+flips[i],'1');}catch(e){return;}
+    location.reload();return;
+   }
+  }
+  setInterval(tick,60000);
+  addEventListener('focus',tick);
+  document.addEventListener('visibilitychange',function(){if(!document.hidden)tick();});
+ })();
 </script>
