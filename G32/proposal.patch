+"""Output polish (routes/output.py, output.html, _filerow.html, _tips.html).
+
+  * a file's hub checks are kept on disk (hub-checks.json in the state
+    folder), so the first Output visit after a launch lists the files it
+    checked last time without checking each again;
+  * the title's "i" is three lines and points to Methods; a line's
+    "fails hub checks" opens the same panel a card's does; the Your data
+    note is one line;
+  * Download and Show in folder name their file;
+  * an open round's badge counts down while the page stays open and the
+    page reloads once the round has closed;
+  * a notice's "?" keeps names as written (only the first letter is
+    lowercased).
+"""
+import datetime as dt
+import json
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core import hubcheck                                  # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import shared as ui_shared                         # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui.routes import output as O                          # noqa: E402
+from app.ui.templating import templates                        # noqa: E402
+from app.tests.test_output_by_date import GH, _run             # noqa: E402
+
+client = TestClient(srv.app)
+NODE = shutil.which("node")
+ENV = templates.env
+
+
+@pytest.fixture()
+def root(tmp_path, monkeypatch):
+    before = dict(ui_state._status)
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    ui_state._status["running"] = None
+    ui_shared._invalidate_scans()
+    O._CHECKED.clear()
+    O._CHECKS_READ = False
+    yield tmp_path
+    ui_state._status.clear()
+    ui_state._status.update(before)
+    ui_shared._invalidate_scans()
+    O._CHECKED.clear()
+    O._CHECKS_READ = False
+
+
+# ------------------------------------------------- OU-07: checks kept on disk
+
+def test_hub_checks_are_kept_on_disk_between_launches(root, monkeypatch):
+    f = root / "sub" / GH / f"2098-01-10-{GH}.csv"
+    f.parent.mkdir(parents=True)
+    f.write_text("reference_date,value\n2098-01-10,1\n")
+    first = O._check_summary(str(f))
+    assert first["ok"] is False and first["problems"]
+    kept = json.loads((root / O.CHECKS_FILE).read_text(encoding="utf-8"))
+    assert list(kept) == [str(f)]
+    assert kept[str(f)]["summary"]["problems"] == first["problems"]
+    # a new process reads the file instead of checking again
+    O._CHECKED.clear()
+    O._CHECKS_READ = False
+    monkeypatch.setattr(hubcheck, "summary",
+                        lambda p: pytest.fail("checked again"))
+    again = O._check_summary(str(f))
+    assert again["problems"] == first["problems"]
+    assert again["ok"] is False and again["due"] is None
+    # a rewritten file is checked afresh, and replaces its entry
+    monkeypatch.setattr(hubcheck, "summary", lambda p: {
+        "ok": True, "round": False, "problems": [], "reference_date": "",
+        "due": None})
+    f.write_text("reference_date,value\n2098-01-10,1\n2098-01-10,2\n")
+    assert O._check_summary(str(f))["ok"] is True
+    kept = json.loads((root / O.CHECKS_FILE).read_text(encoding="utf-8"))
+    assert list(kept) == [str(f)] and kept[str(f)]["summary"]["ok"] is True
+
+
+def test_a_checks_file_that_cannot_be_read_starts_empty(root, monkeypatch):
+    (root / O.CHECKS_FILE).write_text("{not json")
+    f = root / f"2098-01-10-{GH}.csv"
+    f.write_text("x")
+    monkeypatch.setattr(hubcheck, "summary", lambda p: {
+        "ok": False, "round": False, "problems": ["unreadable: x"],
+        "reference_date": "", "due": None})
+    assert O._check_summary(str(f))["problems"] == ["unreadable: x"]
+    assert json.loads((root / O.CHECKS_FILE).read_text(encoding="utf-8"))
+
+
+# ------------------------------------------- OU-10: the marks and their words
+
+def test_the_title_help_is_three_lines_and_points_to_methods(root):
+    _run(root, "2098-01-03", [GH])
+    page = client.get("/output").text
+    about = page.split('id="tt-out-files"', 1)[1].split("</span></span>", 1)[0]
+    lines = re.findall(r'<span class="uk-tt-line">', about)
+    assert len(lines) == 3
+    assert '<a href="/methods#mt-files">' in about
+    for gone in ("retired hub names", "validate_submission.R",
+                 "monotone quantiles"):
+        assert gone not in about
+    # the rest is on Methods, under the fold the link names
+    methods = client.get("/methods").text
+    fold = methods.split('id="mt-files"', 1)[1].split("</details>", 1)[0]
+    for kept in ("retired hub names", "scripts/validate_submission.R",
+                 "newest complete run on all 53 locations"):
+        assert kept in fold
+
+
+def test_a_lines_failing_checks_open_the_same_panel_as_a_cards(root, monkeypatch):
+    monkeypatch.setattr(O, "_check_summary", lambda p: {
+        "ok": False, "round": True, "problems": ["colnames: no value"],
+        "reference_date": "2098-01-10", "due": None})
+    _run(root, "2098-01-03", [GH])
+    _run(root, "2098-01-10", [GH])
+    page = client.get("/output").text
+    line = page.split('<div class="out-line"', 1)[1].split("</div>", 1)[0]
+    assert 'aria-controls="tt-out-lchk-2"' in line
+    assert "tip-out-lchk-" not in page
+    assert '<strong class="uk-tt-title">Fails hub checks</strong>' in line
+    assert f'<span class="uk-tt-line">2098-01-10-{GH}.csv: Fails 1 hub check: colnames: no value.</span>' in line
+
+
+def test_the_your_data_note_is_one_line(root):
+    _run(root, "2098-01-03", [GH], dataset="Clinics")
+    page = client.get("/output").text
+    tip = page.split('id="tip-out-own"', 1)[1].split("</span>", 1)[0]
+    assert "hubverse-format" not in tip and "23 levels" not in tip
+    assert "Downloads work on this computer only" in tip
+
+
+# ----------------------------------------- OU-13: the controls name their file
+
+def test_download_and_show_in_folder_name_their_file(root):
+    _run(root, "2098-01-03", [GH])
+    page = client.get("/output").text
+    name = f"2098-01-10-{GH}.csv"
+    assert f'download="{name}" aria-label="Download {name}">' in page
+    assert f'<button class="quiet" type="submit" aria-label="Show {name} in folder">' in page
+
+
+# ------------------------------------------------ OU-14: the badge counts down
+
+_HARNESS = """
+var said=[], timers=[], on={}, don={}, NOW=%d;
+var location={reload:function(){said.push('reload');}};
+var window={GUARD_BUSY:false};
+var Date={now:function(){return NOW;}};
+function _Date(s){this.t=%d;this.getTime=function(){return this.t;};}
+var badge={state:'warn', words:{textContent:'Due Wed 2098-01-07, 11 PM ET · 2 days 1 h left'},
+  querySelector:function(){return this.words;}};
+var el={getAttribute:function(){return '2098-01-08T04:00:00Z';},
+  querySelector:function(){return badge;}};
+var document={hidden:false, activeElement:null,
+  querySelectorAll:function(){return [el];},
+  addEventListener:function(n,f){don[n]=f;}};
+function addEventListener(n,f){on[n]=f;}
+function setTimeout(f,ms){timers.push([f,ms]);return timers.length;}
+function clearTimeout(){}
+window.FluBNFUI={setBadge:function(b,state,text){said.push(state+' | '+text);}};
+function tick(){var t=timers.shift();if(t)t[0]();}
+"""
+
+
+def _countdown(html: str) -> str:
+    s = html.split("// an open round's badge", 1)[1]
+    return s[s.index("(function(){"):s.index("\n })();") + len("\n })();")]
+
+
+def _js(script: str, now: int, steps: str) -> list:
+    """Run the countdown script against a stand-in page (node), with
+    `new Date(...)` reading the close as 2098-01-08T04:00:00Z; what it
+    said to the badge and whether it reloaded, in order."""
+    close = 4039416000000       # 2098-01-08T04:00:00Z in ms
+    src = script.replace("new Date(", "new _Date(")
+    prog = (_HARNESS % (now, close) + src + "\n" + steps
+            + "\nconsole.log(JSON.stringify(said));")
+    out = subprocess.run([NODE, "-e", prog], capture_output=True, text=True,
+                         timeout=60)
+    assert out.returncode == 0, out.stderr
+    return json.loads(out.stdout.strip().splitlines()[-1])
+
+
+def test_the_due_badge_carries_its_close_for_the_page_script(root, monkeypatch):
+    _run(root, "2098-01-03", [GH])
+    real = O._date_status
+    monkeypatch.setattr(O, "_date_status", lambda ref, **k: real(
+        "2026-10-10", today=dt.date(2026, 10, 6)))
+    page = client.get("/output").text
+    card = page.split('id="fc-2098-01-03"', 1)[1]
+    assert '<span class="out-bt" data-out-due="2026-10-08T03:00:00Z">' in card
+    assert "var URGENT_H=12," in page
+    # a closed round's badge carries nothing
+    monkeypatch.setattr(O, "_date_status", lambda ref, **k: real(
+        "2026-10-10", today=dt.date(2026, 10, 8)))
+    assert 'data-out-due="' not in client.get("/output").text
+
+
+@pytest.mark.skipif(not NODE, reason="no node")
+def test_the_badge_counts_down_and_the_page_reloads_once_closed(root, monkeypatch):
+    _run(root, "2098-01-03", [GH])
+    real = O._date_status
+    monkeypatch.setattr(O, "_date_status", lambda ref, **k: real(
+        "2026-10-10", today=dt.date(2026, 10, 6)))
+    js = _countdown(client.get("/output").text)
+    close = 4039416000000
+    day, hour = 86400000, 3600000
+    base = "Due Wed 2098-01-07, 11 PM ET · "
+    # the first tick waits for the deferred kit script, then says the time
+    # left in the route's words, and under 12 hours the badge turns error
+    assert _js(js, close - 2 * day - hour, "don.DOMContentLoaded();") == [
+        "warn | " + base + "2 days 1 h left"]
+    assert _js(js, close - 5 * hour - 30 * 60000, "on.focus();") == [
+        "error | " + base + "5 h left"]
+    assert _js(js, close - 7 * 60000, "on.pageshow();") == [
+        "error | " + base + "7 min left"]
+    # the badge is looked at again every 30 seconds while the page is open
+    assert _js(js, close - day, "on.focus();NOW+=" + str(2 * hour)
+               + ";tick();") == ["warn | " + base + "1 day left",
+                                 "warn | " + base + "22 h left"]
+    # closed: the page reloads, unless a form has focus or the guard is up
+    assert _js(js, close + 1000, "on.focus();") == ["reload"]
+    assert _js(js, close + 1000, "document.activeElement={form:{}};"
+               "on.focus();document.activeElement=null;tick();") == ["reload"]
+    assert _js(js, close + 1000, "window.GUARD_BUSY=true;on.focus();") == []
+    # the kit script not loaded yet: the tick waits for it
+    assert _js(js, close - day, "window.FluBNFUI=null;on.focus();") == []
+
+
+# ----------------------------------------- OU-17: a notice's "?" keeps names
+
+def test_a_notices_question_mark_keeps_names_as_written():
+    tips = ENV.get_template("_tips.html").module
+    html = tips.empty("No run 20261025T184517-9a04d9 is recorded here",
+                      "folder", tiptext="why", id="out-notice")
+    assert 'aria-label="About no run 20261025T184517-9a04d9 is recorded here"' in html
+    html = tips.alert("warn", "No data for Arizona.", tiptext="why", id="x")
+    assert 'aria-label="About no data for Arizona"' in html
+    # a title that starts lower-case, or an empty one, reads as before
+    assert 'aria-label="About no runs yet"' in tips.empty(
+        "No runs yet", "clock", tiptext="why")
+    assert 'aria-label="About a run is in progress"' in tips.alert(
+        "warn", "A run is in progress.", tiptext="why")
