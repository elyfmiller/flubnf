#!/usr/bin/env bash
# Run the suite as CI does (no hub, no engine) before a push to main: passing
# with the lab's hub present is not the CI contract. Bypass: --no-verify.
set -u
# Load-bearing: without pipefail `pytest | tail` returns tail's 0 and every push passes.
set -o pipefail
repo="$(git rev-parse --show-toplevel)"
py="$repo/.venv/bin/python"
[ -x "$py" ] || { echo "pre-push: no .venv python; skipping"; exit 0; }
while read -r _local _lsha remote_ref _rsha; do
  case "$remote_ref" in */main) ;; *) continue ;; esac
  echo "pre-push: running the suite under CI conditions (FLUBNF_HUB=/nonexistent)…"
  if ! FLUBNF_HUB=/nonexistent "$py" -m pytest "$repo/tests" "$repo/app/tests" \
       -q -o addopts="" 2>&1 | tail -20; then
    echo "pre-push: SUITE FAILED under CI conditions: push refused."
    echo "          fix, or push with --no-verify if you know why."
    exit 1
  fi
done
exit 0
