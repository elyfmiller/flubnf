+ // the scrubber's month labels: one that would print over the label
+ // before it is hidden (months a week apart, a narrow track); the last
+ // label wins over its neighbour
+ function tickLabels(){
+   const ls = [].slice.call(document.querySelectorAll('.rt-ticks > span'));
+   let prev = null;
+   ls.forEach(s => { s.style.visibility = ''; });
+   ls.forEach((s, i) => {
+     const b = s.getBoundingClientRect();
+     if(prev && b.left < prev.getBoundingClientRect().right + 4){
+       if(i === ls.length - 1){ prev.style.visibility = 'hidden'; prev = s; }
+       else s.style.visibility = 'hidden';
+       return;
+     }
+     prev = s;
+   });
+ }
+ tickLabels();
+ let tickT = null;
+ addEventListener('resize', () => {clearTimeout(tickT); tickT = setTimeout(tickLabels, 150);});
+ addEventListener('fontsizechange', tickLabels);
  let cumT = null;
  addEventListener('resize', () => {clearTimeout(cumT); cumT = setTimeout(cumLabels, 150);});
