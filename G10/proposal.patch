+def no_baseline_round(asof: str) -> bool:
+    """Whether a clone that holds the FluSight baseline has no round for
+    this week: none of its cells can ever score, however settled the truth
+    (the player's week cells say so instead of 'pending'). False without
+    the baseline folder: then nothing is known about rounds, and the
+    season says scoring failed."""
