diff --git a/app/tests/test_oracle_text_pages.py b/app/tests/test_oracle_text_pages.py
new file mode 100644
index 0000000..e4932e0
--- /dev/null
+++ b/app/tests/test_oracle_text_pages.py
@@ -0,0 +1,65 @@
+"""The Oracle SIHRS text on Methods, the model pages and the settings
+reference describes what runs and what was submitted (bug hunt 2026-10-25,
+G12: ME-03, ME-12, ME-15, ME-20, MO-13, ME-24)."""
+from fastapi.testclient import TestClient
+
+from app.core import knobs as K
+from app.ui.server import app
+
+client = TestClient(app)
+
+
+def _flat(t: str) -> str:
+    return " ".join(t.replace("&#39;", "'").split())
+
+
+def test_methods_says_the_blend_weight_submitted_since_2026_10_17():
+    """Card 1.4 and the Submission lane's decision of 2026-10-12: the code
+    default stays one half; the rounds submitted since 2026-10-17 put one
+    quarter on the filter's growth, recorded with each run."""
+    t = _flat(client.get("/methods").text)
+    assert ("one quarter on the filter in the rounds submitted since "
+            "2026-10-17") in t
+    assert ("half and half by default, and one quarter on the filter's "
+            "growth in the rounds submitted since 2026-10-17, each run "
+            "recording the weight it used") in t
+    assert "<i>w</i> ln <i>G</i><sub><i>T</i></sub>" in t
+    assert "at half weight" not in t and "half filter growth" not in t
+    # the bank's own half-and-half (two donor streams) is a different fact
+    assert "mixed half and half" in t
+    assert K.BY_KEY["oracle.w"].default == 0.5
+
+
+def test_the_narrowing_note_names_the_member_its_screen_used():
+    note = K.BY_KEY["oracle.narrow"].note
+    assert "blend weight 0.25; 9,152 cells" in note
+    assert "not the record's default blend" in note
+    assert "took its pooled relWIS from 0.720 to 0.671" in note
+
+
+def test_the_donor_floor_note_matches_the_pool_fold():
+    t = _flat(client.get("/methods").text)
+    assert ("A week where neither stream supplies 30 donor paths leaves the "
+            "filter unchanged; where only one does, that stream supplies "
+            "every donor.") in t
+    assert "30 paths per stream" not in t
+    assert "30 paths per stream" not in _flat(client.get("/models").text)
+
+
+def test_the_oracle_step_group_says_a_console_run_refits():
+    tip = dict((g[0], g[2]) for g in K.PANEL_GROUPS)["step"]
+    assert "a replay reuses its fitted weeks, a console run fits again" in tip
+    assert "costs no refit" not in tip
+
+
+def test_the_oracle_record_names_its_cell_rule_like_the_groundhogs():
+    from app.ui.routes.models import _record
+    assert "under the earlier cell rule" in _record("pf")["lines"][0]
+    assert "FluSight's cell rule" in _record("analogue")["lines"][0]
+
+
+def test_the_two_strain_fold_no_longer_calls_its_linked_page_hidden():
+    t = _flat(client.get("/methods").text)
+    assert "reachable by URL" not in t
+    assert ('it stays a research run, on the <a href="/model/pf2s">'
+            "two-strain model page</a>.") in t
