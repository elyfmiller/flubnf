diff --git a/app/tests/test_phone_tables.py b/app/tests/test_phone_tables.py
new file mode 100644
index 0000000..c6756db
--- /dev/null
+++ b/app/tests/test_phone_tables.py
@@ -0,0 +1,102 @@
+"""Phone width: tables, drawings and folds (bug hunt 2026-10-25, G20).
+
+The rules each fix rests on; the browser measurements are in the pull
+request. Home's pipeline and performance table scroll inside the card with
+the figures' cue; Methods' settings and variables tables stack a row at a
+time; the Oracle record keeps its seasons whole; a key-value list cannot
+starve its values; a fold's title wraps beside its chevron; the harmonic
+scrolls and the two-strain math keeps its pieces whole; a long dataset
+name wraps and its actions keep their line; the datasets table scrolls
+inside its card.
+"""
+import re
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+UI = Path(__file__).resolve().parents[2] / "app" / "ui"
+NAU = (UI / "static" / "nau.css").read_text(encoding="utf-8")
+KIT = (UI / "static" / "ui-kit.css").read_text(encoding="utf-8")
+METHODS_CSS = (UI / "static" / "tabs" / "methods.css").read_text(encoding="utf-8")
+
+
+def _tpl(name: str) -> str:
+    return (UI / "templates" / name).read_text(encoding="utf-8")
+
+
+def _media(css: str, head: str) -> str:
+    """The body of the first @media block whose rules start with `head`."""
+    i = css.index(head)
+    return css[css.rindex("@media", 0, i):css.index("\n}", i)]
+
+
+# ------------------------------------------------ HM-06, HM-09: Home's cards
+
+def test_homes_pipeline_and_performance_table_scroll_with_the_cue():
+    home = _tpl("home.html")
+    assert ('<div class="pipe figscroll" tabindex="0" role="region" '
+            'aria-label="How it works (scrolls)">') in home
+    assert ('<div class="figscroll" tabindex="0" role="region" '
+            'aria-label="Measured performance (scrolls)"><table class="perf">'
+            ) in home
+    # the cue: the figures' shadow pair, under 640px
+    assert re.search(r"\.figscroll,\.sbscroll\{background:", NAU)
+
+
+# --------------------------------------------- ME-06: the settings tables
+
+def test_the_settings_tables_stack_a_row_at_a_time_on_a_phone():
+    block = _media(METHODS_CSS, ".mt-settings{min-width:0}")
+    assert "@media(max-width:40rem)" in block
+    for rule in (".mt-settings thead{display:none}",
+                 ".mt-settings tbody th,.mt-settings td:nth-child(2){flex-basis:100%}",
+                 'content:attr(data-label) ": "'):
+        assert rule in block, rule
+    assert ('<td data-label="Range">{{ r.range }}</td>'
+            '<td data-label="Default">{{ r.default }}</td>') in _tpl("methods.html")
+
+
+# ------------------------------------------- ME-07 (MO-19): the variables
+
+def test_the_variables_tables_put_the_symbol_beside_its_rows_on_a_phone():
+    block = _media(NAU, ".eqvars-t thead{display:none}")
+    assert "grid-template-columns:auto minmax(0,1fr)" in block
+    assert ".eqvars-t tbody th{grid-row:span 3" in block
+
+
+# ------------------------------------------------ ME-08: the Oracle record
+
+def test_the_oracle_record_keeps_its_seasons_whole():
+    methods = _tpl("methods.html")
+    assert '<table class="mt-rec">' in methods
+    assert '<td>{{ label | replace("-", "‑") }}</td>' in methods
+    assert ".mt-doc .mt-rec th.num{white-space:normal}" in METHODS_CSS
+
+
+# ------------------------------------------ ME-09, ME-10: the kit's lists
+
+def test_a_label_cannot_starve_its_value_and_a_fold_title_wraps_beside():
+    assert ".uk-stats--kv{grid-template-columns:fit-content(40%) minmax(0,1fr);" in KIT
+    assert ".uk-fold-sum{flex:1 1 0;min-width:0;overflow-wrap:anywhere}" in KIT
+
+
+# ------------------------------------------- MO-23: the harmonic, the math
+
+def test_the_harmonic_scrolls_and_the_two_strain_math_stays_whole():
+    dg = _tpl("diagrams.html")
+    h = dg[dg.index("{% macro harmonic("):]
+    assert h.index('<div class="figscroll"') < h.index("<svg viewBox")
+    assert '<span class="nw"><i>s</i> &#8712; {A, B}</span>' in dg
+    assert ('<span class="nw">share&#8202;A&#8202;/&#8202;(A&#8202;+&#8202;B)'
+            '&#8239;)</span>') in dg
+
+
+# ------------------------------------------- DA-10, DA-11: your datasets
+
+def test_a_long_dataset_name_wraps_and_the_table_scrolls_in_its_card():
+    assert (".dstable td.dsname,#browser .uk-heading h2"
+            "{overflow-wrap:anywhere}") in NAU
+    assert ".dstable td.dsactions .dt-rowacts{flex-wrap:nowrap}" in NAU
+    assert ("#datasets .tablewrap{max-width:100%;overflow-x:auto;"
+            "position:relative}") in NAU
