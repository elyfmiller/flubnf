+def test_stop_run_reaches_a_dataset_replay(monkeypatch):
+    """The Forecast tab's Stop run (and the guard's) during a dataset replay
+    raises the replay's own flag, which it reads between weeks; it once set
+    a flag nothing read, and the replay ran to its end."""
+    from app.core import custom_retro as CX
+    ds = stored()
+    stamp = CX.new_stamp(ds)
+    out = CX.replay_dir(ds, stamp)
+    out.mkdir(parents=True, exist_ok=True)
+    DU._REPLAY.update({"id": ds.id, "stamp": stamp})
+    ui_state._status.update({"running": f"dataset-replay:{stamp}",
+                             "workroot": None, "phase": "replayed x (3 of 9 weeks)"})
+    try:
+        r = client.post("/run/stop", follow_redirects=False)
+        assert r.status_code == 303
+        assert (out / "STOP").exists()
+        assert ui_state._status["phase"] == "stopping…"
+    finally:
+        DU._REPLAY.clear()
+        ui_state._status.update({"running": None, "phase": ""})
+
+
+def test_a_dataset_under_replay_is_busy_with_the_replay():
+    """A replay sets the running claim and the dataset id too: the reason
+    for a refused delete names the replay, not 'a run'."""
+    ds = stored()
+    DU._REPLAY.update({"id": ds.id, "stamp": "20260101T000000Z"})
+    ui_state._status.update({"running": "dataset-replay:20260101T000000Z",
+                             "dataset_id": ds.id})
+    try:
+        assert DU.busy_with(ds.id) == "a replay on it is in progress"
+        r = client.post(f"/data/datasets/{ds.id}/delete", follow_redirects=False)
+        assert r.status_code == 303
+        assert "a replay on it is in progress" in ui_state._status.get("flash", "")
+    finally:
+        DU._REPLAY.clear()
+        ui_state._status.update({"running": None, "dataset_id": None})
+
+
