diff --git a/app/tests/test_data_page_fixes.py b/app/tests/test_data_page_fixes.py
new file mode 100644
index 00000000..e2bfd1ff
--- /dev/null
+++ b/app/tests/test_data_page_fixes.py
@@ -0,0 +1,122 @@
+"""The Data page's behavior (bug hunt 2026-10-25, G24).
+
+  * Storing or deleting a dataset lands on the notice that says so (#main,
+    where the flash is), and its warnings are counted in words.
+  * Missing comparators say what adds them, make Update data the next
+    step, and the pull says it added them.
+  * When the live target file holds a week the archive does not yet, the
+    vintage browser lists it and opens on it.
+  * A season keeps one colour on the page: the Archive strip and the
+    season-over-season chart read one map.
+  * A snapshot dataset's chart title names the snapshot.
+"""
+import re
+from datetime import date
+
+from app.core import data as data_mod
+from app.ui import state as ui_state
+from app.ui.routes import data as ui_data
+from test_data_view import V2, archive                     # noqa: F401
+from test_datasets_ui import client, isolated, stored        # noqa: F401
+from test_dataset_engines import grouped_bytes              # noqa: E402
+
+
+# ---------------------------------- DA-04: the notice is where the page lands
+
+def test_store_and_delete_land_on_their_notice():
+    raw = grouped_bytes(groups=("Pediatric", "Adult"),
+                        end=date(2023, 12, 2)).decode().replace(
+        "Pediatric", "Niños").encode("cp1252")
+    r = client.post("/data/datasets",
+                    files={"file": ("cp.csv", raw, "text/csv")},
+                    data={"name": "cp", "next": "data"},
+                    follow_redirects=False)
+    assert r.status_code == 303 and r.headers["location"].endswith("#main")
+    assert ui_state._status["flash"].endswith(" 1 warning.")
+    ds_id = r.headers["location"].split("source=", 1)[1].split("#", 1)[0]
+    ui_state._status["flash"] = None            # the page would show it
+    r = client.post(f"/data/datasets/{ds_id}/delete", data={"confirm": "cp"},
+                    follow_redirects=False)
+    assert r.headers["location"] == "/data#main"
+    assert ui_state._status["flash"].startswith("Deleted cp")
+
+
+# ------------------------------------- DA-05: comparators and their remedy
+
+def test_missing_comparators_say_what_adds_them(archive, monkeypatch):
+    page = client.get("/data").text
+    assert "baseline, ensemble missing · Update data adds them" in page
+    assert '<button class="gold" id="hub-pull"' in page
+    r = client.post("/freshness", headers={"Accept": "application/json"})
+    assert r.json()["comparators_missing"] is True
+
+    def pull():                   # the pull adds the comparators' folders
+        for sub in ("FluSight-baseline", "FluSight-ensemble"):
+            (archive / "model-output" / sub).mkdir(parents=True)
+        return True, "Already up to date."
+    monkeypatch.setattr(data_mod, "pull_hub", pull)
+    msg = client.post("/data/pull", headers={"Accept": "application/json"}
+                      ).json()["message"]
+    assert "baseline and ensemble comparators added" in msg
+    page = client.get("/data").text
+    assert 'id="comp-ok"' in page
+    assert '<button class="quiet" id="hub-pull"' in page
+
+
+# ------------------------------- DA-07: the live file in the vintage browser
+
+def test_the_browser_shows_the_live_file_when_the_archive_lags_it(archive):
+    live = archive / "target-data" / "target-hospital-admissions.csv"
+    live.parent.mkdir(parents=True)
+    newer = (archive / f"target-hospital-admissions_{V2}.csv").read_text()
+    live.write_text(newer + "2098-01-17,39,Ohio,230,0.0\n")
+    page = client.get("/data?loc=Ohio").text
+    assert '<option selected value="live">2098-01-17 (live file)</option>' \
+        in page
+    assert '"2098-01-17"' in page.split("const VSERIES", 1)[1].split(";")[0]
+    # an archived vintage is still a choice
+    page = client.get(f"/data?vintage={V2}&loc=Ohio").text
+    assert f"<option selected>{V2}</option>" in page
+    assert '"2098-01-17"' not in page.split("const VSERIES", 1)[1].split(
+        ";")[0]
+
+
+# ------------------------------------------- DA-19: one colour per season
+
+def test_a_season_keeps_one_colour_on_the_page():
+    assert ui_data._season_vars(["2023-24", "2025-26", "2024-25"]) == {
+        "2025-26": "--gold", "2024-25": "--season-1", "2023-24": "--season-2"}
+    ctx = {"vintage_rows": [{"season": "2025-26"}, {"season": "2024-25"}]}
+    # the chart's older season continues the strip's order
+    ui_data._set_season_vars(ctx, ["2023-24", "2024-25", "2025-26"])
+    assert [r["var"] for r in ctx["vintage_rows"]] == ["--gold", "--season-1"]
+    assert ctx["season_vars"]["2023-24"] == "--season-2"
+
+
+def test_the_strip_and_the_chart_read_the_same_map(archive):
+    page = client.get("/data").text
+    strip = page.split('class="archive-strip"', 1)[1].split("</svg>", 1)[0]
+    assert 'style="fill:var(--gold)"' in strip
+    sv = re.search(r"const SEASON_VARS = (\{[^;]*\});", page).group(1)
+    assert '"2097-98": "--gold"' in sv
+    assert "SEASON_VARS[k]&&css(SEASON_VARS[k])" in page
+
+
+# ------------------------------------ DA-23: the snapshot in the title
+
+def test_a_snapshot_datasets_chart_title_names_the_snapshot():
+    lines = grouped_bytes(groups=("West",), end=date(2023, 12, 2)).decode(
+        ).strip().split("\n")
+    head, rows = lines[0], lines[1:]
+    snaps = "\n".join([head + ",as_of"]
+                      + [r + ",2023-11-25" for r in rows[:-1]]
+                      + [r + ",2023-12-02" for r in rows]) + "\n"
+    ds = stored(snaps.encode(), "flu")
+    assert ds.vintage_true
+    page = client.get(f"/data?source={ds.id}").text
+    assert "const VASOF = true ? ' · as of '+VVINTAGE : '';" in page
+    assert "VLOC+' · '+VDS+VASOF" in page
+    plain = stored(grouped_bytes(groups=("West",), end=date(2023, 12, 2)),
+                   "plain")
+    assert "const VASOF = false ?" in client.get(
+        f"/data?source={plain.id}").text
