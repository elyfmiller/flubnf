diff --git a/app/tests/test_home_map.py b/app/tests/test_home_map.py
new file mode 100644
index 0000000..2ab6cb7
--- /dev/null
+++ b/app/tests/test_home_map.py
@@ -0,0 +1,145 @@
+"""Home's outlook map (bug hunt 2026-10-25, G18).
+
+  * The card's heading carries the reference date, as the report and the
+    files do; the data's own date is a fact in the bar.
+  * Without the run's report, no state is a link and nothing promises one.
+  * The national forecast, which has no shape on the map, is a line in
+    the bar ("United States  stable 45%"), following the model toggle.
+  * A finger swipe on the map scrolls the page; the map is a named group
+    the keyboard can skip, and its states come in alphabetical order.
+  * The legend names the uncoloured states as the hovers do, with a
+    swatch that keeps an edge on a dark card; the hero chips are white.
+"""
+import json
+import re
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core import usmap                                     # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import shared as ui_shared                         # noqa: E402
+from app.ui.routes import home as H                            # noqa: E402
+
+client = TestClient(srv.app)
+RID = "20980103T000000-abcdef"
+STATIC = Path(__file__).resolve().parents[1] / "ui" / "static"
+
+
+def _q(med):
+    return {"0": {"0.1": med * .8, "0.25": med * .9, "0.5": med,
+                  "0.75": med * 1.1, "0.9": med * 1.3}}
+
+
+@pytest.fixture()
+def run(tmp_path, monkeypatch):
+    """A Groundhog run for Ohio and US with its report (results.json's
+    quantiles give Home its cards)."""
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    w = tmp_path / "workroots" / RID
+    w.mkdir(parents=True)
+    obs = {loc: [[f"2097-12-{d:02d}", 120.0 + d] for d in (13, 20, 27)]
+           for loc in ("Ohio", "US")}
+    (w / "results.json").write_text(json.dumps({
+        "forecast_date": "2098-01-03", "observed": obs,
+        "models": {"analogue": {"Ohio": _q(150.0), "US": _q(2000.0)}}}))
+    (w / "report.html").write_text("<p>r</p>")
+    ui_shared._invalidate_scans()
+    H._outlook_block_cached.cache_clear() if hasattr(
+        H._outlook_block_cached, "cache_clear") else None
+    yield w
+    ui_shared._invalidate_scans()
+
+
+# ----------------------------------------- HM-02: one date for one forecast
+
+def test_the_heading_carries_the_reference_date_and_the_bar_the_data_date(run):
+    ob = H._outlook_block(RID)
+    assert ob["outlook_date"] == "2098-01-03" and ob["outlook_ref"] == "2098-01-10"
+    html = client.get("/").text
+    assert "US categorical forecast · 2098-01-10" in html
+    assert '<span class="uk-stat-v" id="hm-asof">2098-01-03</span>' in html
+
+
+# -------------------------------- HM-03: no report, no link and no promise
+
+def test_without_the_report_no_state_is_a_link_and_nothing_promises_one(run):
+    html = client.get("/").text
+    assert "window.MAP_LINK='/output/report'" in html
+    assert 'role="button" tabindex="0" aria-label="Ohio: ' in html
+    assert "click one to open its" in html and "click for details" in html
+    (run / "report.html").unlink()
+    html = client.get("/").text
+    assert "window.MAP_LINK='/output/report'" not in html
+    assert 'class="st noclick" data-fips="39"' in html
+    assert "click one to open" not in html and "click for details" not in html
+    assert 'class="btn quiet hm-report"' not in html
+
+
+# ------------------------------------- HM-04: the national forecast's line
+
+def test_the_national_forecast_is_a_line_in_the_bar(run):
+    html = client.get("/").text
+    line = html.split('id="hm-us"', 1)[1].split("</dd>", 1)[0]
+    assert re.search(r"<span data-us-words>[a-z ]+ \d+%</span>", line)
+    assert "<dt>United States</dt>" in html.split('id="hm-us"', 1)[0][-200:]
+    assert H._us_words({"probs": {"stable": 0.449, "increase": 0.3}}) == "stable 45%"
+    assert H._us_words({"probs": {}}) == "" and H._us_words(None) == ""
+    # a US-only run: a dated card with its one forecast on it
+    (run / "results.json").write_text(json.dumps({
+        "forecast_date": "2098-01-03",
+        "observed": {"US": [["2097-12-27", 1900.0]]},
+        "models": {"analogue": {"US": _q(2000.0)}}}))
+    ui_shared._invalidate_scans()
+    html = client.get("/").text
+    assert "US categorical forecast · 2098-01-10" in html
+    assert 'id="hm-cover">0 of 52</span>' in html and 'id="hm-us"' in html
+
+
+# -------------------------- HM-07 and HM-16: touch, the map's name, the order
+
+def test_the_map_scrolls_under_a_finger_and_is_a_named_group_in_order():
+    svg = usmap.svg_map({})
+    assert "touch-action:manipulation" in svg and "touch-action:none" not in svg
+    assert ('<svg id="usmap" viewBox="0 0 975 610" xmlns="http://www.w3.org/2000/svg"\n'
+            '     role="group" aria-label="Map of the United States" tabindex="-1"') in svg
+    assert '<a class="skip" href="#usmap-end">Skip past the map</a>' in svg
+    assert '<span id="usmap-end" tabindex="-1"></span>' in svg
+    names = re.findall(r'<path [^>]*aria-label="([A-Za-z .]+?)(?::|")', svg)
+    assert names[:5] == ["Alabama", "Alaska", "Arizona", "Arkansas", "California"]
+    assert len(names) == len(usmap.state_paths()) and names == sorted(names)
+
+
+# --------------------------- HM-18 and UI-08: the legend's words, the chips
+
+def test_the_legend_names_states_left_out_of_the_run_and_keeps_an_edge(run):
+    assert "not in this run</span>" in usmap.map_legend("not in this run")
+    assert "no data</span>" in usmap.map_legend()
+    # from results.json alone the run's scope is unknown: the hovers say
+    # "no data in this view" and so does the legend
+    html = client.get("/").text
+    assert 'aria-label="Texas: no data in this view"' in html
+    legend = html.split('class="hint maplegend"', 1)[1].split("</p>", 1)[0]
+    assert legend.endswith("no data</span>")
+    # the report bundle names the run's scope: the legend follows the hovers
+    card = {"fips": "39", "abbr": "OH", "name": "Ohio",
+            "probs": {"stable": 0.6, "increase": 0.4}, "hover_html": "<b>Ohio</b>"}
+    (run / "report_inputs.json").write_text(json.dumps({
+        "version": 8, "cards": {"Ohio": card}, "cards_model": "analogue",
+        "fitted_fips": ["39"], "gap_fips": []}))
+    ui_shared._invalidate_scans()
+    html = client.get("/").text
+    assert 'aria-label="Texas: not fitted in this run"' in html
+    legend = html.split('class="hint maplegend"', 1)[1].split("</p>", 1)[0]
+    assert legend.endswith("not in this run</span>") and "no data" not in legend
+    css = (STATIC / "nau.css").read_text(encoding="utf-8")
+    rule = css.split(".sw{", 1)[1].split("}", 1)[0]
+    assert "box-shadow:inset 0 0 0 1px" in rule
+    assert ".hero .hm-facts b{color:#fff}" in css
+    home_css = (STATIC / "tabs" / "home.css").read_text(encoding="utf-8")
+    assert "gold-bright" not in home_css.split(".hm-facts b{", 1)[1].split("}", 1)[0]
