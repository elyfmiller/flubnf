diff --git a/app/tests/test_groundhog_text.py b/app/tests/test_groundhog_text.py
new file mode 100644
index 0000000..96b0281
--- /dev/null
+++ b/app/tests/test_groundhog_text.py
@@ -0,0 +1,62 @@
+"""The Groundhog's description, settings help and figures describe the
+form that ships: own-state weighting with size-matched donors (bug hunt
+2026-10-25, G11: ME-02, ME-11, ME-17, ME-23, MO-15)."""
+import re
+
+from fastapi.testclient import TestClient
+
+from app.core import knobs as K
+from app.ui.server import app
+
+client = TestClient(app)
+
+
+def test_the_groundhog_description_names_the_size_matched_donors():
+    methods = client.get("/methods").text
+    how = methods.split('id="mt-gh-how"', 1)[1].split("</details>", 1)[0]
+    assert "near the jurisdiction&#39;s newest" in how.replace("'", "&#39;")
+    assert "30 effective donors" in how
+    bank = methods.split('id="mt-gh-bank"', 1)[1].split("</details>", 1)[0]
+    assert ("the own-state weighting (2026-10-15) and the size-matched donor\n"
+            " weighting (2026-10-23)") in bank
+    assert 'id="mt-gh-size">most</span>' in methods
+    page = client.get("/model/analogue").text
+    assert "near the jurisdiction&#39;s newest carrying the most" in page
+    # the model page's figure and the equation's variables say it too
+    assert page.count("donor weeks sized like the newest weighted most") == 2
+
+
+def test_the_groundhog_help_names_no_form_one_setting_cannot_give():
+    """Own share 0 alone still runs the size-matched kernel, and bank none
+    alone keeps the own-state weighting: neither is the pooled form nor
+    the bare analogue, so the help says what the setting drops."""
+    assert K.BY_KEY["groundhog.own_share"].help.endswith(
+        "0 drops the own-state weighting.")
+    assert K.BY_KEY["groundhog.aux"].help.endswith("none runs without a bank.")
+    assert "pooled form" not in K.BY_KEY["groundhog.own_share"].help
+    assert "bare analogue" not in K.BY_KEY["groundhog.aux"].help
+    assert K.choice_word("groundhog.aux", "none") == "none"
+
+
+def test_the_banks_range_on_methods_reads_each_choice_once():
+    from app.ui.routes.methods import _choice
+    assert _choice("groundhog.aux", "none") == "none"
+    assert _choice("groundhog.aux", "flusurv") == "FluSurv-NET (flusurv)"
+    methods = client.get("/methods").text
+    assert "(none)" not in methods and "(bare analogue)" not in methods
+    assert "FluSurv-NET and ILI+ (both) | none" in methods
+
+
+def test_the_groundhog_figures_describe_donor_weeks_and_a_four_week_fan():
+    methods = client.get("/methods").text
+    assert "one ratio per donor week" in methods
+    assert "Each donor week contributes one growth ratio per horizon" in methods
+    assert "one ratio per donor season" not in methods
+    page = client.get("/model/analogue").text
+    # the fan on the month axis (week w at x = 50 + w * 745 / 52) ends four
+    # weeks after the forecast date at x = 430
+    fan = re.search(r'<polygon points="430,140 ([0-9.]+),[0-9.]+ ([0-9.]+),'
+                    r'[0-9.]+" fill="var\(--gold-bright\)"', page)
+    assert fan, "the forecast fan"
+    end = 430 + 4 * 745 / 52
+    assert all(abs(float(x) - end) < 2 for x in fan.groups())
