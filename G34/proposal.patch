diff --git a/app/tests/test_methods_polish.py b/app/tests/test_methods_polish.py
new file mode 100644
index 00000000..d2f5d8a4
--- /dev/null
+++ b/app/tests/test_methods_polish.py
@@ -0,0 +1,123 @@
+"""Methods' reading aids, rules and print (bug hunt 2026-10-25, G34).
+
+  * A contents jump leaves its section's title under the bar at any width:
+    the bar is measured again once the Print button joins it (ME-04).
+  * The last section's chip is marked at the page's end, and a chip
+    followed is marked at once (ME-05).
+  * A prior range says the engine's rule, and a refusal says it in the
+    same words (ME-13).
+  * Each setting's note is one plain sentence: no keys, files, dates or
+    people (ME-16).
+  * The Policies folds go on from their titles (ME-18).
+  * Printing keeps figures, tables and folds whole, not whole cards
+    (ME-21).
+  * Each table scroller can be focused and is named (ME-22).
+"""
+import re
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from fastapi.testclient import TestClient                      # noqa: E402
+
+from app.core import knobs as K                                # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+
+client = TestClient(srv.app)
+UI = Path(__file__).resolve().parents[1] / "ui"
+METHODS = (UI / "templates" / "methods.html").read_text(encoding="utf-8")
+
+
+def test_the_bar_is_measured_after_the_print_button_joins_it():
+    after = METHODS.split("bar.appendChild(pb);", 1)[1]
+    assert after.lstrip().startswith(
+        "barH();\n  if ('ResizeObserver' in window) new ResizeObserver(barH)"
+        ".observe(bar);")
+    # and only then the scrollspy's band, which a section ending behind
+    # the bar never wins
+    assert "new IntersectionObserver" in after
+    assert "new IntersectionObserver" not in METHODS.split(
+        "bar.appendChild(pb);", 1)[0]
+    assert ("if (seen[i] && secs[i].el.getBoundingClientRect().bottom > "
+            "under)") in after
+    # the performance anchor sits before its title, so a jump shows it
+    assert ('<div class="card"><span id="performance"></span><h2>Measured '
+            'performance</h2>') in METHODS
+    from app.core import site_build
+    assert site_build._PERF_CARD.search(
+        '<div class="card"><span id="performance"></span><h2>Measured '
+        'performance</h2><p>x</p></div>\n<div class="card">')
+
+
+def test_the_last_chip_is_marked_at_the_end_and_a_followed_one_at_once():
+    assert ("if (atEnd()) { mark(secs[secs.length - 1].a); return; }"
+            in METHODS)
+    assert "links.forEach(function (a) { a.addEventListener('click', function () { mark(a); }); });" in METHODS
+
+
+@pytest.mark.parametrize("key, raw, said", [
+    ("pf.prior.mult", "0, 1", "pf.prior.mult: 0, 1 is outside 0 < low < high"),
+    ("pf.prior.r", "-1, 2", "pf.prior.r: -1, 2 is outside 0 < low < high"),
+    ("pf.prior.Reff", "-0.5, 2",
+     "pf.prior.Reff: -0.5, 2 is outside 0 ≤ low < high"),
+    ("pf.prior.Reff", "2, 1", "pf.prior.Reff: 2, 1 is outside 0 ≤ low < high"),
+])
+def test_a_prior_range_says_the_engines_rule(key, raw, said):
+    with pytest.raises(K.KnobError) as e:
+        K.parse({key: raw})
+    assert str(e.value) == said
+    assert "loguniform_var" not in str(e.value)
+    # a uniform prior may start at 0
+    assert K.parse({"pf.prior.Reff": "0, 2"})["pf.prior.Reff"] == (0.0, 2.0)
+
+
+def test_the_methods_table_states_the_rule_per_prior():
+    html = client.get("/methods").text
+    row = html.split('id="set-pf-prior-mult"', 1)[1].split("</tr>", 1)[0]
+    assert "0 &lt; low &lt; high" in row
+    row = html.split('id="set-pf-prior-Reff"', 1)[1].split("</tr>", 1)[0]
+    assert "0 ≤ low &lt; high" in row
+
+
+def test_each_settings_note_is_one_plain_sentence():
+    from app.ui.routes.methods import settings_reference
+    notes = [r["note"] for g in settings_reference() for r in g["rows"]
+             if r["note"]]
+    assert len(notes) == 11
+    keys = "|".join(re.escape(k) for k in K.BY_KEY)
+    for n in notes:
+        assert n.endswith(".") and ". " not in n, n
+        assert len(n.split()) <= 45, n
+        assert not re.search(keys, n), n                    # labels, not keys
+        assert not re.search(r"docs/|\d{4}-\d{2}-\d{2}|Spencer|Ely|"
+                             r"Pre-registered|rho\*mult|season_total", n), n
+    html = client.get("/methods").text
+    assert "Pre-registered screen" not in html and "Spencer Fox" not in html
+
+
+def test_the_policies_folds_go_on_from_their_titles():
+    for title, body in (
+            ("A newest week that reads 0, collapses, or was not reported",
+             "<p>It is the forecaster's decision"),
+            ("Two measured caveats", "<p>Seven of 76 sealed weeks")):
+        fold = METHODS.split(f'tips.fold("{title}"', 1)[1]
+        assert fold.split("\n", 1)[1].lstrip().startswith(body), title
+
+
+def test_printing_keeps_figures_tables_and_folds_whole_not_cards():
+    css = (UI / "static" / "tabs" / "methods.css").read_text(encoding="utf-8")
+    pr = css.split("@media print{", 1)[1]
+    assert not re.search(r"\.mt-doc \.card\{[^}]*break-inside", pr)
+    assert (".mt-doc svg,.mt-doc table,.mt-doc details,.mt-doc .uk-stats{\n"
+            "    break-inside:avoid;page-break-inside:avoid}") in pr
+
+
+def test_each_table_scroller_can_be_focused_and_is_named():
+    html = client.get("/methods").text
+    for opening in re.findall(r'<div (?:class="(?:mt-setscroll|eqvars-scroll)"'
+                              r'|style="overflow-x:auto")[^>]*>', html):
+        assert 'tabindex="0" role="region" aria-label="' in opening, opening
+        assert "(scrolls)" in opening, opening
