diff --git a/app/tests/test_sandbox_polish.py b/app/tests/test_sandbox_polish.py
new file mode 100644
index 00000000..5ea29df6
--- /dev/null
+++ b/app/tests/test_sandbox_polish.py
@@ -0,0 +1,223 @@
+"""Sandbox polish (bug hunt 2026-10-25, G31): the diagram captions count
+the model's rules and the network's reactions; an action saves only the
+files that changed, and never the one it writes itself; the engine-missing
+reason is said once, in plain words; a run with no plot keeps one divider;
+What changed reads in words with formatted numbers; a dataset-based start
+gets no Oracle step card and the state is said in words; the engine's own
+plumbing keys are not shown; the Load-off reason is said once; count words
+go singular; the run zip carries the engine's messages; a model made from
+an example is changed now; the diagram's labels follow the text size and
+never shrink below a pixel each."""
+import json
+import os
+import sys
+import time
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.core import contactmap                            # noqa: E402
+from app.core import sandbox as sb                         # noqa: E402
+from app.core import sandbox_export as sbx                 # noqa: E402
+from app.core.engines import pf as pf_engine               # noqa: E402
+from app.ui import server as srv                           # noqa: E402
+from app.ui import state as ui_state                       # noqa: E402
+from app.ui.routes import sandbox as ui_sandbox            # noqa: E402
+
+client = TestClient(srv.app)
+UI = Path(__file__).resolve().parents[1] / "ui"
+VIEWS_T = (UI / "templates" / "sandbox_views.html").read_text(encoding="utf-8")
+SANDBOX_T = (UI / "templates" / "sandbox.html").read_text(encoding="utf-8")
+SANDBOX_JS = (UI / "static" / "sandbox.js").read_text(encoding="utf-8")
+VIEWS_JS = (UI / "static" / "model-views.js").read_text(encoding="utf-8")
+VIEWS_CSS = (UI / "static" / "model-views.css").read_text(encoding="utf-8")
+SANDBOX_CSS = (UI / "static" / "tabs" / "sandbox.css").read_text(encoding="utf-8")
+
+SITES = """begin model
+begin molecule types
+L(r)
+R(l,p~0~1)
+Tally()
+end molecule types
+begin reaction rules
+L(r) + R(l) -> L(r!1).R(l!1) + Tally()  k1
+R(p~0) -> R(p~1)  k2
+A() <-> B()  kf, kr
+end reaction rules
+end model
+"""
+
+
+@pytest.fixture()
+def box(sandbox_root):
+    before = dict(ui_state._status)
+    ui_state._status.pop("flash", None)
+    ui_state._status.pop("flash_detail", None)
+    yield sandbox_root
+    ui_state._status.clear()
+    ui_state._status.update(before)
+
+
+def _flash():
+    return (ui_state._status.get("flash") or "",
+            ui_state._status.get("flash_detail") or "")
+
+
+# ------------------------------------------------------------------- SB-07
+
+def test_the_captions_count_the_models_rules_and_the_networks_reactions():
+    # a state change draws no arrow; a reversible rule is one rule
+    flow = contactmap.rule_flow(SITES)
+    assert flow["rules"] == 3
+    drawn = {e["rule"].removesuffix(" (reverse)") for e in flow["edges"]}
+    assert drawn == {"1", "3"}                 # the state change drew none
+    # the Model view reads the count; the Reaction network view the API's
+    assert "var m = g.rules !== undefined ? g.rules : Object.keys(rules).length;" in VIEWS_T
+    assert "nv.idle = d.species + (d.species === 1 ? ' species, ' : ' species, ') + d.reactions" in VIEWS_T
+
+
+# ------------------------------------------------------------------- SB-18
+
+def test_an_action_saves_only_what_changed_and_never_the_file_it_writes(box):
+    sb.add_example("sir_example", as_name="mine")
+    files = sb.read_model("mine")
+    before = {f: (sb.MODELS / "mine" / f).stat().st_mtime_ns for f in sb.REQUIRED}
+    time.sleep(0.02)
+    saved = ui_sandbox._sandbox_save_posted("mine", files["model.bngl"],
+                                            files["data.exp"], files["priors.conf"])
+    assert saved == []
+    assert {f: (sb.MODELS / "mine" / f).stat().st_mtime_ns for f in sb.REQUIRED} == before
+    # a Windows browser's line ends are no change either
+    assert ui_sandbox._sandbox_save_posted(
+        "mine", files["model.bngl"].replace("\n", "\r\n"), "", "") == []
+    saved = ui_sandbox._sandbox_save_posted("mine", files["model.bngl"] + "# x\n",
+                                            files["data.exp"] + "9 9\n",
+                                            files["priors.conf"],
+                                            replaced=("data.exp",))
+    assert saved == ["model.bngl"]
+    assert (sb.MODELS / "mine" / "data.exp").read_text() == files["data.exp"]
+    assert (sb.MODELS / "mine" / "model.bngl").read_text().endswith("# x\n")
+    # the fill, simulate and upload routes write data.exp themselves
+    src = Path(ui_sandbox.__file__).read_text(encoding="utf-8")
+    assert src.count('replaced=("data.exp",)') == 2          # fill, simulate
+    assert src.count('str(form.get("priors_conf") or ""),\n            ("data.exp",))') == 1
+
+
+# ------------------------------------------------------------------- SB-19
+
+def test_the_engine_missing_reason_leads_with_plain_words(box, monkeypatch):
+    monkeypatch.setattr(pf_engine, "engine_available", lambda: False)
+    notice, tip = sb.split_reason(sb.machine_problem())
+    assert notice == "The fitting engine is not installed."
+    assert tip.startswith(pf_engine.engine_missing_message()[:40])
+
+
+# ------------------------------------------------------------------- SB-20
+
+def test_a_run_with_no_plot_keeps_one_divider():
+    assert ".sb-rsum + .sb-rsec{border-top:0;padding-top:0}" in SANDBOX_CSS
+
+
+# ------------------------------------------------------------------- SB-21
+
+def test_what_changed_reads_in_words_with_formatted_numbers():
+    assert sbx.SETTING_LABELS["n_obs"] == "Data rows"
+    assert sbx.SETTING_LABELS["particles"] == "Particles"
+    assert sbx._setting_text(10000) == "10,000"
+    assert sbx._setting_text(0.15) == "0.15" and sbx._setting_text(None) == ""
+    assert sbx._setting_text(True) == "on"
+    assert "<td>{{ s.label }}</td>" in SANDBOX_T
+    assert 'da.location or "as written"' in SANDBOX_T and '"typed"' not in SANDBOX_T
+
+
+# ------------------------------------------------------------------- SB-22
+
+def test_a_dataset_start_gets_no_oracle_card_and_the_donors_read_in_words():
+    assert "{% if (oracle or (shipped and shipped.shipped)) and not dataset_start %}" in SANDBOX_T
+    assert '"both": "both streams", "flusurv_only": "FluSurv-NET only"' in SANDBOX_T
+    assert 'tips.stat("Donors", DONORS.get(oracle.state, oracle.state), id="sb-ostate")' in SANDBOX_T
+    assert 'tips.stat("w",' not in SANDBOX_T
+    assert '"dataset_start": shipped["info"].get("origin") == sandbox_mod.SHIPPED_DATASET' in (
+        Path(ui_sandbox.__file__).read_text(encoding="utf-8"))
+
+
+# ------------------------------------------------------------------- SB-23
+
+def test_the_engine_keys_fold_leaves_out_the_plumbing(box):
+    sb.add_example("sir_example", as_name="mine")
+    html = client.get("/sandbox?model=mine").text
+    fold = html.split('id="sb-keys"', 1)[1].split("</details>", 1)[0]
+    for key in ("fit_type", "population_size", "max_iterations"):
+        assert f"<code>{key}</code>" not in fold
+    assert "<code>objfunc</code>" in fold and "<code>pf_bounds</code>" in fold
+
+
+# ------------------------------------------------------------------- SB-24
+
+def test_the_load_off_reason_is_said_once():
+    assert "root.FluBNFUI.setReason(load, null);\n      load.disabled = !!r;" in SANDBOX_JS
+    assert "setReason(load, r || null)" not in SANDBOX_JS
+    assert "alertHtml('warn', 'Load is off:', r, null)" in SANDBOX_JS
+
+
+# ------------------------------------------------------------------- SB-25
+
+def test_count_words_go_singular(box):
+    assert ui_sandbox._weeks(1) == "1 week" and ui_sandbox._weeks(3) == "3 weeks"
+    assert ui_sandbox._weeks(1, "missing week") == "1 missing week"
+    ui_sandbox._sandbox_fill_flash({"asof": "settled", "location": "one", "rows": 1,
+                                    "dropped": 1, "start": "2026-10-17",
+                                    "end": "2026-10-17", "one_series": True})
+    msg, detail = _flash()
+    assert msg == "data.exp filled: 1 week of one (one series), 2026-10-17 to 2026-10-17."
+    assert detail == "Source: settled truth. 1 missing week dropped."
+
+
+# ------------------------------------------------------------------- SB-26
+
+def test_the_run_zip_carries_the_engines_messages(box):
+    import io
+    import zipfile
+    sb.add_example("sir_example", as_name="mine")
+    d = sb.RUNS / "20980101-000000_mine"
+    cell = d / "mine_r0"
+    cell.mkdir(parents=True)
+    for f, g in (("model.bngl", "m.bngl"), ("data.exp", "data.exp"),
+                 ("priors.conf", "priors.conf")):
+        (cell / g).write_text((sb.MODELS / "mine" / f).read_text())
+    (d / "meta.json").write_text(json.dumps({
+        "model": "mine", "status": "failed", "particles": 100, "jitter": 0.15,
+        "forecast_weeks": 4, "seed": 0, "suffix": "data", "obs_col": "Cobs",
+        "n_obs": 3, "time": [0, 1, 2], "observed": [1, 2, 3], "error": "boom"}))
+    (d / "pf_runner_0.err").write_text("x" * (sbx.ERR_ZIP_MAX + 10) + "\nthe end\n")
+    (d / "pf_runner_1.err").write_text("   \n")           # blank: left out
+    z = zipfile.ZipFile(io.BytesIO(sbx.run_zip(d.name)))
+    names = {n.split("/", 1)[1] for n in z.namelist()}
+    assert "pf_runner_0.err" in names and "pf_runner_1.err" not in names
+    tail = z.read(f"{d.name}/pf_runner_0.err")
+    assert len(tail) == sbx.ERR_ZIP_MAX and tail.endswith(b"the end\n")
+
+
+# ------------------------------------------------------------------- UI-16
+
+def test_a_model_made_from_an_example_is_changed_now(box):
+    shipped = (sb.EXAMPLES / "sir_example" / "model.bngl").stat().st_mtime
+    t0 = time.time() - 1
+    sb.add_example("sir_example", as_name="mine")
+    for f in sb.REQUIRED:
+        m = (sb.MODELS / "mine" / f).stat().st_mtime
+        assert m >= t0 and m >= shipped
+    assert sb.read_info("mine")["origin"] == "example:sir_example"
+
+
+# ------------------------------------------------------------------- UI-19
+
+def test_the_diagram_never_shrinks_its_labels_and_follows_the_text_size():
+    assert ("var rf = parseFloat(getComputedStyle(document.documentElement).fontSize) / 16 || 1;"
+            in VIEWS_JS)
+    assert "this.svg.style.minWidth = Math.round(w * rf) + 'px';" in VIEWS_JS
+    assert ".mv{position:relative;overflow-x:auto}" in VIEWS_CSS
+    assert "max-width:none" in VIEWS_CSS.split(".mv svg.mv-svg{", 1)[1].split("}", 1)[0]
