diff --git a/app/tests/test_forecast_text.py b/app/tests/test_forecast_text.py
new file mode 100644
index 00000000..70217d72
--- /dev/null
+++ b/app/tests/test_forecast_text.py
@@ -0,0 +1,232 @@
+"""The Forecast tab's and the run page's clutter and wording (bug hunt
+2026-10-25, G30): the week's issues stated once (the newest check heads
+the Data issues box, no per-state "i", no box "i"; the Results table's
+Data issues row counts the zero-anchor outcomes, so the zero row shows
+only without it); the run pages say choices in the box's words ("both
+from 10-10", "not reported"); the Model settings panel shows only what a
+student can set, its fixed values and coming-later settings on Methods,
+its hints without internal names; the archive-gap words as the rule
+works; the mode pills a pressed-button group; the run page says the files
+line and the Settings heading once."""
+import sys
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import app.core.runs as runs_mod                               # noqa: E402
+from app.core import knobs as K                                # noqa: E402
+from app.core import missing as MS                             # noqa: E402
+from app.core import reported                                  # noqa: E402
+from app.ui import server as srv                               # noqa: E402
+from app.ui import state as ui_state                           # noqa: E402
+from app.ui.routes import forecast as ui_forecast              # noqa: E402
+from test_newest_reported import LOCS, NEW, WEEKS, _hub        # noqa: E402
+
+client = TestClient(srv.app)
+UI = Path(__file__).resolve().parents[1] / "ui"
+FORECAST_T = (UI / "templates" / "forecast.html").read_text(encoding="utf-8")
+NAU = (UI / "static" / "nau.css").read_text(encoding="utf-8")
+
+
+# ------------------------------------------------------------------- FC-26
+
+def test_the_weeks_issues_are_stated_once_on_the_forecast_tab(tmp_path, monkeypatch):
+    _hub(tmp_path / "hub", monkeypatch, newest={"Ohio": "0", "Utah": None})
+    ui_state._last_form.clear()
+    ui_state._last_form.update({"forecast_date": NEW, "locations": ["all"],
+                                "engine": "all"})
+    page = client.get("/forecast").text
+    box = page[page.index('id="data-issues"'):page.index("</fieldset>")]
+    # the newest check is the box's head: its mark, the count, a badge per
+    # kind of issue, and no "?" of its own
+    assert '<div class="fc-di-head"><p class="newest-check hint" id="newest-check"' in box
+    assert f"{len(LOCS) - 1} of {len(LOCS)} reported" in box
+    assert '<span class="uk-badge-t">1 not reported</span>' in box
+    assert '<span class="uk-badge-t">1 reads 0</span>' in box
+    assert page.count('id="newest-check"') == 1
+    assert 'id="tip-newest-gaps"' not in page
+    # no "i" on the box, none per state: the flag stands beside the name
+    assert "uk-tt-btn" not in box and "tipbtn" not in box
+    assert '<span class="di-flag">0 after 40, 40, 40</span>' in box
+    assert '<span class="di-flag">not reported</span>' in box
+    assert "aria-describedby" not in box
+    # the page keeps its two "i": the Settings card's, which now names the
+    # box, and the panel's
+    assert page.count('class="uk-tt-btn"') == 2
+    assert "<b>Data issues:</b> a state whose newest week reads 0, collapsed or was not reported." in page
+
+
+def test_a_clean_week_keeps_the_plain_check_line(tmp_path, monkeypatch):
+    _hub(tmp_path / "hub", monkeypatch)
+    ui_state._last_form.clear()
+    page = client.get("/forecast").text
+    assert 'id="data-issues"' not in page
+    line = page.split('id="newest-check"')[1].split("</p>")[0]
+    assert f'<span class="nc-head">All {len(LOCS)} reported</span>' in line
+
+
+def test_the_results_table_states_the_data_issues_once():
+    T = "2098-10-11"
+    o = {"analogue_anchor_notes": {
+        "Utah": f"zero-anchor level: newest week {T} reads 0; anchor mean 1.50"},
+        "data_flags": {"analogue": [{"location": "Utah", "week": T, "value": 0.0,
+                                     "rule": "zero-anchor level"}]}}
+    extra = {"data_choices": {"states": {"Utah": {"choice": "level", "what": "reads 0",
+                                                  "followed": True}}}}
+    html = runs_mod.results_html(o, {"engine": "analogue", "forecast_date": T,
+                                     "extra": extra})
+    assert html.count('<th scope="row">Data issues</th>') == 1
+    assert "Newest week reading 0" not in html
+    assert "1 state, 1 recommended, 0 changed; 1 level" in html
+    # without a choices record the zero row still says what the rule did
+    html = runs_mod.results_html({"analogue_anchor_notes": o["analogue_anchor_notes"]},
+                                 {"engine": "analogue", "forecast_date": T})
+    assert "Newest week reading 0" in html and "Data issues" not in html
+
+
+# ------------------------------------------------------------------- FC-27
+
+def test_the_run_pages_say_each_choice_in_the_boxs_words():
+    aside = {"choice": "set_aside", "what": "reads 2 after 75", "from_week": "2098-10-04"}
+    carry = {"choice": "carry", "what": "no row", "from_week": "2098-10-04"}
+    assert reported.choice_text(aside) == "both from 10-04"
+    assert reported.choice_text({"choice": "set_aside"}) == "both from the week before"
+    assert reported.choice_text(carry) == "from 10-04"
+    assert reported.choice_text({"choice": "carry"}) == "from the last reported week"
+    assert reported.choice_text({"choice": "keep"}) == "kept"
+    assert reported.choice_text({"choice": "omit"}) == "left out"
+    assert reported.choice_text({"choice": "abstain"}) == "no forecast"
+    assert reported.choice_text({"choice": "level"}) == "level"
+    assert reported.reason_text("no row") == "not reported"
+    assert reported.REASON_TEXT["no row"] == "not reported"
+    states = {"Alaska": {**carry, "followed": True},
+              "Ohio": {**aside, "followed": True},
+              "Arizona": {"choice": "level", "what": "reads 0 after 63, 69, 60",
+                          "followed": False}}
+    row = runs_mod.data_issues_row({}, {"data_choices": {"states": states}},
+                                   {"analogue": "Groundhog"})
+    assert row[0] == "Data issues"
+    assert "Alaska: not reported; from 10-04." in row[1]
+    assert "Ohio: reads 2 after 75; both from 10-04." in row[1]
+    assert "Arizona: reads 0 after 63, 69, 60; level." in row[1]
+    for raw in ("set_aside", "carry", "no row", "zero-anchor"):
+        assert raw not in row[1]
+    flags = {"analogue": [{"location": "Arizona", "week": "2098-10-11", "value": 0.0,
+                           "rule": "zero-anchor level"}]}
+    assert MS.choices_line(flags) == "1 level"
+    row = runs_mod.data_issues_row({"data_flags": flags}, {}, {"analogue": "Groundhog"})
+    assert "Arizona: 2098-10-11 reads 0; level." in row[1]
+    label = runs_mod.data_issues_label({"data_choices": {"states": {
+        "Alaska": {**carry, "followed": False}}},
+        "knobs": {"groundhog.zero_anchor": "level"}})
+    assert label == ("1 state, 0 recommended, 1 changed: Alaska from 10-04; "
+                     "Newest week reading 0: level for the other states")
+
+
+# ------------------------------------------------------------------- FC-28
+
+def test_the_panel_shows_only_what_a_student_can_set_and_methods_the_rest():
