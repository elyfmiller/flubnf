+def _thin() -> bytes:
+    """Two groups over two seasons and a bit: 20 donor weeks for the
+    newest week, under the Groundhog's floor of 30."""
+    from datetime import date, timedelta
+    d, lines = date(2023, 8, 5), ["date,group,count,population"]
+    while d <= date(2025, 11, 15):
