+def no_donors_row(o: dict, names: dict):
+    """The Results table's row for the Groundhog's locations whose donors
+    gave no distribution (engine notes "no forecast: the donors ..."), or
+    None: a count per member, each location's note in the "?" tip."""
+    import html as _html
