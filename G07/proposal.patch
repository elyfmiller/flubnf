+
+
+def _groundhog_donors(bank: dict) -> int:
+    """The growth ratios the Groundhog would pool for the newest week of
+    `bank` ({(group, week): value}, the newest snapshot of each week): the
+    weeks of earlier seasons within two calendar weeks of it, over every
+    group, each with a positive next week, as the engine draws them for
+    an own dataset (app/core/engines/analogue.py: no season excluded)."""
+    from flubnf import analogue as AN
+    if not bank:
+        return 0
+    last = max(d for _, d in bank)
+    return int(AN.donor_ratios(bank, AN.epiweek(last), AN.season_of(last),
+                               1, exclude_seasons=()).size)
+
