+def _ledger_row(engine, locations, extra):
+    from app.core.runs import RunSpec
+    spec = RunSpec(engine=engine, forecast_date="2098-01-03",
+                   locations=list(locations), extra=extra)
+    return {"spec": spec.to_json(), "status": "ok"}
+
