+def test_a_state_left_out_in_data_issues_is_still_the_forms_pick():
+    """Alaska 'Leave out' takes it out of the run, not out of the pick: the
+    unchanged form read 'Differs: Locations' after such a run."""
+    from flubnf.settings import load_locations
+    from app.ui.routes import forecast as fc
+    names = [n for n in load_locations().location_name if n != "US"]
+    extra = fc._run_extra(2, "realtime")
+    extra["data_choices"] = {"week": "2098-01-03", "source_sha256": "x",
+                             "states": {"Alaska": {"choice": "omit"},
+                                        "Ohio": {"choice": "carry"}}}
+    row = _ledger_row("analogue", [n for n in names if n != "Alaska"] + ["US"],
+                      extra)
+    assert FA.last_run_values([row])["locations"] == ["all"]
+    row = _ledger_row("analogue", ["Ohio"], extra)
+    assert FA.last_run_values([row])["locations"] == ["Alaska", "Ohio"]
+
+
+def test_without_an_auxiliary_bank_untouched_own_state_rows_are_no_difference():
+    """Auxiliary donor bank = none runs the pooled form: the panel's
+    Own-state weight and Size-matched kernel defaults are not what ran,
+    and an untouched row is not a difference. A typed one is compared."""
+    from app.core import knobs as K
+    from app.ui.routes import forecast as fc
+    extra = fc._run_extra(2, "realtime", aux="")
+    K.write_extra({"groundhog.aux": "none"}, extra)
+    kn = FA.last_run_values([_ledger_row("analogue", ["US"], extra)])["knobs"]
+    assert kn["groundhog.aux"] == "none"
+    assert "groundhog.own_share" not in kn and "groundhog.kernel_sd" not in kn
+    extra = fc._run_extra(2, "realtime", aux="")
+    K.write_extra({"groundhog.aux": "none", "groundhog.own_share": 0.8}, extra)
+    kn = FA.last_run_values([_ledger_row("analogue", ["US"], extra)])["knobs"]
+    assert kn["groundhog.own_share"] == "0.8" and "groundhog.kernel_sd" not in kn
+    # with the shipped bank both rows ran as the panel shows them
+    kn = FA.last_run_values([_ledger_row("analogue", ["US"],
+                                         fc._run_extra(2, "realtime"))])["knobs"]
+    assert kn["groundhog.own_share"] == "0.5" and kn["groundhog.kernel_sd"] == "1"
+
+
+def test_a_model_page_restores_the_kept_form_after_a_restart_too(monkeypatch, tmp_path):
+    """The model pages' quick run showed 'all' after a restart until the
+    Forecast tab had been opened once."""
+    from fastapi.testclient import TestClient
+    from app.core import runs as _runs
+    from app.ui import state as ui_state
+    from app.ui.server import app as srv
+    monkeypatch.setattr(_runs, "APP_STATE", tmp_path)
+    FA.save_last_form({"locations": ["Ohio", "Utah"], "engine": "analogue",
+                       "replicates": 3})
+    old = time.time() - 3600
+    os.utime(tmp_path / FA.LAST_FORM_NAME, (old, old))
+    monkeypatch.setattr(FA, "_STARTED", time.time())
+    monkeypatch.setitem(FA._restored, "done", False)
+    before = dict(ui_state._last_form)
+    ui_state._last_form.clear()
+    try:
+        html = TestClient(srv).get("/model/analogue").text
+        assert 'id="mf-locs" name="locations" value="Ohio, Utah"' in html
+        assert ui_state._last_form["locations"] == ["Ohio", "Utah"]
+    finally:
+        ui_state._last_form.clear(); ui_state._last_form.update(before)
+
+
