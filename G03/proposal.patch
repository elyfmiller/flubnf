+def test_a_run_during_a_run_is_said_and_leaves_the_form_alone(tmp_path, monkeypatch):
+    """A second Run while a run is in progress once went by in silence and
+    overwrote the remembered form with settings that never ran."""
+    started = _capture(monkeypatch, tmp_path)
+    _hub(tmp_path / "hub", [W1, W2, W3], [W1, W2, W3], monkeypatch)
+    ui_state._last_form.clear()
+    ui_state._last_form.update({"forecast_date": W3, "locations": ["all"],
+                                "engine": "all", "knobs": {}})
+    ui_state._status.update({"running": "starting",
+                             "run_label": f"{W3} · all 53 jurisdictions · queued",
+                             "flash": None})
+    r = client.post("/run", data={"forecast_date": W1, "mode": "vintage",
+                                  "locations": ["Ohio"], "engine": "analogue",
+                                  "knob.groundhog.bandwidth": "4"},
+                    follow_redirects=False)
+    assert r.status_code == 303 and started == []
+    flash = ui_state._status.get("flash") or ""
+    assert flash.startswith("Not run: a run is already in progress"), flash
+    assert "all 53 jurisdictions" in flash
+    assert ui_state._last_form["locations"] == ["all"]
+    assert ui_state._last_form["engine"] == "all"
+    assert ui_state._last_form["knobs"] == {}
+    assert ui_state._last_form["forecast_date"] == W3
+
+
+def test_a_refused_date_keeps_the_other_edits(tmp_path, monkeypatch):
+    """A Saturday the archive has not: the refusal moves the date, and the
+    locations, model and settings posted with it stay on the form."""
+    started = _capture(monkeypatch, tmp_path)
+    _hub(tmp_path / "hub", [W1, W2, W3], [W1, W2, W3], monkeypatch)
+    ui_state._last_form.clear()
+    ui_state._last_form.update({"forecast_date": W3, "locations": ["Arizona"],
+                                "engine": "pf", "knobs": {}})
+    ui_state._status["running"] = None
+    r = client.post("/run", data={"forecast_date": "2098-09-05", "mode": "vintage",
+                                  "locations": ["US (national)"],
+                                  "engine": "analogue",
+                                  "knob.groundhog.bandwidth": "5"},
+                    follow_redirects=False)
+    assert r.status_code == 303 and started == []
+    assert (ui_state._status.get("flash") or "").startswith("Not run:")
+    f = ui_state._last_form
+    assert f["forecast_date"] == W1                 # moved by the refusal
+    assert f["locations"] == ["US (national)"] and f["engine"] == "analogue"
+    assert f["knobs"]["groundhog.bandwidth"] == "5"
+
+
+def test_the_form_remembers_locations_as_the_checklist_holds_them(tmp_path, monkeypatch):
+    """A model page's text field posts one comma-separated string; a re-run
+    posts the 52 and US one by one. Both come back as the checklist's own
+    values, so the boxes tick and the Run row reads 'Same as last run'."""
+    from flubnf.settings import load_locations
+    started = _capture(monkeypatch, tmp_path)
+    _hub(tmp_path / "hub", [W1, W2, W3], [W1, W2, W3], monkeypatch)
+    names = [n for n in load_locations().location_name if n != "US"]
+    for posted, remembered in (
+            (["Arizona, Ohio"], ["Arizona", "Ohio"]),
+            (names + ["US"], ["all"]),
+            (["all"], ["all"]),
+            (["Ohio", "US (national)"], ["Ohio", "US (national)"]),
+            (["US (national)"], ["US (national)"])):
+        ui_state._status["running"] = None
+        r = client.post("/run", data={"forecast_date": W3, "locations": posted,
+                                      "engine": "analogue"},
+                        headers={"referer": "http://testserver/model/analogue"},
+                        follow_redirects=False)
+        assert r.status_code == 303 and started, posted
+        assert ui_state._last_form["locations"] == remembered, posted
+        started.clear()
+    # the kept file holds the same, so a restart ticks the boxes too
+    from app.ui import forecast_aids as FA
+    assert FA.load_last_form()["locations"] == ["US (national)"]
+    # a typo stays on the form, where the model page shows it to be fixed
+    ui_state._status["running"] = None
+    client.post("/run", data={"forecast_date": W3, "locations": ["Ohio, Oiho"],
+                              "engine": "analogue"}, follow_redirects=False)
+    assert started == [] and ui_state._last_form["locations"] == ["Ohio", "Oiho"]
+
+
+def test_data_issues_choices_survive_a_run_that_did_not_post_the_box(tmp_path, monkeypatch):
+    """The saved choices for the newest week are replaced only by a form
+    that carried the box for that week; a vintage run or a model page's run
+    leaves them alone."""
+    started = _capture(monkeypatch, tmp_path)
+    _hub(tmp_path / "hub", [W1, W2, W3], [W1, W2, W3], monkeypatch)
+    ui_state._last_form.clear()
+    ui_state._last_form.update({"forecast_date": W3, "locations": ["all"],
+                                "engine": "analogue",
+                                "data_choices": {W3: {"02": "omit"}}})
+    for date, extra in ((W3, {}),                                  # a model page
+                        (W2, {"gap._sha": "x", "gap.02": "carry"})):  # a vintage run
+        ui_state._status["running"] = None
+        client.post("/run", data={"forecast_date": date, "locations": ["Ohio"],
+                                  "engine": "analogue", **extra},
+                    follow_redirects=False)
+        assert started and ui_state._last_form["data_choices"] == {W3: {"02": "omit"}}, date
+    ui_state._status["running"] = None
+    client.post("/run", data={"forecast_date": W3, "locations": ["Ohio"],
+                              "engine": "analogue", "gap._sha": "x",
+                              "gap.02": "carry"}, follow_redirects=False)
+    assert ui_state._last_form["data_choices"] == {W3: {"02": "carry"}}
+
