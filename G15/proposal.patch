diff --git a/app/tests/test_deleted_runs_labels.py b/app/tests/test_deleted_runs_labels.py
new file mode 100644
index 0000000..829070a
--- /dev/null
+++ b/app/tests/test_deleted_runs_labels.py
@@ -0,0 +1,98 @@
+"""Run pages after a delete, run labels and bad run ids (bug hunt
+2026-10-25, G15): labels read to the second (FC-15), a run whose folder
+Storage deleted says so everywhere (FC-16), an unreadable results file is a
+note, not a 500 (FC-19), the not-found run page is titled like a run page
+(UI-17), and an unrecorded workroot links to its run page (ST-13)."""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import pytest                                            # noqa: E402
+from fastapi.testclient import TestClient                # noqa: E402
+
+import app.core.runs as runs_mod                         # noqa: E402
+from app.core.runs import Ledger, RunSpec                # noqa: E402
+from app.ui import forecast_aids as FA                   # noqa: E402
+from app.ui import server as srv                         # noqa: E402
+from app.ui import shared as ui_shared                   # noqa: E402
+from app.ui import state as ui_state                     # noqa: E402
+
+client = TestClient(srv.app)
+
+
+@pytest.fixture
+def state(tmp_path, monkeypatch):
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    from app.core import datasets as datasets_mod
+    monkeypatch.setattr(datasets_mod, "ROOT", tmp_path / "datasets")
+    ui_state._status["running"] = None
+    led = Ledger()
+    rid = led.open_run(RunSpec(engine="analogue", forecast_date="2098-01-03",
+                               locations=["Arizona"]), Path("pending"), {})
+    led.close_run(rid, "ok", {"submissions": {"NAU_PyBNF-GroundHogCGR": "f.csv"},
+                              "report": True, "pf_skipped": "analogue-only run"})
+    w = tmp_path / "workroots" / rid
+    w.mkdir(parents=True)
+    (w / "results.json").write_text(json.dumps({"forecast_date": "2098-01-03",
+                                                "models": {}}), encoding="utf-8")
+    ui_shared._invalidate_scans()
+    return {"root": tmp_path, "rid": rid, "ledger": led}
+
+
+def test_run_labels_read_to_the_second():
+    a = ui_shared._run_label("20261025T183601-aaaaaa", "", tag=False)
+    b = ui_shared._run_label("20261025T183639-bbbbbb", "", tag=False)
+    assert (a, b) == ("10-25 18:36:01", "10-25 18:36:39")
+    from app.ui.routes.storage import _ledger_parts
+    assert _ledger_parts("20261025T183601-aaaaaa", "") == ["run 10-25 18:36:01"]
+
+
+def test_a_run_whose_folder_was_deleted_says_so_everywhere(state):
+    rid = state["rid"]
+    import shutil
+    shutil.rmtree(state["root"] / "workroots" / rid)
+    ui_shared._invalidate_scans()
+    page = client.get(f"/runs/{rid}").text
+    assert "This run&#39;s files were deleted in Storage; its ledger row is the record." in page
+    assert "Superseded" not in page
+    assert "<td>1 file (deleted)</td>" in page and "<td>written (deleted)</td>" in page
+    ledger = client.get("/runs").text
+    assert "files deleted" in ledger
+    fc = client.get("/forecast").text
+    assert "1 file (deleted)" in fc
+    # the fan's badge names the deletion, not a run without forecasts
+    rows = state["ledger"].rows(10)
+    assert FA.fan_run(rows, "20970101T000000-ffffff")["earlier"] == (
+        "earlier run · newest files deleted")
+
+
+def test_an_unreadable_results_file_is_a_note_not_a_500(state):
+    rid = state["rid"]
+    (state["root"] / "workroots" / rid / "results.json").write_text(
+        '{"forecast_date": "2098-01-03", "mod', encoding="utf-8")
+    r = client.get(f"/runs/{rid}")
+    assert r.status_code == 200
+    assert "This run&#39;s results file is unreadable" in r.text
+
+
+def test_the_not_found_run_page_is_titled_like_a_run_page(state):
+    r = client.get("/runs/nope")
+    assert r.status_code == 404
+    assert "<title>FluBNF · Run</title>" in r.text
+    assert "<h1>Run</h1>" in r.text
+    assert "<title>FluBNF · Run</title>" in client.get(f"/runs/{state['rid']}").text
+
+
+def test_an_unrecorded_workroot_links_to_its_run_page(state):
+    orphan = "20980118T093000-0rphan"
+    w = state["root"] / "workroots" / orphan
+    w.mkdir()
+    (w / "results.json").write_text(json.dumps({"forecast_date": "2098-01-17",
+                                                "models": {}}), encoding="utf-8")
+    ui_shared._invalidate_scans()
+    html = client.get("/storage").text
+    row = html.split(f'data-wid="{orphan}"', 1)[1].split("</div>", 1)[0]
+    assert f'<a href="/runs/{orphan}">Unrecorded run</a>' in row
+    assert client.get(f"/runs/{orphan}").status_code == 200
