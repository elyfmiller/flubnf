+def test_a_zero_state_the_trailing_zero_rule_covers_is_offered_only_what_applies(
+        tmp_path, monkeypatch):
+    """FC-13: with Newest weeks reading 0 counted as unreported, the box
+    still offered Level, Extend and Blend for a state that rule covers,
+    and a run recorded the choice ("Arizona: ... level") beside the rule's
+    own line ("treated as unreported (trailing zero): Arizona 1"). The
+    engines forecast such a state from the week before whatever zero rule
+    it is given, so the box offers only what applies and the record never
+    says a rule it did not use."""
+    _hub(tmp_path / "hub", monkeypatch, newest={"Ohio": "0", "Utah": "5"})
+    ui_state._last_form.clear()
+    ui_state._last_form.update({"forecast_date": NEW, "locations": ["all"],
+                                "engine": "all",
+                                "knobs": {"data.trailing_zero": "missing"}})
+    page = client.get("/forecast").text
+    box = page[page.index('id="data-issues"'):page.index("</fieldset>")]
+    ohio = box.split('name="gap.39"', 1)[1].split("</select>", 1)[0]
+    assert "<option value=\"level\"" not in ohio and "Extend" not in ohio
+    assert '<option value="set_aside" selected>Both from' in ohio
+    assert '<option value="omit">Leave out</option>' in ohio
+    assert "counted as unreported by the Newest weeks reading 0 setting" in box
+    # a stale form's zero rule for that state is not recorded as applied
+    started = _capture_run(monkeypatch)
+    r = _post({"gap.39": "level", "gap.49": "keep",
+               "knob.data.trailing_zero": "missing"})
+    assert r.status_code == 303 and len(started) == 1
+    dc = started[0].extra["data_choices"]
+    assert "Ohio" not in dc["states"] and dc["states"]["Utah"]["choice"] == "keep"
+    assert "Ohio" not in runs_mod.data_issues_label(started[0].extra)
+    # without the rule the choice is the state's, as before
+    ui_state._last_form["knobs"] = {}
+    page = client.get("/forecast").text
+    ohio = page.split('name="gap.39"', 1)[1].split("</select>", 1)[0]
+    assert '<option value="level"' in ohio
+    r = _post({"gap.39": "level", "gap.49": "keep"})
+    assert len(started) == 2
+    assert started[1].extra["data_choices"]["states"]["Ohio"]["choice"] == "level"
+
+
