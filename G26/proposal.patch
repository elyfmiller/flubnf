+_PLAIN = (
+    (re.compile(r"prior_ranges: \S+ \[(.+?), (.+?)\] is not a valid "
+                r"loguniform_var range"),
+     r"the low end must be above 0 and below the high end (\1, \2)"),
+    (re.compile(r"prior_ranges: \S+ \[(.+?), (.+?)\] is not a valid "
