+def _legacy_int(raw, field: str) -> int:
+    """An older number field of the run form (replicates, particles, weeks
+    to drop) as a whole number, read as its knob reads one (knobs._coerce:
+    "10,000" and "10_000" are numbers, "1e4" is not and is refused, a
+    KnobError in the panel's words). Blank is the shipped value. The range
+    is the run's check (knobs.resolve), which knows which engine uses the
+    field; a typed value the run does not use is kept on the form."""
+    from app.core import knobs as _knobs
+    key = _knobs.LEGACY_FIELDS[field]
+    text = _str_field(raw).strip()
+    if not text:
+        return int(_knobs.BY_KEY[key].default)
+    try:
+        return int(text.replace(",", "").replace("_", ""))
+    except ValueError:
+        raise _knobs.KnobError(f"{key}: {text!r} is not a valid int") from None
+
+
