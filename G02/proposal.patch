+"""What POST /run takes from a form (the Forecast tab and the model pages'
+quick runs), and the same number fields on the other forms that carry the
+Model settings panel (a dataset's run, a replay).
+
+A number the browser allows (1e4 for 10,000) is refused in words with the
+panel open on it, never a raw JSON 422 page; a typed location name takes
+the hub's spelling in any case and an unknown one is refused by name; the
+model pages' replicates field allows what the knob allows; a quick run on
+a weekday says which week it took (the Forecast form shows it already).
+"""
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.core import data as core_data                # noqa: E402
+from app.core import knobs as K                       # noqa: E402
+from app.core import retro                            # noqa: E402
+from app.ui import pipeline as ui_pipeline            # noqa: E402
+from app.ui import retro_seasons as ui_retro_seasons  # noqa: E402
+from app.ui import state as ui_state                  # noqa: E402
+from app.ui.routes import retro as ui_retro           # noqa: E402
+
+from test_datasets_ui import _capture, client, isolated, stored  # noqa: E402,F401
+
+SATURDAY = "2098-01-04"
+WEDNESDAY = "2098-01-08"
+
+
+def _started(monkeypatch, tmp_path):
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(core_data, "vintage_path", lambda d: tmp_path)
+    started = []
+    monkeypatch.setattr(ui_pipeline, "_run_all", lambda spec: started.append(spec))
+    return started
+
+
+def _post(referer="/forecast", **data):
+    ui_state._status["running"] = None
+    ui_state._status.pop("flash", None)
+    form = {"forecast_date": SATURDAY, "locations": ["Ohio"],
+            "engine": "all", **data}
+    return client.post("/run", data=form, follow_redirects=False,
+                       headers={"referer": f"http://testserver{referer}"})
+
+
+# ---------------------------------------------- numbers the browser allows
+
+@pytest.mark.parametrize("field,typed,key", [
+    ("particles", "1e4", "pf.particles"),
+    ("replicates", "2.5", "pf.replicates"),
+    ("weeks_to_drop", "1e1", "run.weeks_to_drop")])
+def test_a_number_the_browser_allows_is_refused_in_words_on_the_panel(
+        tmp_path, monkeypatch, field, typed, key):
+    started = _started(monkeypatch, tmp_path)
+    r = _post(**{field: typed})
+    assert r.status_code == 303 and r.headers["location"] == "/forecast"
+    assert started == []
+    assert (f"Not run: model settings: {key}: '{typed}' is not a valid int."
+            in ui_state._status["flash"])
+    # the panel opens on it, the typed value kept, named as the panel does
+    page = client.get("/forecast").text
+    assert '<details class="adv" open data-refused id="model-settings"' in page
+    why = page.split('id="ms-refused">')[1].split("</div>")[0]
+    assert f"{K.BY_KEY[key].label}: &#39;{typed}&#39; is not a valid int." in why
+    assert f'name="{field}" id="ks-{key.replace(".", "-")}" value="{typed}"' in page
+
+
+def test_the_dataset_run_refuses_it_in_words_too(monkeypatch):
+    ds = stored()
+    got = _capture(monkeypatch)
+    r = client.post("/run/dataset", data={
+        "dataset": ds.id, "forecast_date": "2023-12-02", "locations": "all",
+        "engine": "analogue", "weeks_to_drop": "1e1"}, follow_redirects=False)
+    assert r.status_code == 303 and got == []
+    assert ("Not run: model settings: run.weeks_to_drop: '1e1' is not a "
+            "valid int." in ui_state._status["flash"])
+
+
+def test_a_replay_refuses_it_in_words_too(tmp_path, monkeypatch):
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(retro, "available_seasons", lambda: ["2024-25"])
+    monkeypatch.setattr(retro, "season_vintages",
+                        lambda s: ["2024-11-02", "2024-11-09"])
+    launched = []
+    monkeypatch.setattr(ui_retro, "_retro_bg",
+                        lambda *a, **k: launched.append((a, k)))
+    r = client.post("/retro/run", data={
+        "season": "2024-25", "locations": "panel6", "engine": "pf",
+        "replicates": "3.5"}, follow_redirects=False)
+    assert r.status_code == 303 and launched == []
+    assert ("Not started: model settings: pf.replicates: '3.5' is not a "
+            "valid int." in ui_state._status["flash"])
+
+
+# ------------------------------------------------------ typed location names
+
+def test_a_typed_name_takes_the_hubs_spelling_once(tmp_path, monkeypatch):
+    started = _started(monkeypatch, tmp_path)
+    _post("/model/analogue", engine="analogue",
+          locations=["arizona, Ohio, OHIO"])
+    (spec,) = started
+    assert spec.locations == ["Arizona", "Ohio"]
+
+
+@pytest.mark.parametrize("typed,named", [
+    ("Arizonna, Ohio", "unknown location: Arizonna."),
+    ("OH, AZ", "unknown locations: OH, AZ."),
+    ("Ohio, US+(national)", "unknown location: US+(national).")])
+def test_an_unknown_name_is_refused_by_name(tmp_path, monkeypatch, typed,
+                                            named):
+    """Once run as "2 states" with the file covering one, and an all-unknown
+    pick as an empty 'ok' run."""
+    started = _started(monkeypatch, tmp_path)
+    r = _post("/model/analogue", engine="analogue", locations=[typed])
+    assert r.status_code == 303 and r.headers["location"] == "/model/analogue"
+    assert started == []
+    assert ui_state._status["flash"] == f"Not run: {named}"
+
+
+def test_the_forecast_forms_names_and_us_still_run(tmp_path, monkeypatch):
+    started = _started(monkeypatch, tmp_path)
+    _post(locations=["Ohio", "District of Columbia", "US (national)"])
+    _post(locations=["all"])
+    first, every = started
+    assert first.locations == ["Ohio", "District of Columbia", "US"]
+    assert len(every.locations) == 53 and every.locations[-1] == "US"
+
+
+# ----------------------------------------------------------- the model pages
+
+@pytest.mark.parametrize("page,field", [("/models", "mf-reps"),
+                                        ("/model/pf2s", "rr-reps")])
+def test_the_model_pages_take_the_replicates_the_knob_allows(page, field):
+    knob = K.BY_KEY["pf.replicates"]
+    html = client.get(page).text
+    tag = html.split(f'id="{field}"')[1].split(">")[0]
+    assert f'min="{knob.lo}" max="{knob.hi}"' in tag and knob.hi == 10
+
+
+def test_a_quick_run_on_a_weekday_says_which_week_it_took(tmp_path,
+                                                          monkeypatch):
+    started = _started(monkeypatch, tmp_path)
+    _post("/model/analogue", engine="analogue", forecast_date=WEDNESDAY)
+    assert started[-1].forecast_date == SATURDAY
+    assert (f"Anchor week {SATURDAY}: the newest week on or before "
+            f"{WEDNESDAY}." in ui_state._status["flash"])
+    # the Forecast form shows the anchor beside the date: no notice
+    _post("/forecast", engine="analogue", forecast_date=WEDNESDAY)
+    assert started[-1].forecast_date == SATURDAY
+    assert "Anchor week" not in (ui_state._status.get("flash") or "")
