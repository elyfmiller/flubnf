diff --git a/app/tests/test_sandbox_mechanics.py b/app/tests/test_sandbox_mechanics.py
new file mode 100644
index 0000000..7aedf39
--- /dev/null
+++ b/app/tests/test_sandbox_mechanics.py
@@ -0,0 +1,147 @@
+"""Sandbox mechanics of the bug hunt 2026-10-25, G14: the loaded range is
+the one reported (SB-03), same-name datasets are told apart (SB-06), every
+run is listed and counted (SB-08), a suggested name is free (SB-09), a
+copy's start suggests a name (SB-17), an Oracle SIHRS start keeps to one
+season (SB-11), the console's refusal beside a sandbox fit says what it
+waits for (SB-12), and an upload over the cap is refused on the page before
+the editor's unsaved text is lost (SB-02). Hub-free and engine-free."""
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+import pytest                                            # noqa: E402
+from fastapi.testclient import TestClient                # noqa: E402
+
+from app.core import sandbox as sb                       # noqa: E402
+from app.core import sandbox_data as sd                  # noqa: E402
+from app.ui import server as srv                         # noqa: E402
+from app.ui import state as ui_state                     # noqa: E402
+from app.ui.routes import sandbox as ui_sandbox          # noqa: E402
+
+client = TestClient(srv.app)
+STATIC = Path(__file__).resolve().parents[1] / "ui" / "static"
+
+
+@pytest.fixture
+def box(sandbox_root):
+    return sandbox_root
+
+
+def _sat(first, n):
+    import datetime as dt
+    d = dt.date.fromisoformat(first)
+    return [(d + dt.timedelta(days=7 * i)).isoformat() for i in range(n)]
+
+
+def test_a_week_the_source_cannot_hold_yet_is_not_called_missing():
+    # a vintage of 2026-10-10 asked up to 10-17: nothing is missing
+    got = {d: 1.0 for d in _sat("2026-06-06", 19)}      # 06-06 .. 10-10
+    w = sd._window(got, "2026-06-06", "2026-10-17")
+    assert (len(w["dates"]), w["dropped"]) == (19, 0)
+    # a gap inside the loaded range still counts
+    del got["2026-08-01"]
+    assert sd._window(got, "2026-06-06", "2026-10-17")["dropped"] == 1
+
+
+def test_the_loaded_range_is_reported_not_the_requested_one(box, monkeypatch):
+    sb.new_model("m1")
+    dates = _sat("2026-09-05", 7)                           # .. 2026-10-17
+    monkeypatch.setattr(sd, "series_for", lambda *a, **k: {
+        "dates": dates, "values": [float(i) for i in range(7)], "dropped": 0})
+    monkeypatch.setattr(sd._sb, "locations", lambda: [{"name": "Arizona"}])
+    info = sd.fill_data("m1", "Arizona", "2026-09-05", "2026-12-31")
+    assert (info["start"], info["end"], info["rows"], info["dropped"]) == (
+        "2026-09-05", "2026-10-17", 7, 0)
+    assert json.loads((sb.MODELS / "m1" / "data.source.json").read_text(
+        encoding="utf-8"))["end"] == "2026-10-17"
+
+
+def test_two_datasets_with_one_name_are_told_apart_in_the_source_list(
+        box, monkeypatch):
+    sb.new_model("m1")
+    two = [{"id": "cases-aaaa", "name": "cases", "kind": "count", "pf": False,
+            "groups": [{"name": "cases", "first": "2025-01-04",
+                        "last": "2025-02-22", "population": None}]},
+           {"id": "cases-bbbb", "name": "cases", "kind": "count", "pf": False,
+            "groups": [{"name": "cases", "first": "2025-03-01",
+                        "last": "2025-04-19", "population": None}]},
+           {"id": "wire-cccc", "name": "wire", "kind": "count", "pf": False,
+            "groups": [{"name": "A", "first": "2025-01-04",
+                        "last": "2025-02-22", "population": None}]}]
+    monkeypatch.setattr(sb, "dataset_choices", lambda: two)
+    html = client.get("/sandbox?model=m1").text
+    assert ">cases (2025-01-04 to 2025-02-22)</option>" in html
+    assert ">cases (2025-03-01 to 2025-04-19)</option>" in html
+    assert ">wire</option>" in html
+
+
+def test_every_run_is_listed_and_the_delete_prompt_counts_them_all(box):
+    sb.new_model("m1")
+    sb.RUNS.mkdir(parents=True, exist_ok=True)
+    for i in range(27):
+        d = sb.RUNS / f"20261020-10{i:02d}00_m1"
+        d.mkdir()
+        (d / "meta.json").write_text(json.dumps({
+            "model": "m1", "status": "ok", "particles": 500,
+            "started_utc": f"2026-10-20T10:{i:02d}:00Z", "elapsed_s": 3}),
+            encoding="utf-8")
+    html = client.get("/sandbox?model=m1").text
+    assert 'data-sb-delete="m1 and its 27 runs"' in html
+    assert html.count("20261020-10") >= 27
+
+
+def test_a_suggested_name_is_free_and_a_copy_start_suggests_one(box):
+    sb.new_model("sir_example_1")
+    html = client.get("/sandbox").text
+    # a copy's own suggestion, as the examples get theirs
+    assert ('<option value="copy:sir_example_1" data-note="A copy of '
+            'sir_example_1, with its data and priors." '
+            'data-name="sir_example_1_1">') in html
+    js = (STATIC / "sandbox.js").read_text(encoding="utf-8")
+    assert "if (o.value.indexOf('copy:') === 0) taken[o.value.slice(5)] = true;" in js
+    assert "s = free(suggestName(loc.value, date.value));" in js
+
+
+def test_an_oracle_start_more_than_a_year_back_is_refused(box):
+    r = client.post("/sandbox/new", data={
+        "name": "o3", "start": "shipped:sihrs", "location": "Arizona",
+        "forecast_date": "2026-10-17", "season_start": "2025-08-01"},
+        follow_redirects=False)
+    assert r.status_code == 303
+    flash = ui_state._status["flash"]
+    assert ("the season start 2025-08-01 is more than a year before the "
+            "forecast date 2026-10-17; the Oracle SIHRS fits one season "
+            "(production starts 2026-08-01)") in flash
+    assert not (sb.MODELS / "o3").exists()
+
+
+def test_the_refusal_beside_a_sandbox_fit_says_what_the_console_waits_for(
+        box, monkeypatch):
+    monkeypatch.setitem(ui_state._sandbox_status, "running", "20990101-000000_mine")
+    r = client.post("/run", data={"forecast_date": "2099-01-02",
+                                  "engine": "analogue", "locations": "Arizona"},
+                    follow_redirects=False)
+    assert r.status_code == 303 and r.headers["location"] == "/forecast"
+    flash = ui_state._status["flash"]
+    assert ("Not started: a sandbox fit is running (20990101-000000_mine); "
+            "the console runs one thing at a time.") in flash
+    assert "holds the engine" not in flash
+    monkeypatch.setitem(ui_state._sandbox_status, "running", None)
+    monkeypatch.setitem(ui_state._status, "running", "x")
+    assert ui_sandbox._sandbox_busy_reason() == "a console run is in progress"
+
+
+def test_an_upload_over_the_cap_is_refused_on_the_page_with_the_edits_kept(box):
+    sb.new_model("m1")
+    html = client.get("/sandbox?model=m1").text
+    assert f'id="sbfill-csv" name="csv" type="file"' in html
+    assert f'data-cap="{sb.UPLOAD_MAX_BYTES}"' in html
+    js = (STATIC / "sandbox.js").read_text(encoding="utf-8")
+    assert "if (cap > 0 && up.files[0].size > cap) {" in js
+    assert "your edits stay in the editor." in js
+    # the server's own refusal says the editor's text never arrived
+    src = Path(ui_sandbox.__file__).read_text(encoding="utf-8")
+    assert ('"nothing was read past it or stored, and unsaved edits in the "\n'
+            '            "editor were not saved."') in src
