+@pytest.mark.parametrize("typed,launches", [
+    ("2e0", 0), ("1.5", 0), ("two", 0), ("2", 1), ("", 1)])
+def test_a_replay_refuses_a_runner_count_the_browser_allows_in_words(
+        tmp_path, monkeypatch, typed, launches):
+    """The runners box is a number field too: 2e0 passes the browser and an
+    int field answered it with a raw 422 page. Now the same refusal as the
+    other numbers; a blank is this machine's default."""
+    from app.core import retro as core_retro
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(core_retro, "available_seasons", lambda: ["2024-25"])
+    monkeypatch.setattr(core_retro, "season_vintages",
+                        lambda s: ["2024-11-02", "2024-11-09"])
+    launched = []
+    monkeypatch.setattr(ui_retro, "_retro_bg",
+                        lambda *a, **k: launched.append((a, k)))
+    ui_state._status["running"] = None
+    r = client.post("/retro/run", data={
+        "season": "2024-25", "locations": "panel6", "engine": "analogue",
+        "knob.groundhog.zero_anchor": "level", "width": typed},
+        follow_redirects=False)
+    assert r.status_code == 303 and len(launched) == launches, (
+        ui_state._status["flash"])
+    if not launches:
+        assert (f"Not started: runners: '{typed}' is not a valid int."
+                in ui_state._status["flash"])
+
+
