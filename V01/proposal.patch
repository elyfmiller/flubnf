+@pytest.mark.parametrize("typed,width", [("3", 3), ("", 4)])
+def test_a_replay_refuses_a_shard_width_the_browser_allows_in_words(
+        tmp_path, monkeypatch, pf_engine_ready, typed, width):
+    """The Run form's shard width is a number box too: 2e0 (or a cleared
+    box) gave a raw JSON 422 page. Now a refusal in words; a whole number
+    runs as before, a blank as the default."""
+    from app.core import retro as core_retro
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "noseal")
+    monkeypatch.setattr(core_retro, "available_seasons", lambda: ["2024-25"])
+    monkeypatch.setattr(core_retro, "season_vintages",
+                        lambda s: ["2024-11-02", "2024-11-09"])
+    launched = []
+    monkeypatch.setattr(ui_retro, "_retro_bg",
+                        lambda *a, **k: launched.append((a, k)))
+    ui_state._status["running"] = None
+    form = {"season": "2024-25", "locations": "panel6", "engine": "pf",
+            "knob.groundhog.zero_anchor": "abstain"}
+    r = client.post("/retro/run", data={**form, "width": "2e0"},
+                    follow_redirects=False)
+    assert r.status_code == 303 and launched == []
+    assert ("Not started: shard width: '2e0' is not a whole number."
+            in ui_state._status["flash"])
+    r = client.post("/retro/run", data={**form, "width": typed},
+                    follow_redirects=False)
+    assert r.status_code == 303 and len(launched) == 1
+    assert launched[0][0][2] == width
+
+
 def test_a_number_typed_with_commas_is_read_and_a_blank_is_the_default(
