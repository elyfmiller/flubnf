+def not_text(head: bytes) -> str:
+    """Why a file's first bytes are no text FluBNF reads, or '': a zip (an
+    .xlsx workbook starts PK), or NUL bytes in no UTF-16 or UTF-32 pattern
+    (binary). Said before any reading, so a workbook is named as one
+    rather than by the NUL characters in its "header"."""
+    if head.startswith(b"PK\x03\x04"):
+        return ("This looks like an Excel workbook (.xlsx), not a CSV: in "
+                "Excel, save the sheet as CSV UTF-8.")
+    # control bytes throughout (not tab, newline or return): binary, unless
+    # they are UTF-16's or UTF-32's padding; a stray NUL in a text cell is
+    # shown as a cell, not refused
+    control = sum(head.count(bytes([b])) for b in range(32)
+                  if b not in (9, 10, 13))
+    if control >= max(8, len(head) // 64) and detect_encoding(head) == "utf-8":
+        return "The file is not text: it holds binary data. Save it as CSV UTF-8."
+    return ""
+
+
