diff --git a/app/tests/test_state_dir_protect.py b/app/tests/test_state_dir_protect.py
new file mode 100644
index 00000000..139d8b2d
--- /dev/null
+++ b/app/tests/test_state_dir_protect.py
@@ -0,0 +1,176 @@
+"""The state folder and what Storage may delete or serve (G21): the retro
+roots and the engine-update file follow FLUBNF_STATE_DIR; Delete and
+Reclaim protect the same trees; a run that recorded fit failures keeps its
+trees; the download route serves the files the pages list, nothing else."""
+import json
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from fastapi.testclient import TestClient
+
+import app.core.runs as runs_mod                     # noqa: E402
+from app.core import reclaim                         # noqa: E402
+from app.core.runs import Ledger, RunSpec            # noqa: E402
+from app.core.submit import hub_model_id             # noqa: E402
+from app.ui import retro_seasons as ui_retro_seasons  # noqa: E402
+from app.ui import server as srv                     # noqa: E402
+from app.ui import shared as ui_shared               # noqa: E402
+from app.ui import state as ui_state                 # noqa: E402
+from app.ui.routes import storage as ui_storage      # noqa: E402
+
+client = TestClient(srv.app)
+REPO = Path(__file__).resolve().parents[2]
+
+
+@pytest.fixture()
+def state(tmp_path, monkeypatch):
+    """A tmp state folder with one closed run and its workroot, the retro
+    roots and the hub pointed into it (as test_storage's)."""
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    from app.core import datasets as datasets_mod
+    monkeypatch.setattr(datasets_mod, "ROOT", tmp_path / "datasets")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_ROOT", tmp_path / "retro")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "retro_seal")
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_RESEAL", tmp_path / "retro_reseal")
+    import flubnf.settings as settings_mod
+    monkeypatch.setattr(settings_mod, "HUB", tmp_path / "hub")
+    status = dict(ui_state._status)
+    ui_state._status["running"] = None
+    ui_state._status.pop("flash", None)
+    led = Ledger()
+    rid = led.open_run(RunSpec(engine="all", forecast_date="2098-01-03"),
+                       Path("pending"), {})
+    led.close_run(rid, "ok", {})
+    (tmp_path / "workroots" / rid).mkdir(parents=True)
+    (tmp_path / "workroots" / rid / "results.json").write_text("{}")
+    ui_shared._invalidate_scans()
+    yield {"root": tmp_path, "rids": {"ok": rid}}
+    ui_state._status.clear(); ui_state._status.update(status)
+    ui_shared._invalidate_scans()
+
+
+def _flash():
+    return ui_state._status.get("flash", "")
+
+
+# ------------------------------------------------------------- WI-04, RE-28
+
+def test_the_retro_roots_and_the_engine_update_file_follow_the_state_folder(tmp_path):
+    # a replay, its season report and the engine's update note wrote into the
+    # checkout's app/state when FLUBNF_STATE_DIR pointed elsewhere
+    env = {**os.environ, "FLUBNF_STATE_DIR": str(tmp_path)}
+    out = subprocess.run([sys.executable, "-c",
+                          "from app.ui import retro_seasons as r;"
+                          "from app.core import engine_update as e;"
+                          "print(r.RETRO_ROOT); print(r.RETRO_RESEAL);"
+                          "print(r.RETRO_SEAL); print(e.STATE_FILE)"],
+                         cwd=REPO, env=env, capture_output=True, text=True,
+                         timeout=120)
+    assert out.returncode == 0, out.stderr[-2000:]
+    roots = [Path(x) for x in out.stdout.split()]
+    assert roots == [tmp_path / "retro", tmp_path / "retro_reseal",
+                     tmp_path / "retro_seal", tmp_path / "engine_update.json"]
+
+
+def test_a_sealed_record_shipped_in_the_checkout_is_found_from_a_moved_state_folder(tmp_path):
+    state_dir, checkout = tmp_path / "state", tmp_path / "checkout"
+    (checkout / "retro_seal").mkdir(parents=True)
+    # the state folder holds none: the checkout's copy
+    assert runs_mod.sealed_root("retro_seal", state_dir, checkout) \
+        == checkout / "retro_seal"
+    # neither holds one: the state folder's place, where one would go
+    assert runs_mod.sealed_root("retro_reseal", state_dir, checkout) \
+        == state_dir / "retro_reseal"
+    # the state folder's own copy wins
+    (state_dir / "retro_seal").mkdir(parents=True)
+    assert runs_mod.sealed_root("retro_seal", state_dir, checkout) \
+        == state_dir / "retro_seal"
+
+
+# -------------------------------------------------------------------- ST-06
+
+def test_storage_delete_refuses_a_protected_root_and_lists_it(state, monkeypatch):
+    rid = state["rids"]["ok"]
+    folder = state["root"] / "workroots" / rid
+    monkeypatch.setenv("FLUBNF_PROTECT_ROOTS", str(folder))
+    ui_shared._invalidate_scans()
+    # one barrier: reclaim's and Storage's agree
+    assert reclaim.is_protected(folder) and ui_storage._storage_protected(folder)
+    # listed under Protected, left out of Delete all, its own Delete off
+    html = client.get("/storage").text
+    protected = html.split('id="st-protected"', 1)[1].split("</section>", 1)[0]
+    assert f"Protected folder ({rid})" in protected
+    assert rid not in [w["id"] for w in ui_storage._clearable_workroots()]
+    row = html.split(f'data-wid="{rid}"', 1)[1].split("</div>", 1)[0]
+    assert "data-del-storage" not in row and "protected" in row
+    # a crafted request is refused and the tree stays
+    r = client.post("/storage/delete",
+                    data={"kind": "workroot", "ident": rid, "confirm": rid},
+                    follow_redirects=False)
+    assert r.status_code == 303 and folder.is_dir()
+    assert "protected" in _flash()
+
+
+def test_reclaim_protects_the_production_reseal_as_storage_does(tmp_path, monkeypatch):
+    monkeypatch.setattr(runs_mod, "APP_STATE", tmp_path)
+    reseal = tmp_path / "retro_reseal"
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_RESEAL", reseal)
+    monkeypatch.setattr(ui_retro_seasons, "RETRO_SEAL", tmp_path / "retro_seal")
+    (reseal / "2023-24" / "weeks").mkdir(parents=True)
+    (reseal / "2023-24" / "weeks" / "a_r0.json").write_text("{}")
+    season = reseal / "2023-24"
+    assert reclaim.is_protected(season) and ui_storage._storage_protected(season)
+    assert reclaim._delete(season / "weeks") == 0 and season.is_dir()
+
+
+# -------------------------------------------------------------------- ST-07
+
+def test_reclaim_keeps_the_fit_trees_of_a_run_that_recorded_failures(tmp_path):
+    w = tmp_path / "workroots" / "20261001T100000-aaaaaa"
+    (w / "Arizona_r0").mkdir(parents=True)
+    (w / "Arizona_r0" / "pf.log").write_text("x" * 100)
+    (w / "results.json").write_text("{}")
+    (w / "pf_status.json").write_text(json.dumps(
+        {"Arizona_r0": "fit failed: no particles", "Alaska_r0": "ok"}))
+    # the pipeline left them as evidence; reclaim leaves them too
+    assert reclaim.workroot_failed(w)
+    assert reclaim.workroot_intermediates(w) == []
+    plan = reclaim.survey(tmp_path / "retro", tmp_path / "workroots")
+    assert plan["workroot_ids"] == [] and plan["workroot_bytes"] == 0
+    # a clean run's trees are the intermediates they always were
+    (w / "pf_status.json").write_text(json.dumps({"Arizona_r0": "ok"}))
+    assert not reclaim.workroot_failed(w)
+    assert [p.name for p in reclaim.workroot_intermediates(w)] == ["Arizona_r0"]
+    assert reclaim.survey(tmp_path / "retro", tmp_path / "workroots")[
+        "workroot_ids"] == [w.name]
+
+
+# -------------------------------------------------------------------- OU-15
+
+def test_the_download_route_serves_only_submission_and_export_csvs(state):
+    root, rid = state["root"], state["rids"]["ok"]
+    w = root / "workroots" / rid
+    (root / "last_form.json").write_text("{}")
+    good = w / "submission" / hub_model_id("pf")
+    good.mkdir(parents=True)
+    (good / "2098-01-10-x.csv").write_text("a,b\n1,2\n")
+    export = w / "export" / "FluBNF-Groundhog"
+    export.mkdir(parents=True)
+    (export / "2098-01-10-FluBNF-Groundhog.csv").write_text("a,b\n1,2\n")
+    (root / "notes.csv").write_text("a\n")
+
+    def get(p):
+        return client.get("/output/download", params={"path": str(p)})
+    # the files the pages list
+    for p in (good / "2098-01-10-x.csv", export / "2098-01-10-FluBNF-Groundhog.csv"):
+        r = get(p)
+        assert r.status_code == 200 and "attachment" in r.headers["content-disposition"], p
+    # the ledger, the form memory, a run's results and a stray CSV: not served
+    for p in (root / "ledger.sqlite", root / "last_form.json",
+              w / "results.json", root / "notes.csv"):
+        assert p.is_file(), p
+        r = get(p)
+        assert r.status_code == 404 and "File not found in app state" in r.text, p
