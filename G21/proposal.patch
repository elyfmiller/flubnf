+def sealed_root(name: str, state: Optional[Path] = None,
+                checkout: Optional[Path] = None) -> Path:
+    """Where the read-only sealed record `name` lives: under the state
+    folder, or the checkout's copy when the state folder was moved and
+    holds none (retro_seasons and reclaim read it)."""
+    p = Path(state or APP_STATE) / name
