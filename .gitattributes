# Same bytes on every platform: the pipeline is byte-oriented (templates,
# conf/exp parsing, assets inlined into reports), and Windows' CRLF conversion
# broke a byte-identity test. LF everywhere except the Windows launchers.
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# The engine's input formats (BNG2.pl, PyBNF), pinned by name so text=auto's
# binary guess can never drop one out of the policy (flubnf/templates,
# flubnf/sandbox_examples).
*.bngl text eol=lf
*.exp  text eol=lf
*.conf text eol=lf

# Vendored Plotly (4.9 MB, needed offline): kept, but out of diffs and
# language stats. site/ is untracked until the lab publishes the site.
site/plotly.min.js -diff linguist-vendored
app/ui/static/plotly.min.js -diff linguist-vendored

# MicroHub template slices: byte-exact (UTF-8 BOM, CRLF) as MicroHub ships them
app/tests/fixtures/microhub-*.csv -text
