diff --git a/app/tests/test_cross_page_polish.py b/app/tests/test_cross_page_polish.py
new file mode 100644
index 00000000..0ba4cf3d
--- /dev/null
+++ b/app/tests/test_cross_page_polish.py
@@ -0,0 +1,87 @@
+"""Across pages (base.html, the location count, the mark rule).
+
+  * browser storage that throws (site data blocked) never breaks the first
+    paint or the Display menu's switches: every localStorage use in
+    base.html is guarded, so the page follows the OS and a switch works
+    for the visit;
+  * the count is "53 locations" wherever US is counted in (Forecast's box
+    and progress, Data's stat, Methods' Purpose tile) and "52
+    jurisdictions" where US stands apart;
+  * Home keeps one "i" (the map's) and Retrospective none of its own.
+"""
+import re
+import sys
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.ui import state as ui_state                   # noqa: E402
+from app.ui.server import app as srv                   # noqa: E402
+from app.tests.test_fewer_marks import marks           # noqa: E402
+
+client = TestClient(srv)
+TEMPLATES = Path(__file__).resolve().parents[1] / "ui" / "templates"
+
+
+def test_blocked_browser_storage_still_follows_the_os_and_the_switches():
+    base = (TEMPLATES / "base.html").read_text(encoding="utf-8")
+    # the first-paint script reads and writes through guarded helpers
+    first = base.split("before first paint", 1)[1].split("</script>", 1)[0]
+    assert "function get(k){try{return localStorage.getItem(k);}catch(e){return null;}}" in first
+    assert "function put(k,v){try{localStorage.setItem(k,v);}catch(e){}}" in first
+    for direct in ("localStorage.getItem('theme')", "localStorage.getItem('contrast')",
+                   "localStorage.getItem('vision')", "localStorage.getItem('fontsize')",
+                   "localStorage.setItem('fontsize'"):
+        assert direct not in first, direct
+    assert "t=get('theme')" in first and "f=get('fontsize')" in first
+    # every other use is inside a try (the switches' writes included)
+    for line in base.splitlines():
+        if "localStorage." in line and "function get(" not in line \
+                and "function put(" not in line:
+            assert "try{" in line, line
+    assert "try{localStorage.setItem('contrast',on?'normal':'high');}catch(e){}" in base
+    assert "try{localStorage.setItem('vision',v?'normal':'cvd');}catch(e){}" in base
+    assert "try{localStorage.setItem('fontsize',String(p));}catch(e){}" in base
+
+
+def test_the_count_is_53_locations_where_us_is_counted_in():
+    from app.ui.routes import forecast as fc
+    ui_state._last_form.clear()
+    page = client.get("/forecast").text
+    assert "<b>all 53 locations</b>" in page
+    assert "53 jurisdictions" not in page
+    assert fc._scope_label([f"S{i}" for i in range(52)] + ["US"]) == "all 53 locations"
+    methods = client.get("/methods").text
+    tile = methods.split('id="mt-locs">', 1)[1].split("</dd>", 1)[0]
+    assert re.sub(r"<[^>]+>", " ", tile).split() == \
+        "53 locations: 52 jurisdictions plus the national total".split()
+    # the public site reads the tile as it is
+    from app.core import site_build
+    assert "_LOCS_TILE" not in dir(site_build)
+    home = client.get("/").text
+    assert "52 US jurisdictions and the national total" in home
+    # where US stands apart, the 52 stays
+    assert "all 52 jurisdictions" in client.get("/retro").text
+
+
+def test_home_and_retrospective_keep_the_mark_rule(monkeypatch):
+    home = client.get("/").text
+    assert [m for m in marks(home) if m.startswith("tt-")] == ["tt-hm-map"]
+    assert "tip-hm-miss" not in home and "tip-hm-missing" not in home
+    assert '<p class="hint hm-how-lead">' in home
+    assert '<p class="hint hm-perf-how">' in home
+    assert 'id="tt-hm-how"' not in home and 'id="tt-hm-perf"' not in home
+    retro = client.get("/retro").text
+    own = [m for m in marks(retro)
+           if not m.startswith(("tip-rt-run-why", "tip-rt-st-"))]
+    assert own == []
+    assert '<p class="hint rt-lead">' in retro
+    assert "relWIS: the summed WIS over the FluSight baseline's" in retro
+    assert '<p class="hint rt-import-how">' in retro
+    assert "tip-rt-import-h" not in retro and "tip-rt-page" not in retro
+    # the engine alert says its fix in its text, with no "?"
+    if 'id="rt-engine-off"' in retro:
+        alert = retro.split('id="rt-engine-off"', 1)[1].split("</div>", 1)[0]
+        assert "To install it," in alert and "tipbtn" not in alert
