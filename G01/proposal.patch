diff --git a/app/tests/test_suite_hub.py b/app/tests/test_suite_hub.py
new file mode 100644
index 0000000..f226a2b
--- /dev/null
+++ b/app/tests/test_suite_hub.py
@@ -0,0 +1,32 @@
+"""The suite reads no FluSight hub clone (app/tests/conftest.py).
+
+A clone at the default path, or one named by the shell's FLUBNF_HUB, made
+five tests fail on Ely's machine while CI (FLUBNF_HUB=/nonexistent) passed:
+the clone's live target file had a newer week than the tests' dates, so
+their real-time runs were recorded as vintage runs. The hub is pinned to an
+empty path beside the suite's state folder; a test that wants a real clone
+reads FLUBNF_TEST_HUB itself.
+"""
+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from app.core import data, scoring                       # noqa: E402
+from flubnf import settings                              # noqa: E402
+
+
+def test_the_suite_reads_no_hub_clone_at_the_default_path():
+    pinned = Path(os.environ["FLUBNF_HUB"])
+    assert settings.HUB == pinned and not pinned.exists()
+    assert pinned != Path.home() / "GitHub" / "FluSight-forecast-hub"
+    # the copies modules took at import are the pinned path too
+    assert data.HUB == pinned and scoring.HUB == pinned
+    assert data.ARCHIVE == settings.ARCHIVE == pinned / "auxiliary-data/target-data-archive"
+
+
+def test_without_a_hub_the_live_file_has_no_week():
+    """What leaked: the clone's live file is newer than the tests' weeks."""
+    assert data.live_newest_week() is None
+    assert data.newest_week() == (data.vintages()[-1] if data.vintages() else None)
